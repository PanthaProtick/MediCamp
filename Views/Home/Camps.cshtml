@model List<CampOverviewItem>
@{
    ViewData["Title"] = "Public Camp Directory - MediCamp";
    var userCampStatus = ViewBag.UserCampStatus as Dictionary<int, string>;
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge badge-role-host mb-2"><i class="fa-solid fa-tent"></i> Public Directory</span>
            <h2 class="fw-bold text-dark mb-1">Healthcare Camps in Bangladesh</h2>
            <p class="text-secondary small mb-0">Search and filter active and scheduled medical camps across districts.</p>
        </div>
        <div>
            @if (User.IsInRole(SystemRoles.Pharmacist))
            {
                <a asp-controller="Pharmacist" asp-action="Dashboard" class="btn btn-sapphire">
                    <i class="fa-solid fa-pills me-1"></i> Pharmacist Dashboard
                </a>
            }
            else if (User.IsInRole(SystemRoles.Doctor))
            {
                <a asp-controller="Doctor" asp-action="Queue" class="btn btn-sapphire">
                    <i class="fa-solid fa-stethoscope me-1"></i> Doctor Queue
                </a>
            }
            else if (User.IsInRole(SystemRoles.Volunteer))
            {
                <a asp-controller="Volunteer" asp-action="Dashboard" class="btn btn-sapphire">
                    <i class="fa-solid fa-clipboard-user me-1"></i> Volunteer Dashboard
                </a>
            }
            else if (User.IsInRole(SystemRoles.Host))
            {
                <a asp-controller="Host" asp-action="Dashboard" class="btn btn-sapphire">
                    <i class="fa-solid fa-hospital-user me-1"></i> Host Dashboard
                </a>
            }
            else if (User.IsInRole(SystemRoles.Patient))
            {
                <a asp-controller="Patient" asp-action="History" class="btn btn-sapphire">
                    <i class="fa-solid fa-notes-medical me-1"></i> Patient Portal
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="RegisterPatient" class="btn btn-sapphire">
                    <i class="fa-solid fa-user-plus me-1"></i> Register as Patient
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Bar -->
    <div class="glass-card p-3 mb-4">
        <form method="get" asp-controller="Home" asp-action="Camps" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-control-custom" placeholder="Search by camp title, venue, or NGO..." />
            </div>
            <div class="col-md-2">
                <select name="district" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="All" selected="@(ViewBag.SelectedDistrict == "All" || string.IsNullOrEmpty(ViewBag.SelectedDistrict))">All Districts</option>
                    @if(ViewBag.Districts != null)
                    {
                        foreach(var d in (List<string>)ViewBag.Districts)
                        {
                            <option value="@d" selected="@(ViewBag.SelectedDistrict == d)">@d</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="upazila" class="form-select form-select-custom" onchange="this.form.submit()">
                    <option value="All" selected="@(ViewBag.SelectedUpazila == "All" || string.IsNullOrEmpty(ViewBag.SelectedUpazila))">All Upazilas</option>
                    @if(ViewBag.Upazilas != null)
                    {
                        foreach(var u in (List<string>)ViewBag.Upazilas)
                        {
                            <option value="@u" selected="@(ViewBag.SelectedUpazila == u)">@u</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" value="@ViewBag.SelectedDate" class="form-control form-control-custom" onchange="this.form.submit()" placeholder="After Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sapphire w-100 btn-sm-custom py-2">
                    <i class="fa-solid fa-filter me-1"></i> Search
                </button>
                <a asp-controller="Home" asp-action="Camps" class="btn btn-light border btn-sm-custom py-2" title="Reset">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Camp Grid -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="glass-card p-5">
                    <i class="fa-solid fa-tent-arrow-down-to-line fs-1 text-muted mb-3 opacity-50"></i>
                    <h4 class="fw-bold">No Healthcare Camps Found</h4>
                    <p class="text-secondary small">Try changing your district or category search filters.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var camp in Model)
            {
                string? myStatus = userCampStatus != null && userCampStatus.ContainsKey(camp.Id) ? userCampStatus[camp.Id] : null;

                <div class="col-lg-6">
                    <div class="glass-card h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge @(camp.Status == "Ongoing" ? "badge-status-active" : "badge-role-host") px-3 py-1">
                                    <i class="fa-solid fa-circle-dot me-1"></i> @camp.Status
                                </span>
                                <span class="text-muted small fw-bold">
                                    <i class="fa-solid fa-calendar-days text-primary me-1"></i>
                                    @camp.StartDate.ToString("dd MMM yyyy") - @camp.EndDate.ToString("dd MMM yyyy")
                                </span>
                            </div>

                            <h4 class="fw-bold text-dark mb-2">@camp.Title</h4>
                            
                            <div class="mb-3">
                                <span class="badge bg-light text-primary border"><i class="fa-solid fa-stethoscope me-1"></i>@camp.CampType</span>
                            </div>

                            <div class="row g-2 small text-secondary mb-4">
                                <div class="col-sm-6">
                                    <div class="p-2 rounded-3 bg-white border">
                                        <span class="text-muted d-block" style="font-size: 0.72rem;">Location:</span>
                                        <strong><i class="fa-solid fa-location-dot text-danger me-1"></i>@camp.Upazila, @camp.District</strong>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2 rounded-3 bg-white border">
                                        <span class="text-muted d-block" style="font-size: 0.72rem;">Venue:</span>
                                        <strong><i class="fa-solid fa-school text-muted me-1"></i>@camp.Venue</strong>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2 rounded-3 bg-white border">
                                        <span class="text-muted d-block" style="font-size: 0.72rem;">Host Organization:</span>
                                        <strong><i class="fa-solid fa-building-ngo text-primary me-1"></i>@camp.HostOrganization</strong>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2 rounded-3 bg-white border">
                                        <span class="text-muted d-block" style="font-size: 0.72rem;">Capacity:</span>
                                        <strong><i class="fa-solid fa-users text-teal me-1"></i>@camp.ExpectedPatients Expected Patients</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span class="small text-muted">Free Consultation & Medicines</span>

                            @if (User.IsInRole(SystemRoles.Pharmacist))
                            {
                                @if (myStatus == "Approved")
                                {
                                    if (camp.Status == "Ongoing")
                                    {
                                        <a asp-controller="Pharmacist" asp-action="Dashboard" asp-route-activeCampId="@camp.Id" class="btn btn-sm-custom text-white" style="background:#6610f2;">
                                            <i class="fa-solid fa-pills me-1"></i> Enter Pharmacy
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i> Assigned Pharmacist</span>
                                    }
                                }
                                else if (myStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark py-2 px-3"><i class="fa-solid fa-clock me-1"></i> Request Pending</span>
                                }
                                else if (myStatus == "Denied")
                                {
                                    <span class="badge bg-danger py-2 px-3"><i class="fa-solid fa-circle-xmark me-1"></i> Request Declined</span>
                                }
                                else
                                {
                                    <form asp-controller="Pharmacist" asp-action="ApplyToCamp" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="campId" value="@camp.Id" />
                                        <button type="submit" class="btn btn-sm-custom text-white fw-bold shadow-sm" style="background:#6610f2;">
                                            <i class="fa-solid fa-pills me-1"></i> Request to Join as Pharmacist
                                        </button>
                                    </form>
                                }
                            }
                            else if (User.IsInRole(SystemRoles.Doctor))
                            {
                                @if (myStatus == "Approved")
                                {
                                    if (camp.Status == "Ongoing")
                                    {
                                        <a asp-controller="Doctor" asp-action="Queue" asp-route-activeCampId="@camp.Id" class="btn btn-primary btn-sm-custom">
                                            <i class="fa-solid fa-stethoscope me-1"></i> Consult Queue
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i> Assigned Doctor</span>
                                    }
                                }
                                else if (myStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark py-2 px-3"><i class="fa-solid fa-clock me-1"></i> Request Pending</span>
                                }
                                else if (myStatus == "Denied")
                                {
                                    <span class="badge bg-danger py-2 px-3"><i class="fa-solid fa-circle-xmark me-1"></i> Request Declined</span>
                                }
                                else
                                {
                                    <form asp-controller="Doctor" asp-action="ApplyToCamp" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="campId" value="@camp.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm-custom fw-bold shadow-sm">
                                            <i class="fa-solid fa-user-doctor me-1"></i> Request to Join as Doctor
                                        </button>
                                    </form>
                                }
                            }
                            else if (User.IsInRole(SystemRoles.Volunteer))
                            {
                                @if (myStatus == "Approved")
                                {
                                    if (camp.Status == "Ongoing")
                                    {
                                        <a asp-controller="Volunteer" asp-action="Dashboard" asp-route-activeCampId="@camp.Id" class="btn btn-info btn-sm-custom text-white">
                                            <i class="fa-solid fa-clipboard-user me-1"></i> Start Triage
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i> Assigned Volunteer</span>
                                    }
                                }
                                else if (myStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark py-2 px-3"><i class="fa-solid fa-clock me-1"></i> Request Pending</span>
                                }
                                else if (myStatus == "Denied")
                                {
                                    <span class="badge bg-danger py-2 px-3"><i class="fa-solid fa-circle-xmark me-1"></i> Request Declined</span>
                                }
                                else
                                {
                                    <form asp-controller="Volunteer" asp-action="ApplyToCamp" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="campId" value="@camp.Id" />
                                        <button type="submit" class="btn btn-info btn-sm-custom text-white fw-bold shadow-sm">
                                            <i class="fa-solid fa-handshake-angle me-1"></i> Request to Join as Volunteer
                                        </button>
                                    </form>
                                }
                            }
                            else if (User.IsInRole(SystemRoles.Host) || User.IsInRole(SystemRoles.Admin))
                            {
                                <a asp-controller="Host" asp-action="ManageStaff" asp-route-id="@camp.Id" class="btn btn-outline-primary btn-sm-custom">
                                    <i class="fa-solid fa-gear me-1"></i> Manage Camp
                                </a>
                            }
                            else if (User.IsInRole(SystemRoles.Patient))
                            {
                                if (myStatus == "Registered")
                                {
                                    <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i> Registered Patient</span>
                                }
                                else
                                {
                                    <a asp-controller="Patient" asp-action="RegisterForCamp" asp-route-campId="@camp.Id" class="btn btn-sapphire btn-sm-custom">
                                        <i class="fa-solid fa-id-card me-1"></i> Register for Camp
                                    </a>
                                }
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="RegisterPatient" class="btn btn-sapphire btn-sm-custom">
                                    <i class="fa-solid fa-id-card me-1"></i> Register as Patient
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
