@model MediCamp.Models.ViewModels.VolunteerDashboardViewModel

@{
    ViewData["Title"] = "Volunteer Dashboard";
}

<div class="container py-4">
    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Ongoing Camps Section -->
    <div class="glass-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge badge-role-volunteer"><i class="fa-solid fa-hand-holding-medical"></i> Field Operations</span>
                </div>
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tent text-warning me-2"></i>Ongoing Healthcare Camps</h4>
                <p class="text-muted small mb-0">Select an active camp to enter its triage intake desk and record patient vital signs.</p>
            </div>
            <span class="badge bg-success rounded-pill px-3 py-2 fw-bold">
                <i class="fa-solid fa-circle-dot me-1"></i> @Model.OngoingCamps.Count Active Camp@(Model.OngoingCamps.Count != 1 ? "s" : "")
            </span>
        </div>

        @if (!Model.OngoingCamps.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="fa-solid fa-tent-arrows-down fs-1 mb-2 opacity-50"></i>
                <p class="mb-0">No active healthcare camps available today.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var camp in Model.OngoingCamps)
                {
                    bool isCurrent = Model.ActiveCamp?.Id == camp.Id;
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 rounded-4 border-2 @(isCurrent ? "border-warning bg-warning-subtle shadow-sm" : "border-light-subtle shadow-none") transition-all">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <span class="badge bg-success rounded-pill px-2 py-1 small">
                                            <i class="fa-solid fa-circle-play me-1"></i> Active Now
                                        </span>
                                        <span class="badge bg-dark-subtle text-dark rounded-pill small">
                                            <i class="fa-solid fa-users me-1"></i> @camp.RegisteredPatientsCount Checked-in
                                        </span>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@camp.Title</h6>
                                    <div class="small text-muted mb-1">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i> @camp.Venue, @camp.Upazila, @camp.District
                                    </div>
                                    <div class="small text-muted mb-2">
                                        <i class="fa-solid fa-calendar-day text-primary me-1"></i> @camp.StartDate.ToString("MMM dd") – @camp.EndDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                                <div class="mt-2 pt-2 border-top">
                                    @if (isCurrent)
                                    {
                                        <button class="btn btn-warning btn-sm w-100 rounded-pill fw-bold text-dark" disabled>
                                            <i class="fa-solid fa-clipboard-check me-1"></i> Current Operating Camp
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="Dashboard" asp-route-activeCampId="@camp.Id"
                                           class="btn btn-outline-dark btn-sm w-100 rounded-pill fw-bold">
                                            <i class="fa-solid fa-right-to-bracket me-1"></i> Enter Triage Desk
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Operations Panel (Only visible if camp is selected) -->
    @if (Model.ActiveCamp != null)
    {
        <!-- Patient Unique ID Direct Lookup Form -->
        <div class="glass-card p-4 mb-4 border border-warning border-opacity-50 bg-light-subtle">
            <div class="row align-items-center g-3">
                <div class="col-lg-6">
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-id-card-clip text-warning me-2"></i>Patient Check-In by Unique ID
                    </h5>
                    <p class="text-muted small mb-0">Input the patient's 6-character Unique ID (e.g., <code>A3K9P2</code>) to immediately begin vital signs recording.</p>
                </div>
                <div class="col-lg-6">
                    <form asp-action="LookupPatient" method="get" class="d-flex gap-2">
                        <input type="hidden" name="campId" value="@Model.ActiveCamp.Id" />
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 font-monospace text-muted fw-bold">ID:</span>
                            <input type="text" name="patientQuery" class="form-control font-monospace fw-bold text-uppercase border-start-0" 
                                   placeholder="e.g. A3K9P2" maxlength="15" required style="letter-spacing: 0.1em;" />
                            <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                                <i class="fa-solid fa-stethoscope me-1"></i> Record Vitals
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <a asp-action="CreatePatient" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center hover-lift" style="border-left: 4px solid #f59e0b;">
                        <i class="fa-solid fa-user-plus fs-1 text-warning mb-3"></i>
                        <h5 class="fw-bold text-dark">Register New Patient</h5>
                        <p class="text-muted small mb-0">Create new patient profile and auto-generate 6-character Unique ID</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-action="FollowUps" asp-route-campId="@Model.ActiveCamp.Id" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center hover-lift" style="border-left: 4px solid #0d9488;">
                        <i class="fa-solid fa-phone-volume fs-1 text-teal mb-3"></i>
                        <h5 class="fw-bold text-dark">Follow-up Management</h5>
                        <p class="text-muted small mb-0">Call patients needing post-camp care & adherence checks</p>
                    </div>
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form method="get" asp-action="Dashboard" class="row g-3 align-items-end">
                    <input type="hidden" name="activeCampId" value="@Model.ActiveCamp.Id" />
                    <div class="col-md-9">
                        <label class="form-label fw-bold text-secondary small">General Patient Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0 shadow-none" name="searchQuery" value="@Model.SearchQuery" placeholder="Search by Patient Unique ID, Full Name, Phone, or NID..." required />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning w-100 fw-bold rounded-3 py-2 shadow-sm text-dark">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Search Results</h5>
                    <a asp-action="CreatePatient" class="btn btn-sm btn-outline-primary rounded-pill"><i class="fa-solid fa-plus me-1"></i>New Patient</a>
                </div>
                <div class="card-body p-4">
                    @if (Model.SearchResults.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Phone</th>
                                        <th>Location</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in Model.SearchResults)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold text-dark">@patient.FullName</span>
                                                    @if (!string.IsNullOrEmpty(patient.PatientUniqueId))
                                                    {
                                                        <span class="badge bg-warning-subtle text-dark font-monospace px-2 py-0 border border-warning" style="font-size: 0.75rem;">
                                                            @patient.PatientUniqueId
                                                        </span>
                                                    }
                                                </div>
                                                <div class="small text-muted">@patient.Gender &bull; @(patient.DateOfBirth.HasValue ? (DateTime.Today.Year - patient.DateOfBirth.Value.Year) + " yrs" : "Age N/A")</div>
                                            </td>
                                            <td>@patient.PhoneNumber</td>
                                            <td><span class="small text-muted">@patient.Upazila, @patient.District</span></td>
                                            <td class="text-end">
                                                <a asp-action="Triage" asp-route-campId="@Model.ActiveCamp.Id" asp-route-patientId="@patient.Id" class="btn btn-sm btn-warning rounded-pill shadow-sm fw-bold text-dark">
                                                    <i class="fa-solid fa-stethoscope me-1"></i> Start Triage
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-user-xmark fs-1 text-muted mb-3 opacity-25"></i>
                            <h6 class="fw-bold text-secondary">No patients found.</h6>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
