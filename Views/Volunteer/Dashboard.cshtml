@model MediCamp.Models.ViewModels.VolunteerDashboardViewModel
@{
    ViewData["Title"] = "Volunteer Portal Dashboard - MediCamp";
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Flash Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Volunteer Dashboard Main Container with Rounded Card Frame -->
    <div class="host-layout-card">
        <div class="row g-0">

            <!-- Left Emerald Sidebar (Matching Volunteer Navbar Details) -->
            <div class="col-lg-3 col-xl-auto" style="min-width: 250px;">
                <aside class="host-sidebar h-100">
                    <div>
                        <!-- Sidebar Brand / Volunteer Info -->
                        <div class="host-sidebar-brand">
                            <div class="host-sidebar-brand-icon" style="background: linear-gradient(135deg, #10b981 0%, #047857 100%);">
                                <i class="fa-solid fa-hand-holding-medical text-white"></i>
                            </div>
                            <div class="d-flex flex-column text-truncate">
                                <span class="fw-bold text-white fs-5 lh-1 text-truncate">Volunteer Portal</span>
                                <span class="text-champagne opacity-75 small text-uppercase mt-1" style="font-size: 0.68rem; letter-spacing: 0.06em;">Field Operations</span>
                            </div>
                        </div>

                        <!-- Sidebar Navigation Menu (Only Volunteer Scope) -->
                        <nav class="d-flex flex-column">
                            <a asp-controller="Volunteer" asp-action="Dashboard" class="host-nav-item active">
                                <i class="fa-solid fa-gauge fs-6"></i>
                                <span>Patient Lookup</span>
                            </a>
                            <a asp-controller="Volunteer" asp-action="Requests" class="host-nav-item">
                                <i class="fa-solid fa-hand-holding-heart fs-6"></i>
                                <span>Camp Invitations</span>
                                @if (Model.PendingRequestsCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-auto small fw-bold" style="font-size: 0.7rem;">@Model.PendingRequestsCount</span>
                                }
                            </a>
                        </nav>
                    </div>

                    <!-- Sidebar Bottom: Logout Button in White Rounded Pill -->
                    <div class="pt-4 mt-auto">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="host-logout-btn">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </aside>
            </div>

            <!-- Right Details & Operations Panel -->
            <div class="col-lg-9 col-xl">
                <main class="host-main-panel h-100">

                    <!-- Top Bar: Search, Quick Action, Alerts, User Avatar -->
                    <div class="host-topbar">
                        <div class="host-search-wrapper">
                            <form method="get" asp-action="Dashboard" class="m-0 d-flex w-100 align-items-center">
                                @if (Model.ActiveCamp != null)
                                {
                                    <input type="hidden" name="activeCampId" value="@Model.ActiveCamp.Id" />
                                }
                                <i class="fa-solid fa-magnifying-glass host-search-icon"></i>
                                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="host-search-input" placeholder="Search patient by Unique ID, name, phone, or NID..." />
                            </form>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <a asp-action="CreatePatient" class="btn btn-sapphire btn-sm fw-bold px-3 py-2 rounded-pill shadow-sm">
                                <i class="fa-solid fa-user-plus me-1"></i> New Patient
                            </a>

                            <!-- Interactive Notification Bell Dropdown -->
                            <div class="notification-bell-wrapper">
                                <button type="button" class="notification-bell-btn shadow-sm" title="Volunteer Notifications & Camp Invitations" aria-label="Notifications">
                                    <i class="fa-regular fa-bell"></i>
                                    <span class="notification-badge-pulse" style="display: none;">0</span>
                                </button>

                                <!-- Dropdown Panel -->
                                <div class="notification-dropdown-panel shadow-lg">
                                    <div class="notification-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-bell text-champagne"></i>
                                            <span class="fw-bold">Field Notifications</span>
                                        </div>
                                        <span class="badge bg-white text-dark rounded-pill small" style="font-size: 0.72rem;">Live Portal</span>
                                    </div>
                                    <ul class="notification-list">
                                        <li class="text-center py-4 text-muted">
                                            <span class="spinner-border spinner-border-sm text-secondary"></span> Loading...
                                        </li>
                                    </ul>
                                    <div class="notification-footer">
                                        <a asp-controller="Volunteer" asp-action="Requests" class="text-decoration-none fw-bold text-success small">
                                            <i class="fa-solid fa-hand-holding-heart me-1"></i> View Invitations
                                        </a>
                                        <span class="text-muted small">Auto-syncing</span>
                                    </div>
                                </div>
                            </div>

                            <!-- User Avatar Initials Capsule -->
                            <div class="d-flex align-items-center gap-2 bg-white px-3 py-1 rounded-pill border shadow-sm">
                                <div class="avatar-initials rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem; background: #064e3b; color: #f8e7c9;">
                                    @((Model.VolunteerUser?.FullName ?? "Volunteer")[0])
                                </div>
                                <div class="d-flex flex-column text-start">
                                    <span class="fw-bold lh-1 text-dark" style="font-size: 0.84rem;">@(Model.VolunteerUser?.FullName ?? "Field Volunteer")</span>
                                    <span class="text-muted" style="font-size: 0.68rem;">Volunteer Staff</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content Body -->
                    <div class="p-3 p-lg-4">

                        <!-- Welcome Header -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge px-3 py-1 fw-bold text-uppercase" style="background: rgba(16, 185, 129, 0.15); color: #047857; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.72rem; letter-spacing: 0.05em;">
                                        <i class="fa-solid fa-stethoscope me-1"></i> Triage Desk & Field Operations
                                    </span>
                                </div>
                                <h3 class="fw-bold text-dark mb-1">Volunteer Operations Dashboard</h3>
                                <p class="text-muted small mb-0">Record patient vital signs, perform rapid triage intake, and register community members.</p>
                            </div>

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <a asp-action="Requests" class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3 py-2 shadow-sm">
                                    <i class="fa-solid fa-hand-holding-heart me-1 text-danger"></i> Camp Invitations
                                    @if (Model.PendingRequestsCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill ms-1">@Model.PendingRequestsCount</span>
                                    }
                                </a>
                                <a asp-action="CreatePatient" class="btn btn-emerald-solid btn-sm rounded-pill fw-bold px-3 py-2 text-white shadow-sm">
                                    <i class="fa-solid fa-user-plus me-1"></i> Register New Patient
                                </a>
                            </div>
                        </div>

                        <!-- 4 Stat Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-green">
                                        <i class="fa-solid fa-tent"></i>
                                    </div>
                                    <div class="metric-card-value">@Model.OngoingCamps.Count</div>
                                    <div class="metric-card-label">Active Camps</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-champagne">
                                        <i class="fa-solid fa-id-card-clip"></i>
                                    </div>
                                    <div class="metric-card-value">@Model.TodayCheckedInCount</div>
                                    <div class="metric-card-label">Checked-In Today</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-blue">
                                        <i class="fa-solid fa-heart-pulse"></i>
                                    </div>
                                    <div class="metric-card-value">@Model.TotalTriagedCount</div>
                                    <div class="metric-card-label">My Triaged Total</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-red">
                                        <i class="fa-solid fa-envelope-open-text"></i>
                                    </div>
                                    <div class="metric-card-value">@Model.PendingRequestsCount</div>
                                    <div class="metric-card-label">Pending Invitations</div>
                                </div>
                            </div>
                        </div>

                        <!-- Active Camp Station Selection -->
                        <div class="glass-card mb-4 overflow-hidden border-0 shadow-sm" style="border-radius: 20px;">
                            <div class="glass-card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 px-4 bg-white border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(16, 185, 129, 0.15); color: #047857;">
                                        <i class="fa-solid fa-tent-arrows-down"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0 text-dark">Active Field Camp Selection</h5>
                                        <span class="text-muted small">Select the healthcare camp where you are currently stationed</span>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold small">
                                    @Model.OngoingCamps.Count Camp@(Model.OngoingCamps.Count != 1 ? "s" : "") Available
                                </span>
                            </div>

                            <div class="glass-card-body p-3 p-lg-4 bg-light-subtle">
                                @if (!Model.OngoingCamps.Any())
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="fa-solid fa-tent-slash fs-1 mb-2 opacity-50"></i>
                                        <h6 class="fw-bold text-secondary">No active healthcare camps available today.</h6>
                                        <p class="small text-muted mb-0">Check back when camps are scheduled or review your pending invitations.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        @foreach (var camp in Model.OngoingCamps)
                                        {
                                            bool isCurrent = Model.ActiveCamp?.Id == camp.Id;
                                            <div class="col-md-6 col-xl-4">
                                                <div class="card h-100 rounded-4 border-2 @(isCurrent ? "border-success bg-white shadow" : "border-light-subtle bg-white shadow-none") transition-all">
                                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                                        <div>
                                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                                <span class="badge @(isCurrent ? "bg-success" : "bg-secondary-subtle text-dark") rounded-pill px-2 py-1 small">
                                                                    <i class="fa-solid fa-circle-play me-1"></i> @(isCurrent ? "Current Station" : "Active Camp")
                                                                </span>
                                                                <span class="badge bg-dark-subtle text-dark rounded-pill small font-monospace">
                                                                    <i class="fa-solid fa-users me-1"></i> @camp.RegisteredPatientsCount Triaged
                                                                </span>
                                                            </div>
                                                            <h6 class="fw-bold text-dark mb-1 text-truncate" title="@camp.Title">@camp.Title</h6>
                                                            <div class="small text-muted mb-1 text-truncate">
                                                                <i class="fa-solid fa-location-dot text-danger me-1"></i> @camp.Venue, @camp.Upazila, @camp.District
                                                            </div>
                                                            <div class="small text-muted mb-2">
                                                                <i class="fa-solid fa-calendar-day text-primary me-1"></i> @camp.StartDate.ToString("MMM dd") – @camp.EndDate.ToString("MMM dd, yyyy")
                                                            </div>
                                                        </div>
                                                        <div class="mt-2 pt-2 border-top">
                                                            @if (isCurrent)
                                                            {
                                                                <button class="btn btn-success btn-sm w-100 rounded-pill fw-bold text-white shadow-sm" disabled>
                                                                    <i class="fa-solid fa-circle-check me-1"></i> Stationed Here
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <a asp-action="Dashboard" asp-route-activeCampId="@camp.Id"
                                                                   class="btn btn-outline-dark btn-sm w-100 rounded-pill fw-bold">
                                                                    <i class="fa-solid fa-right-to-bracket me-1"></i> Switch to this Camp
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Active Operations Workspace -->
                        @if (Model.ActiveCamp != null)
                        {
                            <!-- Direct Patient Unique ID Check-In Box (Structured, High-Contrast & Comfortable) -->
                            <div class="glass-card mb-4 border-0 shadow-sm overflow-hidden" style="border-radius: 20px; background: #ffffff; border: 1.5px solid rgba(16, 185, 129, 0.3) !important;">
                                <div class="p-3 p-lg-4">
                                    <div class="row align-items-center g-3">
                                        <div class="col-lg-6">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <span class="badge bg-success text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.72rem; letter-spacing: 0.04em;">PATIENT LOOKUP</span>
                                                <span class="small fw-bold text-dark"><i class="fa-solid fa-tent text-success me-1"></i> @Model.ActiveCamp.Title</span>
                                            </div>
                                            <h4 class="fw-bold text-dark mb-1">
                                                Patient Check-In & Triage
                                            </h4>
                                            <p class="text-muted small mb-0">Enter the patient's 6-character Unique ID (e.g., <code>A3K9P2</code>) to immediately open the triage intake desk.</p>
                                        </div>
                                        <div class="col-lg-6">
                                            <form asp-action="LookupPatient" method="get" class="m-0">
                                                <input type="hidden" name="campId" value="@Model.ActiveCamp.Id" />
                                                <div class="input-group shadow-sm rounded-pill overflow-hidden border border-success-subtle">
                                                    <span class="input-group-text bg-light border-0 px-3 font-monospace text-muted fw-bold">
                                                        <i class="fa-solid fa-id-card text-success me-1"></i> ID:
                                                    </span>
                                                    <input type="text" name="patientQuery" class="form-control border-0 font-monospace fw-bold text-uppercase px-2" 
                                                           placeholder="e.g. A3K9P2" maxlength="15" required style="letter-spacing: 0.12em; font-size: 1.1rem;" />
                                                    <button type="submit" class="btn btn-emerald-solid px-4 fw-bold text-white border-0">
                                                        <i class="fa-solid fa-stethoscope me-1"></i> Start Triage
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Action Cards (Register Patient & Follow-Ups) -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <a asp-action="CreatePatient" class="text-decoration-none">
                                        <div class="glass-card p-3 p-lg-4 h-100 rounded-4 border-0 shadow-sm hover-lift bg-white" style="border-left: 5px solid #10b981 !important;">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.15); color: #047857; font-size: 1.3rem; flex-shrink: 0;">
                                                    <i class="fa-solid fa-user-plus"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="fw-bold text-dark mb-1">Register New Patient</h6>
                                                    <p class="text-muted small mb-0">Generate a new patient profile and auto-assign 6-character Unique ID</p>
                                                </div>
                                                <i class="fa-solid fa-chevron-right text-muted opacity-50"></i>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-6">
                                    <a asp-action="FollowUps" asp-route-campId="@Model.ActiveCamp.Id" class="text-decoration-none">
                                        <div class="glass-card p-3 p-lg-4 h-100 rounded-4 border-0 shadow-sm hover-lift bg-white" style="border-left: 5px solid #0d9488 !important;">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(13, 148, 136, 0.15); color: #0d9488; font-size: 1.3rem; flex-shrink: 0;">
                                                    <i class="fa-solid fa-phone-volume"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="fw-bold text-dark mb-1">Follow-up Management</h6>
                                                    <p class="text-muted small mb-0">Manage post-camp care, call records, and patient adherence</p>
                                                </div>
                                                <i class="fa-solid fa-chevron-right text-muted opacity-50"></i>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>

                            <!-- General Patient Search & Results Table -->
                            @if (!string.IsNullOrEmpty(Model.SearchQuery))
                            {
                                <div class="glass-card mb-4 border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
                                    <div class="glass-card-header d-flex justify-content-between align-items-center py-3 px-4 bg-white border-bottom">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(59, 130, 246, 0.15); color: #2563eb;">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            </div>
                                            <h5 class="fw-bold mb-0 text-dark">Search Results for "@Model.SearchQuery"</h5>
                                        </div>
                                        <a asp-action="CreatePatient" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3">
                                            <i class="fa-solid fa-plus me-1"></i> New Patient
                                        </a>
                                    </div>
                                    <div class="glass-card-body p-0">
                                        @if (Model.SearchResults.Any())
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="ps-4 py-3">Patient Info</th>
                                                            <th class="py-3">Contact</th>
                                                            <th class="py-3">Location</th>
                                                            <th class="text-end pe-4 py-3">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var patient in Model.SearchResults)
                                                        {
                                                            <tr>
                                                                <td class="ps-4 py-3">
                                                                    <div class="d-flex align-items-center gap-2">
                                                                        <span class="fw-bold text-dark">@patient.FullName</span>
                                                                        @if (!string.IsNullOrEmpty(patient.PatientUniqueId))
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success font-monospace px-2 py-1 border border-success-subtle" style="font-size: 0.78rem;">
                                                                                @patient.PatientUniqueId
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                    <div class="small text-muted mt-1">
                                                                        <span>@patient.Gender</span> &bull; 
                                                                        <span>@(patient.DateOfBirth.HasValue ? (DateTime.Today.Year - patient.DateOfBirth.Value.Year) + " yrs" : "Age N/A")</span> &bull;
                                                                        <span class="badge bg-danger-subtle text-danger px-1 py-0" style="font-size: 0.72rem;">@(patient.BloodGroup ?? "Blood: N/A")</span>
                                                                    </div>
                                                                </td>
                                                                <td class="py-3">
                                                                    <div class="fw-semibold text-dark"><i class="fa-solid fa-phone text-muted me-1 small"></i> @patient.PhoneNumber</div>
                                                                </td>
                                                                <td class="py-3">
                                                                    <span class="small text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> @patient.Upazila, @patient.District</span>
                                                                </td>
                                                                <td class="text-end pe-4 py-3">
                                                                    <a asp-action="Triage" asp-route-campId="@Model.ActiveCamp.Id" asp-route-patientId="@patient.Id" class="btn btn-sm btn-emerald-solid text-white rounded-pill shadow-sm fw-bold px-3 py-1">
                                                                        <i class="fa-solid fa-stethoscope me-1"></i> Start Triage
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-5">
                                                <i class="fa-solid fa-user-xmark fs-1 text-muted mb-3 opacity-25"></i>
                                                <h6 class="fw-bold text-secondary">No patients found matching query.</h6>
                                                <p class="small text-muted mb-3">You can easily create a new patient profile below.</p>
                                                <a asp-action="CreatePatient" class="btn btn-emerald-solid btn-sm text-white rounded-pill px-4 fw-bold">
                                                    <i class="fa-solid fa-user-plus me-1"></i> Register New Patient
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Live Triage Intake Feed (Active Camp) -->
                            <div class="glass-card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
                                <div class="glass-card-header d-flex justify-content-between align-items-center py-3 px-4 bg-white border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(16, 185, 129, 0.15); color: #047857;">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">Recent Camp Triage Intake</h5>
                                            <span class="text-muted small">Latest patient check-ins at @Model.ActiveCamp.Title</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold small">
                                        <i class="fa-solid fa-bolt me-1"></i> Live Stream
                                    </span>
                                </div>

                                <div class="glass-card-body p-0">
                                    @if (!Model.RecentTriageRecords.Any())
                                    {
                                        <div class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-notes-medical fs-1 mb-2 opacity-25"></i>
                                            <h6 class="fw-bold text-secondary">No triage records logged yet today.</h6>
                                            <p class="small text-muted mb-0">Use the Unique ID box above to check in patients and record vitals.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-4 py-3">Token #</th>
                                                        <th class="py-3">Patient</th>
                                                        <th class="py-3">Vital Signs</th>
                                                        <th class="py-3">Urgency</th>
                                                        <th class="py-3">Status</th>
                                                        <th class="text-end pe-4 py-3">Intake Time</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var record in Model.RecentTriageRecords)
                                                    {
                                                        var urgencyBadge = record.UrgencyLevel switch
                                                        {
                                                            "Emergency" => "bg-danger",
                                                            "Urgent" => "bg-warning text-dark",
                                                            _ => "bg-success"
                                                        };

                                                        <tr>
                                                            <td class="ps-4 py-3">
                                                                <span class="badge bg-dark text-white rounded-pill font-monospace px-2 py-1">
                                                                    #@record.TokenNumber
                                                                </span>
                                                            </td>
                                                            <td class="py-3">
                                                                <div class="fw-bold text-dark">@(record.Patient?.FullName ?? "Unknown Patient")</div>
                                                                <span class="small font-monospace text-muted">@(record.Patient?.PatientUniqueId ?? "ID N/A")</span>
                                                            </td>
                                                            <td class="py-3">
                                                                <div class="small">
                                                                    <span class="fw-semibold text-dark">BP:</span> <span class="badge bg-light text-dark border">@(record.BloodPressure ?? "--/--")</span> &bull;
                                                                    <span class="fw-semibold text-dark">Temp:</span> <span class="badge bg-light text-dark border">@(record.TemperatureF.HasValue ? record.TemperatureF.Value + "°F" : "--")</span> &bull;
                                                                    <span class="fw-semibold text-dark">BMI:</span> <span class="badge bg-light text-dark border">@(record.BMI.HasValue ? record.BMI.Value.ToString() : "--")</span>
                                                                </div>
                                                            </td>
                                                            <td class="py-3">
                                                                <span class="badge @urgencyBadge rounded-pill px-2 py-1 small">
                                                                    @record.UrgencyLevel
                                                                </span>
                                                            </td>
                                                            <td class="py-3">
                                                                @if (record.IsSeenByDoctor)
                                                                {
                                                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 small">
                                                                        <i class="fa-solid fa-user-doctor me-1"></i> Consulted
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2 py-1 small">
                                                                        <i class="fa-solid fa-hourglass-half me-1"></i> In Doctor Queue
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td class="text-end pe-4 py-3">
                                                                <span class="small text-muted fw-semibold">@record.RecordedAt.ToLocalTime().ToString("hh:mm tt")</span>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                </main>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.08)!important;
    }
    .btn-emerald-solid {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        border: none;
        transition: all 0.2s ease;
    }
    .btn-emerald-solid:hover {
        background: linear-gradient(135deg, #047857 0%, #059669 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }
</style>
