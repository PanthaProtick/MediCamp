@model MediCamp.Models.ViewModels.VolunteerDashboardViewModel

@{
    ViewData["Title"] = "Volunteer Dashboard";
}

<div class="container py-4">
    <!-- Active Camp Selection Widget -->
    <div class="glass-card p-4 mb-4" style="background-color: rgba(245, 158, 11, 0.05); border-color: rgba(245, 158, 11, 0.2);">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge badge-role-volunteer"><i class="fa-solid fa-hand-holding-medical"></i> Field Operations</span>
                </div>
                <h4 class="fw-bold text-dark mb-2">Volunteer Dashboard</h4>
                @if (Model.ActiveCamp != null)
                {
                    <p class="text-muted small mb-0">Currently Operating At: <strong class="text-dark">@Model.ActiveCamp.Title</strong></p>
                    <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i>@Model.ActiveCamp.Upazila, @Model.ActiveCamp.District</p>
                }
                else
                {
                    <p class="text-muted small mb-0">Select an active camp to begin operations and triage patients.</p>
                }
            </div>
            <div class="col-md-5">
                <form method="get" asp-action="Dashboard" class="d-flex gap-2">
                    <select name="activeCampId" class="form-select shadow-none fw-bold text-dark border-warning" onchange="this.form.submit()">
                        <option value="">-- Select Active Camp --</option>
                        @foreach (var camp in Model.ApprovedCamps)
                        {
                            if (Model.ActiveCamp?.Id == camp.Id)
                            {
                                <option value="@camp.Id" selected>@camp.Title</option>
                            }
                            else
                            {
                                <option value="@camp.Id">@camp.Title</option>
                            }
                        }
                    </select>
                </form>
            </div>
        </div>
    </div>

    <!-- Operations Panel (Only visible if camp is selected) -->
    @if (Model.ActiveCamp != null)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <a asp-action="Dashboard" asp-route-activeCampId="@Model.ActiveCamp.Id" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center hover-lift" style="border-left: 4px solid #f59e0b;">
                        <i class="fa-solid fa-user-injured fs-1 text-warning mb-3"></i>
                        <h5 class="fw-bold text-dark">Patient Triage</h5>
                        <p class="text-muted small mb-0">Record vitals and queue patients</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-action="FollowUps" asp-route-campId="@Model.ActiveCamp.Id" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center hover-lift" style="border-left: 4px solid #0d9488;">
                        <i class="fa-solid fa-phone-volume fs-1 text-teal mb-3"></i>
                        <h5 class="fw-bold text-dark">Follow-up Management</h5>
                        <p class="text-muted small mb-0">Call patients needing post-camp care</p>
                    </div>
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form method="get" asp-action="Dashboard" class="row g-3 align-items-end">
                    <input type="hidden" name="activeCampId" value="@Model.ActiveCamp.Id" />
                    <div class="col-md-9">
                        <label class="form-label fw-bold text-secondary small">Search Patient for Triage</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0 shadow-none" name="searchQuery" value="@Model.SearchQuery" placeholder="Enter phone number or name..." required />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning w-100 fw-bold rounded-3 py-2 shadow-sm text-dark">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Search Results</h5>
                    <a asp-action="CreatePatient" class="btn btn-sm btn-outline-primary rounded-pill"><i class="fa-solid fa-plus me-1"></i>New Patient</a>
                </div>
                <div class="card-body p-4">
                    @if (Model.SearchResults.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Phone</th>
                                        <th>Location</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in Model.SearchResults)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@patient.FullName</td>
                                            <td>@patient.PhoneNumber</td>
                                            <td><span class="small text-muted">@patient.Upazila, @patient.District</span></td>
                                            <td class="text-end">
                                                <a asp-action="Triage" asp-route-campId="@Model.ActiveCamp.Id" asp-route-patientId="@patient.Id" class="btn btn-sm btn-warning rounded-pill shadow-sm fw-bold">
                                                    <i class="fa-solid fa-stethoscope me-1"></i> Start Triage
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-user-xmark fs-1 text-muted mb-3 opacity-25"></i>
                            <h6 class="fw-bold text-secondary">No patients found.</h6>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
