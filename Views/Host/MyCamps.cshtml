@model List<MediCamp.Models.Domain.Camp>
@{
    ViewData["Title"] = "My Camp Directory - Host Portal";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string hostApprovalStatus = ViewBag.HostApprovalStatus as string ?? "Approved";
    bool isApproved = hostApprovalStatus == "Approved";

    var allCount = Model.Count;
    var pendingCount = Model.Count(c => c.Status == "Pending Admin Approval");
    var scheduledCount = Model.Count(c => c.Status == "Scheduled");
    var ongoingCount = Model.Count(c => c.Status == "Ongoing");
    var completedCount = Model.Count(c => c.Status == "Completed");
    var rejectedCount = Model.Count(c => c.Status == "Rejected");
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-dark-emerald text-champagne px-3 py-1 rounded-pill" style="font-size: 0.76rem; background: #022c22; color: #f8e7c9;">
                    <i class="fa-solid fa-building-ngo me-1"></i> Host Directory
                </span>
                <span class="text-secondary small fw-semibold">Medical Camps Management</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">My Organization Camps</h2>
            <p class="text-muted small mb-0">Monitor camp operations, manage healthcare staffing, allocate inventory, and track patient turnout.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Host" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm-custom bg-white shadow-xs">
                <i class="fa-solid fa-gauge me-1"></i> Host Dashboard
            </a>
            @if (isApproved)
            {
                <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-sm-custom shadow-sm">
                    <i class="fa-solid fa-plus me-1"></i> Create New Camp
                </a>
            }
            else
            {
                <button class="btn btn-secondary btn-sm-custom disabled" title="Account verification required">
                    <i class="fa-solid fa-lock me-1"></i> Create New Camp (Pending Approval)
                </button>
            }
        </div>
    </div>

    <!-- Filter Pills Navigation -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <a class="camp-filter-pill @(selectedStatus == "All" ? "active" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="All">
            <i class="fa-solid fa-list-ul"></i>
            <span>All Camps</span>
            <span class="badge rounded-pill @(selectedStatus == "All" ? "bg-white text-dark" : "bg-light text-secondary border") ms-1">@allCount</span>
        </a>

        <a class="camp-filter-pill @(selectedStatus == "Scheduled" ? "active" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Scheduled">
            <i class="fa-solid fa-calendar-check text-success"></i>
            <span>Scheduled</span>
            <span class="badge rounded-pill @(selectedStatus == "Scheduled" ? "bg-white text-dark" : "bg-success-subtle text-success") ms-1">@scheduledCount</span>
        </a>

        <a class="camp-filter-pill @(selectedStatus == "Ongoing" ? "active" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Ongoing">
            <i class="fa-solid fa-circle-play text-primary"></i>
            <span>Ongoing</span>
            <span class="badge rounded-pill @(selectedStatus == "Ongoing" ? "bg-white text-dark" : "bg-primary-subtle text-primary") ms-1">@ongoingCount</span>
        </a>

        <a class="camp-filter-pill @(selectedStatus == "Pending Admin Approval" ? "active" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Pending Admin Approval">
            <i class="fa-solid fa-hourglass-half text-warning"></i>
            <span>Pending Approval</span>
            <span class="badge rounded-pill @(selectedStatus == "Pending Admin Approval" ? "bg-white text-dark" : "bg-warning-subtle text-warning") ms-1">@pendingCount</span>
        </a>

        <a class="camp-filter-pill @(selectedStatus == "Completed" ? "active" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Completed">
            <i class="fa-solid fa-circle-check text-secondary"></i>
            <span>Completed</span>
            <span class="badge rounded-pill @(selectedStatus == "Completed" ? "bg-white text-dark" : "bg-secondary-subtle text-secondary") ms-1">@completedCount</span>
        </a>

        <a class="camp-filter-pill @(selectedStatus == "Rejected" ? "active" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Rejected">
            <i class="fa-solid fa-ban text-danger"></i>
            <span>Rejected</span>
            <span class="badge rounded-pill @(selectedStatus == "Rejected" ? "bg-white text-dark" : "bg-danger-subtle text-danger") ms-1">@rejectedCount</span>
        </a>
    </div>

    <!-- Camps Table Card -->
    <div class="camp-directory-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Camp Title & Specialty</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Location & Venue</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Schedule Dates</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Patient Turnout</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Budget</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Status</th>
                        <th class="pe-4 py-3 text-end text-secondary text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="py-4">
                                    <i class="fa-solid fa-tent-arrow-turn-left fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                    <h5 class="fw-bold text-dark mb-1">No camps found</h5>
                                    <p class="text-muted small mb-3">No medical camps match the "@selectedStatus" filter status.</p>
                                    @if (isApproved)
                                    {
                                        <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-sm fw-bold px-3 py-2 rounded-pill">
                                            <i class="fa-solid fa-plus me-1"></i> Create Your First Camp
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var camp in Model)
                        {
                            var statusBadgeClass = camp.Status switch
                            {
                                "Pending Admin Approval" => "pending",
                                "Scheduled" => "scheduled",
                                "Ongoing" => "ongoing",
                                "Completed" => "completed",
                                "Rejected" => "rejected",
                                _ => "completed"
                            };

                            var statusIcon = camp.Status switch
                            {
                                "Pending Admin Approval" => "fa-hourglass-half",
                                "Scheduled" => "fa-calendar-check",
                                "Ongoing" => "fa-circle-play",
                                "Completed" => "fa-circle-check",
                                "Rejected" => "fa-ban",
                                _ => "fa-circle-info"
                            };

                            var fulfillmentPct = camp.ExpectedPatients > 0 
                                ? Math.Min(100, (int)Math.Round((double)camp.ServedPatientsCount / camp.ExpectedPatients * 100)) 
                                : 0;

                            <tr class="camp-row-hover @(camp.Status == "Rejected" ? "table-danger opacity-75" : "")">
                                <!-- Camp Title & Specialty -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex flex-column">
                                        <a asp-controller="Host" asp-action="ManageStaff" asp-route-id="@camp.Id" class="fw-bold text-dark text-decoration-none fs-6 mb-1 text-truncate" style="max-width: 260px;" title="@camp.Title">
                                            @camp.Title
                                        </a>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="camp-specialty-badge">
                                                <i class="fa-solid fa-stethoscope"></i>
                                                <span>@(string.IsNullOrWhiteSpace(camp.CampType) ? "General Healthcare" : camp.CampType)</span>
                                            </span>
                                        </div>
                                        @if (camp.Status == "Rejected" && !string.IsNullOrWhiteSpace(camp.CampRejectionReason))
                                        {
                                            <div class="mt-2 p-2 rounded-3 bg-white border border-danger-subtle small text-danger">
                                                <strong><i class="fa-solid fa-circle-exclamation me-1"></i>Admin Feedback:</strong> @camp.CampRejectionReason
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Location & Venue -->
                                <td class="py-3">
                                    <div class="d-flex flex-column">
                                        <div class="fw-bold text-dark small">
                                            <i class="fa-solid fa-location-dot text-danger me-1"></i>@camp.Upazila, @camp.District
                                        </div>
                                        <div class="text-muted small text-truncate mt-0.5" style="max-width: 200px;" title="@camp.Venue">
                                            <i class="fa-solid fa-building text-secondary me-1" style="font-size: 0.72rem;"></i>@camp.Venue
                                        </div>
                                    </div>
                                </td>

                                <!-- Schedule Dates -->
                                <td class="py-3">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="small fw-semibold text-dark">
                                            <i class="fa-regular fa-calendar text-primary me-1"></i>@camp.StartDate.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="small text-muted">
                                            <i class="fa-solid fa-flag-checkered text-secondary me-1"></i>@camp.EndDate.ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                </td>

                                <!-- Patient Turnout -->
                                <td class="py-3" style="min-width: 150px;">
                                    <div class="d-flex justify-content-between align-items-center small mb-1">
                                        <span class="fw-bold text-success"><i class="fa-solid fa-user-check me-1"></i>@camp.ServedPatientsCount Served</span>
                                        <span class="text-muted">/ @camp.ExpectedPatients</span>
                                    </div>
                                    <div class="progress" style="height: 6px; background-color: #f1f5f9; border-radius: 4px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @(fulfillmentPct)%;" aria-valuenow="@fulfillmentPct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </td>

                                <!-- Budget -->
                                <td class="py-3">
                                    <div class="fw-bold text-dark fs-6">৳@camp.TotalBudget.ToString("N0")</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">৳@camp.UtilizedBudget.ToString("N0") utilized</div>
                                </td>

                                <!-- Status -->
                                <td class="py-3">
                                    <span class="camp-status-badge @statusBadgeClass">
                                        <i class="fa-solid @statusIcon"></i>
                                        <span>@camp.Status</span>
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="pe-4 py-3 text-end">
                                    @if (camp.Status == "Rejected")
                                    {
                                        <form asp-controller="Host" asp-action="ResubmitCamp" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@camp.Id" />
                                            <button type="submit" class="btn btn-warning btn-sm rounded-pill fw-bold shadow-xs px-3">
                                                <i class="fa-solid fa-rotate-right me-1"></i> Resubmit
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-end gap-1.5">
                                            <!-- Manage Staff / Primary -->
                                            <a asp-controller="Host" asp-action="ManageStaff" asp-route-id="@camp.Id" class="btn btn-sm btn-sapphire fw-bold rounded-pill px-3 py-1.5 shadow-xs" title="Manage Doctors & Volunteers">
                                                <i class="fa-solid fa-users-gear me-1"></i> Staffing
                                            </a>

                                            <!-- More Actions Dropdown -->
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm border rounded-circle d-flex align-items-center justify-content-center shadow-xs" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px;" title="More Actions">
                                                    <i class="fa-solid fa-ellipsis-vertical text-secondary"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2 rounded-4" style="min-width: 200px;">
                                                    <li class="dropdown-header text-uppercase small fw-bold text-muted" style="font-size: 0.68rem;">Camp Management</li>
                                                    <li>
                                                        <a class="dropdown-item rounded-3 py-2 small" asp-controller="Host" asp-action="ManageInventory" asp-route-id="@camp.Id">
                                                            <i class="fa-solid fa-boxes-stacked text-teal me-2"></i> Medicine Inventory
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item rounded-3 py-2 small" asp-controller="Host" asp-action="MonitorCamp" asp-route-id="@camp.Id">
                                                            <i class="fa-solid fa-chart-line text-primary me-2"></i> Budget & Expenses
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item rounded-3 py-2 small" asp-controller="Host" asp-action="CampSubmitted" asp-route-id="@camp.Id">
                                                            <i class="fa-solid fa-file-invoice text-secondary me-2"></i> Overview Summary
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    <li>
                                                        <a class="dropdown-item rounded-3 py-2 small" asp-controller="Home" asp-action="Camps">
                                                            <i class="fa-solid fa-arrow-up-right-from-square text-muted me-2"></i> Public Directory
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
