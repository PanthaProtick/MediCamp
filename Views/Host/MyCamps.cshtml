@model List<MediCamp.Models.Domain.Camp>
@{
    ViewData["Title"] = "My Camp Directory - Host Portal";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string hostApprovalStatus = ViewBag.HostApprovalStatus as string ?? "Approved";
    bool isApproved = hostApprovalStatus == "Approved";
}

<div class="container py-4">

    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-role-host"><i class="fa-solid fa-building"></i> Host Directory</span>
                <span class="text-muted small">Medical Camps Management</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">My Organization Camps</h2>
            <p class="text-secondary small mb-0">Monitor camp progress, track patient capacity, and check verification statuses.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (isApproved)
            {
                <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-sm-custom shadow-sm">
                    <i class="fa-solid fa-plus me-1"></i> Create New Camp
                </a>
            }
            else
            {
                <button class="btn btn-secondary btn-sm-custom disabled" title="Account verification required">
                    <i class="fa-solid fa-lock me-1"></i> Create New Camp (Pending Approval)
                </button>
            }
        </div>
    </div>

    <!-- Filter Tabs Bar -->
    <div class="glass-card mb-4">
        <div class="glass-card-header p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
            <ul class="nav nav-pills gap-2">
                <li class="nav-item">
                    <a class="nav-link @(selectedStatus == "All" ? "active bg-primary text-white fw-bold" : "text-secondary")" asp-controller="Host" asp-action="MyCamps" asp-route-status="All">
                        <i class="fa-solid fa-list me-1"></i> All Camps (@Model.Count)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(selectedStatus == "Pending Admin Approval" ? "active bg-warning text-dark fw-bold" : "text-secondary")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Pending Admin Approval">
                        <i class="fa-solid fa-hourglass-half me-1"></i> Pending Approval (@Model.Count(c => c.Status == "Pending Admin Approval"))
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(selectedStatus == "Scheduled" ? "active bg-teal text-white fw-bold" : "text-secondary")" style="@(selectedStatus == "Scheduled" ? "background-color: #0d9488 !important;" : "")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Scheduled">
                        <i class="fa-solid fa-calendar-check me-1"></i> Scheduled (@Model.Count(c => c.Status == "Scheduled"))
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(selectedStatus == "Ongoing" ? "active bg-info text-white fw-bold" : "text-secondary")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Ongoing">
                        <i class="fa-solid fa-play me-1"></i> Ongoing (@Model.Count(c => c.Status == "Ongoing"))
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(selectedStatus == "Completed" ? "active bg-secondary text-white fw-bold" : "text-secondary")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Completed">
                        <i class="fa-solid fa-check-double me-1"></i> Completed (@Model.Count(c => c.Status == "Completed"))
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(selectedStatus == "Rejected" ? "active bg-danger text-white fw-bold" : "text-secondary")" asp-controller="Host" asp-action="MyCamps" asp-route-status="Rejected">
                        <i class="fa-solid fa-ban me-1"></i> Rejected (@Model.Count(c => c.Status == "Rejected"))
                    </a>
                </li>
            </ul>
        </div>

        <!-- Table View -->
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Camp Title & Specialty</th>
                        <th>Location & Venue</th>
                        <th>Schedule Dates</th>
                        <th>Capacity & Patients</th>
                        <th>Budget (BDT)</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-tent-arrow-turn-left fs-1 d-block mb-2 opacity-50"></i>
                                <span class="fw-bold fs-6">No camps found under "@selectedStatus" status filter.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var camp in Model)
                        {
                            var badgeStyle = camp.Status switch
                            {
                                "Pending Admin Approval" => "badge-status-pending",
                                "Scheduled" => "badge-status-active",
                                "Ongoing" => "bg-primary text-white",
                                "Completed" => "bg-secondary text-white",
                                "Rejected" => "bg-danger text-white",
                                _ => "bg-light text-dark border"
                            };

                            var statusIcon = camp.Status switch
                            {
                                "Pending Admin Approval" => "fa-hourglass-half",
                                "Scheduled" => "fa-calendar-check",
                                "Ongoing" => "fa-spinner fa-spin",
                                "Completed" => "fa-circle-check",
                                "Rejected" => "fa-ban",
                                _ => "fa-circle-info"
                            };

                            <tr class="@(camp.Status == "Rejected" ? "table-danger opacity-75" : "")">
                                <td>
                                    <div class="fw-bold text-dark mb-0 fs-6">@camp.Title</div>
                                    <span class="badge bg-teal-subtle text-teal border border-teal-subtle py-0.5 px-2 mt-1" style="font-size:0.75rem;">
                                        <i class="fa-solid fa-stethoscope me-1"></i>@camp.CampType
                                    </span>
                                    @if (camp.Status == "Rejected" && !string.IsNullOrWhiteSpace(camp.CampRejectionReason))
                                    {
                                        <div class="mt-2 small text-danger">
                                            <strong><i class="fa-solid fa-circle-exclamation me-1"></i>Admin Feedback:</strong> @camp.CampRejectionReason
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>@camp.Upazila, @camp.District
                                    </div>
                                    <div class="small text-muted text-truncate" style="max-width: 180px;">@camp.Venue</div>
                                </td>
                                <td>
                                    <div class="small text-secondary">
                                        <div><i class="fa-solid fa-calendar-days me-1 text-primary"></i><strong>Start:</strong> @camp.StartDate.ToString("dd MMM yyyy")</div>
                                        <div><i class="fa-solid fa-flag-checkered me-1 text-danger"></i><strong>End:</strong> @camp.EndDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        <div class="fw-bold text-dark"><i class="fa-solid fa-users text-secondary me-1"></i>Target: @camp.ExpectedPatients.ToString("N0")</div>
                                        <div class="text-muted"><i class="fa-solid fa-user-check text-success me-1"></i>Served: @camp.ServedPatientsCount.ToString("N0")</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark">
                                        ৳ @camp.TotalBudget.ToString("N0")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @badgeStyle">
                                        <i class="fa-solid @statusIcon me-1"></i>@camp.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (camp.Status == "Rejected")
                                    {
                                        <form asp-controller="Host" asp-action="ResubmitCamp" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@camp.Id" />
                                            <button type="submit" class="btn btn-warning btn-sm border shadow-sm">
                                                <i class="fa-solid fa-rotate-right me-1"></i> Edit & Resubmit
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Host" asp-action="CampSubmitted" asp-route-id="@camp.Id" class="btn btn-light btn-sm border">
                                            <i class="fa-solid fa-eye me-1"></i> View Summary
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
