@model HostDashboardViewModel
@{
    ViewData["Title"] = "Host Portal Dashboard - MediCamp";

    // Dynamic Monthly Groupings for Bar Chart from Database
    var monthlyGroups = Model.MyCamps
        .GroupBy(c => c.StartDate.ToString("MMM yyyy"))
        .OrderBy(g => g.Min(c => c.StartDate))
        .Take(5)
        .ToList();

    var maxPatientVal = Math.Max(1, monthlyGroups.SelectMany(g => new[] {
        g.Sum(c => c.ExpectedPatients),
        g.Sum(c => c.ServedPatientsCount),
        g.Sum(c => c.RegisteredPatientsCount)
    }).DefaultIfEmpty(100).Max());
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Host Dashboard Main Container with Rounded Card Frame -->
    <div class="host-layout-card">
        <div class="row g-0">

            <!-- Left Emerald Sidebar -->
            <div class="col-lg-3 col-xl-2">
                <aside class="host-sidebar h-100">
                    <div>
                        <!-- Sidebar Brand / Org Info -->
                        <div class="host-sidebar-brand">
                            <div class="host-sidebar-brand-icon">
                                <i class="fa-solid fa-building-ngo"></i>
                            </div>
                            <div class="d-flex flex-column text-truncate">
                                <span class="fw-bold text-white fs-5 lh-1 text-truncate">@(Model.HostUser.OrganizationName ?? "Host Portal")</span>
                                <span class="text-champagne opacity-75 small text-uppercase mt-1" style="font-size: 0.68rem; letter-spacing: 0.06em;">NGO Organizer</span>
                            </div>
                        </div>

                        <!-- Sidebar Navigation Menu -->
                        <nav class="d-flex flex-column">
                            <a asp-controller="Host" asp-action="Dashboard" class="host-nav-item active">
                                <i class="fa-solid fa-house fs-6"></i>
                                <span>Dashboard</span>
                            </a>
                            <a asp-controller="Host" asp-action="MyCamps" class="host-nav-item">
                                <i class="fa-solid fa-tent fs-6"></i>
                                <span>My Camps</span>
                                @if (Model.TotalCampsCount > 0)
                                {
                                    <span class="badge bg-white text-dark rounded-pill ms-auto small" style="font-size: 0.7rem;">@Model.TotalCampsCount</span>
                                }
                            </a>
                            @if (Model.IsApproved)
                            {
                                <a asp-controller="Host" asp-action="CreateCamp" class="host-nav-item">
                                    <i class="fa-solid fa-circle-plus fs-6"></i>
                                    <span>Create Camp</span>
                                </a>
                            }
                            else
                            {
                                <div class="host-nav-item opacity-50" title="Approval Required">
                                    <i class="fa-solid fa-lock fs-6"></i>
                                    <span>Create Camp</span>
                                </div>
                            }
                            <a asp-controller="Host" asp-action="Reports" class="host-nav-item">
                                <i class="fa-solid fa-chart-line fs-6"></i>
                                <span>Reports</span>
                            </a>
                            <a asp-controller="Host" asp-action="MyCamps" class="host-nav-item">
                                <i class="fa-solid fa-user-doctor fs-6"></i>
                                <span>Clinical Teams</span>
                            </a>
                            <a asp-controller="Home" asp-action="Camps" class="host-nav-item">
                                <i class="fa-solid fa-globe fs-6"></i>
                                <span>Public Camps</span>
                            </a>
                        </nav>
                    </div>

                    <!-- Sidebar Bottom: Logout Button in White Rounded Pill -->
                    <div class="pt-4 mt-auto">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="host-logout-btn">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </aside>
            </div>

            <!-- Right Details & Analytics Panel -->
            <div class="col-lg-9 col-xl-10">
                <main class="host-main-panel h-100">

                    <!-- Top Bar: Search, Quick Action, Alerts, User Avatar -->
                    <div class="host-topbar">
                        <div class="host-search-wrapper">
                            <i class="fa-solid fa-magnifying-glass host-search-icon"></i>
                            <input type="text" class="host-search-input" placeholder="Search camps, doctors, venues..." />
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            @if (Model.IsApproved)
                            {
                                <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-sm fw-bold px-3 py-2 rounded-pill shadow-sm">
                                    <i class="fa-solid fa-plus me-1"></i> Create Camp
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill small">
                                    <i class="fa-solid fa-hourglass-half me-1"></i> Pending Verification
                                </span>
                            }

                            <!-- Interactive Notification Bell Dropdown -->
                            <div class="notification-bell-wrapper">
                                <button type="button" class="notification-bell-btn shadow-sm" title="Notifications & Staff Requests" aria-label="Notifications">
                                    <i class="fa-regular fa-bell"></i>
                                    <span class="notification-badge-pulse" style="display: none;">0</span>
                                </button>

                                <!-- Dropdown Panel -->
                                <div class="notification-dropdown-panel shadow-lg">
                                    <div class="notification-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-bell text-champagne"></i>
                                            <span class="fw-bold">Notifications & Requests</span>
                                        </div>
                                        <span class="badge bg-white text-dark rounded-pill small" style="font-size: 0.72rem;">Live Portal</span>
                                    </div>
                                    <ul class="notification-list">
                                        <li class="text-center py-4 text-muted">
                                            <span class="spinner-border spinner-border-sm text-secondary"></span> Loading...
                                        </li>
                                    </ul>
                                    <div class="notification-footer">
                                        <a asp-controller="Host" asp-action="MyCamps" class="text-decoration-none fw-bold text-success small">
                                            <i class="fa-solid fa-tent me-1"></i> Manage All Camps
                                        </a>
                                        <span class="text-muted small">Auto-syncing</span>
                                    </div>
                                </div>
                            </div>

                            <!-- User Avatar Initials Capsule -->
                            <div class="d-flex align-items-center gap-2 bg-white px-3 py-1 rounded-pill border shadow-sm">
                                <div class="avatar-initials rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem; background: #064e3b; color: #f8e7c9;">
                                    @((Model.HostUser.OrganizationName ?? Model.HostUser.FullName)[0])
                                </div>
                                <div class="d-flex flex-column text-start">
                                    <span class="fw-bold lh-1 text-dark" style="font-size: 0.84rem;">@Model.HostUser.FullName</span>
                                    <span class="text-muted" style="font-size: 0.68rem;">Host Focal Person</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Verification Notice Banner (if pending) -->
                    @if (!Model.IsApproved)
                    {
                        <div class="alert alert-warning p-3 rounded-4 shadow-sm mb-4 border-start border-4 border-warning bg-white d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa-solid fa-shield-halved text-warning fs-3"></i>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">Host Verification Pending Review</h6>
                                    <span class="text-secondary small">Your host organization application is currently undergoing admin review.</span>
                                </div>
                            </div>
                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Status: In Review</span>
                        </div>
                    }

                    <!-- Grid Row 1: Operations Chart & Dispensary Summary -->
                    <div class="row g-4 mb-4">

                        <!-- Top Left Card: Dynamic Analytics Bar Chart -->
                        <div class="col-lg-8">
                            <div class="host-widget-card h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">Camp Operations & Patient Influx</h5>
                                        <span class="text-muted small">Live comparison of Expected, Served, and Registered patients</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 small">
                                        <span class="badge bg-white text-secondary border px-2.5 py-1.5 shadow-xs fw-semibold">
                                            <span class="d-inline-block rounded-circle me-1.5" style="width:8px;height:8px;background:#94a3b8;"></span>Expected
                                        </span>
                                        <span class="badge bg-white text-dark border px-2.5 py-1.5 shadow-xs fw-semibold">
                                            <span class="d-inline-block rounded-circle me-1.5" style="width:8px;height:8px;background:#10b981;"></span>Served
                                        </span>
                                        <span class="badge bg-white text-dark border px-2.5 py-1.5 shadow-xs fw-semibold">
                                            <span class="d-inline-block rounded-circle me-1.5" style="width:8px;height:8px;background:#0d9488;"></span>Registered
                                        </span>
                                    </div>
                                </div>

                                <!-- Dynamic Bar Chart Visual Generated from Database -->
                                @if (!monthlyGroups.Any())
                                {
                                    <div class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-chart-column fs-2 d-block mb-2 opacity-50"></i>
                                        <span class="small fw-semibold">No camp consultation records yet. Create a camp to view live analytics.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="bar-chart-container">
                                        <div class="bar-chart-threshold" title="Target Capacity Threshold"></div>

                                        @foreach (var group in monthlyGroups)
                                        {
                                            var exp = group.Sum(c => c.ExpectedPatients);
                                            var srv = group.Sum(c => c.ServedPatientsCount);
                                            var reg = group.Sum(c => c.RegisteredPatientsCount);

                                            var expHeight = Math.Max(14, (int)((double)exp / maxPatientVal * 130));
                                            var srvHeight = Math.Max(14, (int)((double)srv / maxPatientVal * 130));
                                            var regHeight = Math.Max(14, (int)((double)reg / maxPatientVal * 130));

                                            <div class="d-flex flex-column align-items-center gap-2">
                                                <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
                                                    <div class="bar-column light" style="height: @(expHeight)px;" title="Expected: @exp Patients"></div>
                                                    <div class="bar-column" style="height: @(srvHeight)px;" title="Served: @srv Patients"></div>
                                                    <div class="bar-column teal" style="height: @(regHeight)px;" title="Registered: @reg Patients"></div>
                                                </div>
                                                <span class="text-dark small fw-bold">@group.Key</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Top Right Card: Dynamic Clinical Resources & Dispensary -->
                        <div class="col-lg-4">
                            <div class="host-widget-card h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold text-dark mb-0">Dispensary & Patients</h6>
                                        <div class="d-flex gap-1 p-1 bg-light rounded-pill border">
                                            <span class="badge bg-white text-dark shadow-xs rounded-pill px-2.5 py-1 small fw-bold">Live Totals</span>
                                        </div>
                                    </div>

                                    <div class="row g-2 text-center mb-3">
                                        <div class="col-4">
                                            <div class="p-2 rounded-3 bg-light border">
                                                <div class="fs-5 fw-bold text-dark">@Model.TotalExpectedPatients</div>
                                                <div class="text-secondary fw-semibold" style="font-size: 0.72rem;">Expected</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 rounded-3 bg-light border">
                                                <div class="fs-5 fw-bold text-success">@Model.TotalServedPatients</div>
                                                <div class="text-secondary fw-semibold" style="font-size: 0.72rem;">Served</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 rounded-3 bg-light border">
                                                <div class="fs-5 fw-bold text-primary">@Model.TotalRegisteredPatients</div>
                                                <div class="text-secondary fw-semibold" style="font-size: 0.72rem;">Registered</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Budget Overview Box -->
                                    <div class="p-3 rounded-4 bg-light border mb-2">
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span class="text-muted">Total Budget Allocated</span>
                                            <strong class="text-dark fs-6">৳@Model.TotalBudget.ToString("N0")</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center small">
                                            <span class="text-muted">Budget Utilized</span>
                                            <strong class="text-success fs-6">৳@Model.TotalUtilizedBudget.ToString("N0")</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                                    <span class="fw-semibold text-dark"><i class="fa-solid fa-tent text-success me-1"></i>@Model.TotalCampsCount Camps</span>
                                    <span class="fw-semibold text-primary"><i class="fa-solid fa-spinner fa-spin text-primary me-1"></i>@Model.OngoingCount Active</span>
                                    <span class="fw-semibold text-secondary"><i class="fa-solid fa-circle-check text-secondary me-1"></i>@Model.CompletedCount Done</span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Grid Row 2: Performance Donut Rings & Recent Camps List -->
                    <div class="row g-4">

                        <!-- Left Column: Performance Donut Rings + Resource KPI Summary -->
                        <div class="col-lg-7">
                            <div class="host-widget-card h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold text-dark mb-0">Performance & Resource Allocation Ratios</h6>
                                        <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1 small">Live Analytics</span>
                                    </div>

                                    <div class="row g-3 justify-content-around text-center mb-3">
                                        
                                        <!-- Donut 1: Dynamic Patient Fulfillment % -->
                                        <div class="col-4">
                                            <div class="donut-gauge-wrapper">
                                                <div class="donut-ring" style="background: conic-gradient(#f59e0b 0% @(Model.PatientServedPercentage)%, #f1f5f9 @(Model.PatientServedPercentage)% 100%); color: #b45309; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);">
                                                    <div class="rounded-circle bg-white d-flex align-items-center justify-content-center" style="width: 62px; height: 62px;">
                                                        @Model.PatientServedPercentage%
                                                    </div>
                                                </div>
                                                <span class="fw-bold text-dark small d-block">Triage Fulfillment</span>
                                                <span class="text-muted" style="font-size: 0.72rem;">@Model.TotalServedPatients / @Model.TotalExpectedPatients Served</span>
                                            </div>
                                        </div>

                                        <!-- Donut 2: Dynamic Budget Utilized % -->
                                        <div class="col-4">
                                            <div class="donut-gauge-wrapper">
                                                <div class="donut-ring" style="background: conic-gradient(#8b5cf6 0% @(Model.BudgetUtilizationPercentage)%, #f1f5f9 @(Model.BudgetUtilizationPercentage)% 100%); color: #6d28d9; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.2);">
                                                    <div class="rounded-circle bg-white d-flex align-items-center justify-content-center" style="width: 62px; height: 62px;">
                                                        @Model.BudgetUtilizationPercentage%
                                                    </div>
                                                </div>
                                                <span class="fw-bold text-dark small d-block">Budget Utilized</span>
                                                <span class="text-muted" style="font-size: 0.72rem;">৳@Model.TotalUtilizedBudget.ToString("N0") Spent</span>
                                            </div>
                                        </div>

                                        <!-- Donut 3: Dynamic Camp Completion Rate % -->
                                        <div class="col-4">
                                            <div class="donut-gauge-wrapper">
                                                <div class="donut-ring" style="background: conic-gradient(#065f46 0% @(Model.CampCompletionRate)%, #f1f5f9 @(Model.CampCompletionRate)% 100%); color: #064e3b; box-shadow: 0 4px 15px rgba(6, 95, 70, 0.2);">
                                                    <div class="rounded-circle bg-white d-flex align-items-center justify-content-center" style="width: 62px; height: 62px;">
                                                        @Model.CampCompletionRate%
                                                    </div>
                                                </div>
                                                <span class="fw-bold text-dark small d-block">Camp Completion</span>
                                                <span class="text-muted" style="font-size: 0.72rem;">@Model.CompletedCount of @Model.TotalCampsCount Done</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Compact Resource & Efficiency Metrics to eliminate bottom void -->
                                <div class="pt-3 border-top mt-2">
                                    <div class="row g-2 text-center">
                                        <div class="col-4">
                                            <div class="p-2 rounded-3 bg-light border">
                                                <div class="text-muted" style="font-size: 0.68rem;">Avg. Patient/Camp</div>
                                                <div class="fw-bold text-dark small mt-0.5">
                                                    @(Model.TotalCampsCount > 0 ? (Model.TotalServedPatients / Model.TotalCampsCount).ToString("N0") : "0") patients
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 rounded-3 bg-light border">
                                                <div class="text-muted" style="font-size: 0.68rem;">Cost / Patient</div>
                                                <div class="fw-bold text-success small mt-0.5">
                                                    @(Model.TotalServedPatients > 0 ? $"৳{(Model.TotalUtilizedBudget / Model.TotalServedPatients):N0}" : "৳0")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 rounded-3 bg-light border">
                                                <div class="text-muted" style="font-size: 0.68rem;">Scheduled In Queue</div>
                                                <div class="fw-bold text-primary small mt-0.5">
                                                    @Model.ScheduledCount Camps
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Recent Camps List -->
                        <div class="col-lg-5">
                            <div class="host-widget-card h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold text-dark mb-0">Recent Organization Camps</h6>
                                        <a asp-controller="Host" asp-action="MyCamps" class="small fw-bold text-success text-decoration-none">
                                            View All (@Model.TotalCampsCount)
                                        </a>
                                    </div>

                                    <div class="d-flex flex-column gap-2">
                                        @if (!Model.MyCamps.Any())
                                        {
                                            <div class="text-center py-4 text-muted">
                                                <i class="fa-solid fa-tent-arrow-turn-left fs-3 d-block mb-2 opacity-50"></i>
                                                <span class="small fw-bold">No camps hosted yet.</span>
                                                @if (Model.IsApproved)
                                                {
                                                    <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-sm d-block mt-2">
                                                        Create First Camp
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var camp in Model.MyCamps.Take(3))
                                            {
                                                var statusBadgeClass = camp.Status switch
                                                {
                                                    "Pending Admin Approval" => "pending",
                                                    "Scheduled" => "scheduled",
                                                    "Ongoing" => "ongoing",
                                                    "Completed" => "completed",
                                                    "Rejected" => "rejected",
                                                    _ => "completed"
                                                };

                                                <div class="p-2.5 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                                                    <div class="text-truncate me-2">
                                                        <a asp-controller="Host" asp-action="ManageStaff" asp-route-id="@camp.Id" class="fw-bold text-dark small text-truncate d-block text-decoration-none">
                                                            @camp.Title
                                                        </a>
                                                        <span class="text-muted" style="font-size: 0.72rem;">
                                                            <i class="fa-solid fa-location-dot text-danger me-1"></i>@camp.Upazila, @camp.District
                                                        </span>
                                                    </div>
                                                    <span class="camp-status-badge @statusBadgeClass" style="font-size: 0.68rem; padding: 2px 8px;">
                                                        @camp.Status
                                                    </span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="pt-3 border-top mt-3">
                                    <a asp-controller="Host" asp-action="MyCamps" class="btn btn-outline-sapphire btn-sm w-100 rounded-pill fw-bold">
                                        <i class="fa-solid fa-list-check me-1"></i> Full Camp Directory
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>

                </main>
            </div>

        </div>
    </div>

</div>
