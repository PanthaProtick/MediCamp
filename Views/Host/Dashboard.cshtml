@model HostDashboardViewModel
@{
    ViewData["Title"] = "Host Portal Dashboard - MediCamp";
}

<div class="container py-4">

    <!-- Top Header Banner -->
    <div class="glass-card mb-4 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-initials" style="background: linear-gradient(135deg, #0f172a, #0d9488); width: 60px; height: 60px; font-size: 1.5rem; border-radius: 16px;">
                    @((Model.HostUser.OrganizationName ?? Model.HostUser.FullName)[0])
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge badge-role-host"><i class="fa-solid fa-building me-1"></i> Host Organization</span>
                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                <i class="fa-solid fa-circle-check me-1"></i> System Verified & Approved
                            </span>
                        }
                        else if (Model.HostUser.HostApprovalStatus == "Rejected")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1">
                                <i class="fa-solid fa-circle-xmark me-1"></i> Verification Rejected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1">
                                <i class="fa-solid fa-hourglass-half me-1"></i> Pending Admin Verification
                            </span>
                        }
                    </div>
                    <h2 class="fw-bold text-dark mb-0">@(Model.HostUser.OrganizationName ?? Model.HostUser.FullName)</h2>
                    <p class="text-secondary small mb-0">
                        <i class="fa-solid fa-user me-1 text-teal"></i> Focal Person: @Model.HostUser.FullName |
                        <i class="fa-solid fa-envelope me-1 text-teal"></i> @Model.HostUser.Email |
                        <i class="fa-solid fa-location-dot me-1 text-teal"></i> @Model.HostUser.Upazila, @Model.HostUser.District
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (Model.IsApproved)
                {
                    <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-lg shadow-sm">
                        <i class="fa-solid fa-plus-circle me-2"></i> Create New Camp
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg disabled shadow-sm" title="Account verification required">
                        <i class="fa-solid fa-lock me-2"></i> Create New Camp (Pending Approval)
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Verification Alert Banner for Pending/Rejected Hosts -->
    @if (!Model.IsApproved)
    {
        <div class="alert alert-warning p-4 rounded-4 shadow-sm mb-4 border-start border-4 border-warning bg-white">
            <div class="d-flex align-items-start gap-3">
                <div class="stat-icon bg-warning-subtle text-warning" style="width: 48px; height: 48px; font-size: 1.5rem; border-radius: 12px; flex-shrink: 0;">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-1">Organization Governance & Verification Status</h5>
                    @if (Model.HostUser.HostApprovalStatus == "Rejected")
                    {
                        <p class="text-danger mb-0">
                            Your organization registration application was not approved by System Administrators.
                            <strong>Reason:</strong> @(Model.HostUser.HostRejectionReason ?? "Documentation criteria not met.")
                            Please contact System Governance for assistance.
                        </p>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">
                            Your host account application is currently under review by MediCamp System Governance.
                            To ensure patient safety and resource allocation standard, camp creation features are disabled until an Admin approves your application.
                        </p>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Stat Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm text-center border-start border-4 border-primary">
                <span class="d-block text-muted small fw-bold"><i class="fa-solid fa-tent text-primary me-1"></i>Total Host Camps</span>
                <span class="fs-3 fw-bold text-primary">@Model.TotalCampsCount</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm text-center border-start border-4 border-warning">
                <span class="d-block text-muted small fw-bold"><i class="fa-solid fa-hourglass-half text-warning me-1"></i>Pending Admin Approval</span>
                <span class="fs-3 fw-bold text-warning">@Model.PendingCount</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm text-center border-start border-4 border-teal" style="border-left-color: #0d9488 !important;">
                <span class="d-block text-muted small fw-bold"><i class="fa-solid fa-calendar-check text-teal me-1"></i>Scheduled & Active</span>
                <span class="fs-3 fw-bold text-teal">@(Model.ScheduledCount + Model.OngoingCount)</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm text-center border-start border-4 border-secondary">
                <span class="d-block text-muted small fw-bold"><i class="fa-solid fa-circle-check text-secondary me-1"></i>Completed Camps</span>
                <span class="fs-3 fw-bold text-secondary">@Model.CompletedCount</span>
            </div>
        </div>
    </div>

    <!-- Main Content Area: Quick Actions & Recent Camps -->
    <div class="row g-4">
        
        <!-- Left Column: Quick Actions & Workflow Hub -->
        <div class="col-lg-4">
            <div class="glass-card mb-4">
                <div class="glass-card-header p-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-bolt text-warning me-2"></i>Host Actions & Shortcuts
                    </h5>
                </div>
                <div class="glass-card-body p-3">
                    
                    <!-- Action Item 1: Create New Camp -->
                    @if (Model.IsApproved)
                    {
                        <a asp-controller="Host" asp-action="CreateCamp" class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-white border mb-3 text-decoration-none shadow-sm card-hover-effect">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon bg-teal-subtle text-teal" style="width: 42px; height: 42px; font-size: 1.2rem; border-radius: 12px;">
                                    <i class="fa-solid fa-tent"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">Create New Camp</h6>
                                    <span class="text-secondary small">Submit a new camp application</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-muted"></i>
                        </a>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border mb-3 opacity-75">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon bg-secondary-subtle text-secondary" style="width: 42px; height: 42px; font-size: 1.2rem; border-radius: 12px;">
                                    <i class="fa-solid fa-lock"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-muted mb-0">Create New Camp</h6>
                                    <span class="text-warning small fw-semibold">Requires Admin Approval</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-lock text-muted"></i>
                        </div>
                    }

                    <!-- Action Item 2: My Camps -->
                    <a asp-controller="Host" asp-action="MyCamps" class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-white border mb-3 text-decoration-none shadow-sm card-hover-effect">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-primary-subtle text-primary" style="width: 42px; height: 42px; font-size: 1.2rem; border-radius: 12px;">
                                <i class="fa-solid fa-list-check"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">My Camp Directory</h6>
                                <span class="text-secondary small">View and manage all hosted camps</span>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>

                    <!-- Action Item 3: Volunteer & Doctor Allocation -->
                    <a asp-controller="Host" asp-action="MyCamps" class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-white border text-decoration-none shadow-sm card-hover-effect">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-amber-subtle text-amber" style="width: 42px; height: 42px; font-size: 1.2rem; border-radius: 12px; background: rgba(217,119,6,0.1); color:#d97706;">
                                <i class="fa-solid fa-user-doctor"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Field Clinical Teams</h6>
                                <span class="text-secondary small">Doctors & volunteers assigned</span>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column: Recent Camps List -->
        <div class="col-lg-8">
            <div class="glass-card">
                <div class="glass-card-header p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-tent text-teal me-2"></i>My Organization Camps
                    </h5>
                    <a asp-controller="Host" asp-action="MyCamps" class="btn btn-outline-secondary btn-sm">
                        View All (@Model.TotalCampsCount)
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Camp Title & Specialty</th>
                                <th>Location & Venue</th>
                                <th>Schedule</th>
                                <th>Status</th>
                                <th class="text-end">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.MyCamps.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-tent-arrow-turn-left fs-1 d-block mb-2 opacity-50"></i>
                                        <span class="fw-bold fs-6">No camps hosted yet.</span>
                                        @if (Model.IsApproved)
                                        {
                                            <p class="small mb-3">Click below to submit your first medical camp application.</p>
                                            <a asp-controller="Host" asp-action="CreateCamp" class="btn btn-sapphire btn-sm">
                                                <i class="fa-solid fa-plus me-1"></i> Create First Camp
                                            </a>
                                        }
                                        else
                                        {
                                            <p class="small mb-0">Camp creation will be enabled once your host registration is approved.</p>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var camp in Model.MyCamps.Take(5))
                                {
                                    var badgeStyle = camp.Status switch
                                    {
                                        "Pending Admin Approval" => "badge-status-pending",
                                        "Scheduled" => "badge-status-active",
                                        "Ongoing" => "bg-primary text-white",
                                        "Completed" => "bg-secondary text-white",
                                        _ => "bg-light text-dark border"
                                    };

                                    var statusIcon = camp.Status switch
                                    {
                                        "Pending Admin Approval" => "fa-hourglass-half",
                                        "Scheduled" => "fa-calendar-check",
                                        "Ongoing" => "fa-spinner fa-spin",
                                        "Completed" => "fa-circle-check",
                                        _ => "fa-circle-info"
                                    };

                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark mb-0">@camp.Title</div>
                                            <span class="badge bg-teal-subtle text-teal border border-teal-subtle py-0.5 px-2 mt-1" style="font-size:0.75rem;">
                                                @camp.CampType
                                            </span>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">
                                                <i class="fa-solid fa-location-dot text-danger me-1"></i>@camp.Upazila, @camp.District
                                            </div>
                                            <div class="small text-muted text-truncate" style="max-width: 160px;">@camp.Venue</div>
                                        </td>
                                        <td>
                                            <div class="small text-secondary">
                                                <i class="fa-solid fa-calendar-days me-1"></i>@camp.StartDate.ToString("dd MMM yyyy")
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @badgeStyle">
                                                <i class="fa-solid @statusIcon me-1"></i>@camp.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Host" asp-action="MyCamps" class="btn btn-light btn-sm border">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
