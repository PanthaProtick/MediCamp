@model MediCamp.Models.ViewModels.HostManageStaffViewModel

@{
    ViewData["Title"] = "Manage Camp Staff";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Staff: @Model.Camp.Title</h2>
        <a asp-action="MyCamps" class="btn btn-outline-secondary">Back to My Camps</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Sent Requests Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Current Requests for this Camp</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.CurrentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Doctor Name</th>
                                        <th>Status</th>
                                        <th>Requested At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.CurrentRequests)
                                    {
                                        <tr>
                                            <td>@(req.Doctor?.FullName ?? "Unknown")</td>
                                            <td>
                                                @if (req.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else if (req.Status == "Approved")
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Denied</span>
                                                }
                                            </td>
                                            <td>@req.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <p>No staff requests have been sent for this camp yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Available Doctors Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Available Doctors in System</h5>
                </div>
                <div class="card-body p-3 bg-light border-bottom">
                    <form method="get" asp-action="ManageStaff" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@Model.Camp.Id" />
                        <input type="hidden" name="volunteerSearch" value="@ViewBag.VolunteerSearch" />
                        <input type="text" name="doctorSearch" class="form-control form-control-sm" placeholder="Search doctor name or specialty..." value="@ViewBag.DoctorSearch" />
                        <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-search"></i></button>
                        @if (!string.IsNullOrEmpty((string)ViewBag.DoctorSearch))
                        {
                            <a asp-action="ManageStaff" asp-route-id="@Model.Camp.Id" asp-route-volunteerSearch="@ViewBag.VolunteerSearch" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-xmark"></i></a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (Model.AvailableDoctors.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Doctor Name</th>
                                        <th>Specialization</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.AvailableDoctors)
                                    {
                                        var existingRequest = Model.CurrentRequests.FirstOrDefault(r => r.DoctorId == doc.Id);
                                        <tr>
                                            <td>@doc.FullName</td>
                                            <td>@(doc.MedicalSpecialization ?? "General")</td>
                                            <td>
                                                @if (existingRequest != null)
                                                {
                                                    <button class="btn btn-sm btn-secondary" disabled>Request Sent</button>
                                                }
                                                else
                                                {
                                                    <form asp-action="SendStaffRequest" method="post">
                                                        <input type="hidden" name="campId" value="@Model.Camp.Id" />
                                                        <input type="hidden" name="doctorId" value="@doc.Id" />
                                                        <button type="submit" class="btn btn-sm btn-primary">Send Request</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <p>No active doctors found matching your criteria.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Volunteers Section -->
    <h3 class="mt-5 mb-4 border-bottom pb-2">Volunteer Recruitment</h3>
    <div class="row">
        <!-- Sent Volunteer Requests Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Current Volunteer Requests</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.CurrentVolunteerRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Volunteer Name</th>
                                        <th>Status</th>
                                        <th>Requested At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.CurrentVolunteerRequests)
                                    {
                                        <tr>
                                            <td>@(req.Volunteer?.FullName ?? "Unknown")</td>
                                            <td>
                                                @if (req.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else if (req.Status == "Approved")
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Denied</span>
                                                }
                                            </td>
                                            <td>@req.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <p>No volunteer requests have been sent for this camp yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Available Volunteers Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-teal text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Available Volunteers</h5>
                </div>
                <div class="card-body p-3 bg-light border-bottom">
                    <form method="get" asp-action="ManageStaff" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@Model.Camp.Id" />
                        <input type="hidden" name="doctorSearch" value="@ViewBag.DoctorSearch" />
                        <input type="text" name="volunteerSearch" class="form-control form-control-sm" placeholder="Search volunteer name or district..." value="@ViewBag.VolunteerSearch" />
                        <button type="submit" class="btn btn-sm btn-teal text-white" style="background-color: #0d9488; border-color: #0d9488;"><i class="fa-solid fa-search"></i></button>
                        @if (!string.IsNullOrEmpty((string)ViewBag.VolunteerSearch))
                        {
                            <a asp-action="ManageStaff" asp-route-id="@Model.Camp.Id" asp-route-doctorSearch="@ViewBag.DoctorSearch" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-xmark"></i></a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (Model.AvailableVolunteers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Volunteer Name</th>
                                        <th>District</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vol in Model.AvailableVolunteers)
                                    {
                                        var existingRequest = Model.CurrentVolunteerRequests.FirstOrDefault(r => r.VolunteerId == vol.Id);
                                        <tr>
                                            <td>@vol.FullName</td>
                                            <td>@(vol.District ?? "Unknown")</td>
                                            <td>
                                                @if (existingRequest != null)
                                                {
                                                    <button class="btn btn-sm btn-secondary" disabled>Request Sent</button>
                                                }
                                                else
                                                {
                                                    <form asp-action="SendVolunteerRequest" method="post">
                                                        <input type="hidden" name="campId" value="@Model.Camp.Id" />
                                                        <input type="hidden" name="volunteerId" value="@vol.Id" />
                                                        <button type="submit" class="btn btn-sm btn-success">Send Request</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <p>No active volunteers found matching your criteria.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
