@model HostReportsViewModel
@{
    ViewData["Title"] = "Host Reports & Analytics - MediCamp";
}

<div class="container py-4">

    <!-- Header Section -->
    <div class="glass-card mb-4 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge badge-role-host"><i class="fa-solid fa-chart-pie me-1"></i> NGO Host Analytics</span>
                    <span class="badge bg-champagne-subtle text-champagne-dark border px-2.5 py-1">
                        <i class="fa-solid fa-shield-halved me-1"></i> Scoped to Your Camps
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-1">Executive Reports & Field Telemetry</h2>
                <p class="text-secondary small mb-0">
                    Comprehensive insights on budget utilization, clinician throughput, and community healthcare demographics.
                </p>
            </div>

            <!-- Camp Filter Selector & Print Action -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <form method="get" asp-controller="Host" asp-action="Reports" class="d-flex align-items-center gap-2 m-0">
                    <input type="hidden" name="tab" value="@Model.ActiveTab" />
                    <select name="campId" class="form-select form-select-sm shadow-sm" onchange="this.form.submit()" style="min-width: 220px; border-radius: 10px;">
                        <option value="">-- All NGO Camps Aggregated --</option>
                        @foreach (var c in Model.HostCamps)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedCampId == c.Id)">@c.Title (@c.District)</option>
                        }
                    </select>
                </form>

                <button class="btn btn-outline-secondary btn-sm rounded-3 px-3" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> Print / Export
                </button>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="d-flex gap-2 border-bottom mb-4 pb-2">
        <a asp-controller="Host" asp-action="Reports" asp-route-tab="financial" asp-route-campId="@Model.SelectedCampId"
           class="btn @(Model.ActiveTab == "financial" ? "btn-sapphire shadow-sm" : "btn-light text-secondary") rounded-pill px-4 fw-semibold">
            <i class="fa-solid fa-file-invoice-dollar me-2"></i> 1. Financial Report
        </a>
        <a asp-controller="Host" asp-action="Reports" asp-route-tab="staff" asp-route-campId="@Model.SelectedCampId"
           class="btn @(Model.ActiveTab == "staff" ? "btn-sapphire shadow-sm" : "btn-light text-secondary") rounded-pill px-4 fw-semibold">
            <i class="fa-solid fa-user-doctor me-2"></i> 2. Staff Performance
        </a>
        <a asp-controller="Host" asp-action="Reports" asp-route-tab="demographics" asp-route-campId="@Model.SelectedCampId"
           class="btn @(Model.ActiveTab == "demographics" ? "btn-sapphire shadow-sm" : "btn-light text-secondary") rounded-pill px-4 fw-semibold">
            <i class="fa-solid fa-people-roof me-2"></i> 3. Patient Demographics
        </a>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: FINANCIAL REPORT -->
    <!-- ========================================================================= -->
    @if (Model.ActiveTab == "financial")
    {
        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Allocated Budget</span>
                    <h3 class="fw-bold text-primary mb-0">৳@Model.FinancialReport.TotalBudget.ToString("N2")</h3>
                    <span class="text-muted small">Across @(Model.SelectedCamp != null ? "Selected Camp" : $"{Model.HostCamps.Count} Active Camps")</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Actual Utilized Costs</span>
                    <h3 class="fw-bold text-danger mb-0">৳@Model.FinancialReport.TotalSpent.ToString("N2")</h3>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar @(Model.FinancialReport.UtilizationPercentage > 90 ? "bg-danger" : "bg-success")"
                             style="width: @Math.Min(Model.FinancialReport.UtilizationPercentage, 100)%"></div>
                    </div>
                    <span class="text-muted small d-block mt-1">@Model.FinancialReport.UtilizationPercentage.ToString("F1")% Budget Utilized</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Remaining Balance</span>
                    <h3 class="fw-bold text-success mb-0">৳@Model.FinancialReport.RemainingBudget.ToString("N2")</h3>
                    <span class="text-muted small">Available for operations</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Cost Per Patient Served</span>
                    <h3 class="fw-bold text-info mb-0">৳@Model.FinancialReport.CostPerPatient.ToString("N2")</h3>
                    <span class="text-muted small">Based on @Model.FinancialReport.TotalPatientsServed patients</span>
                </div>
            </div>
        </div>

        <!-- Budget vs Actual Cost by Category -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-list-check me-2 text-teal"></i> Budget vs. Actual Cost by Category</h5>
                        <button class="btn btn-sm btn-champagne rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#logExpenseModal">
                            <i class="fa-solid fa-plus me-1"></i> Log Expense
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase text-secondary">
                                    <th>Expense Category</th>
                                    <th class="text-end">Budget Target</th>
                                    <th class="text-end">Actual Spent</th>
                                    <th class="text-end">Variance</th>
                                    <th class="text-end">% Spent</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.FinancialReport.CategoryBreakdown)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold @item.ColorClass">
                                                <i class="fa-solid fa-circle-dot me-1 small"></i> @item.Category
                                            </span>
                                        </td>
                                        <td class="text-end text-secondary">৳@item.AllocatedBudget.ToString("N0")</td>
                                        <td class="text-end fw-bold text-dark">৳@item.ActualSpent.ToString("N0")</td>
                                        <td class="text-end @(item.Variance >= 0 ? "text-success" : "text-danger") small fw-semibold">
                                            @(item.Variance >= 0 ? $"+৳{item.Variance:N0}" : $"-৳{Math.Abs(item.Variance):N0}")
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-light text-dark border">@item.PercentageOfTotalSpent%</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-pie me-2 text-teal"></i> Spending Distribution</h5>
                    <div class="flex-grow-1 d-flex align-items-center justify-content-center" style="min-height: 250px;">
                        <canvas id="financialDonutChart" style="max-height: 240px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Expense Ledger -->
        <div class="glass-card p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-receipt me-2 text-teal"></i> Logged Expense Ledger</h5>
            @if (Model.FinancialReport.ExpenseLogs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-secondary">
                                <th>Date</th>
                                <th>Camp</th>
                                <th>Category</th>
                                <th>Description / Item Details</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in Model.FinancialReport.ExpenseLogs)
                            {
                                <tr>
                                    <td class="small text-secondary">@exp.ExpenseDate.ToString("dd MMM yyyy")</td>
                                    <td class="fw-semibold text-dark">@(exp.Camp?.Title ?? "General Camp")</td>
                                    <td><span class="badge bg-light text-primary border">@exp.Category</span></td>
                                    <td class="small text-muted">@(exp.Description ?? "No description provided")</td>
                                    <td class="text-end fw-bold text-dark">৳@exp.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-receipt fs-2 mb-2 text-secondary opacity-50"></i>
                    <p class="mb-0">No categorized expense receipts recorded yet. Click <strong>Log Expense</strong> to add one.</p>
                </div>
            }
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: STAFF PERFORMANCE REPORT -->
    <!-- ========================================================================= -->
    @if (Model.ActiveTab == "staff")
    {
        <!-- Doctor Performance Table -->
        <div class="glass-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-user-doctor me-2 text-teal"></i> Clinician Performance & Referral Telemetry</h5>
                    <p class="text-secondary small mb-0">Patients consulted, prescriptions formulated, and specialized tertiary referrals issued.</p>
                </div>
            </div>

            @if (Model.StaffReport.DoctorStats.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-secondary">
                                <th>Doctor / Specialist</th>
                                <th>Specialization / BMDC</th>
                                <th class="text-center">Camps Attended</th>
                                <th class="text-center">Patients Consulted</th>
                                <th class="text-center">Prescriptions Issued</th>
                                <th class="text-center">Hospital Referrals</th>
                                <th class="text-end">Referral Rate (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.StaffReport.DoctorStats)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-initials bg-light border text-dark fw-bold" style="width: 36px; height: 36px; font-size: 0.85rem; border-radius: 10px;">
                                                @doc.DoctorName[0]
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@doc.DoctorName</span>
                                                <span class="text-muted small">ID: @doc.DoctorId</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-dark small d-block">@doc.Specialization</span>
                                        <span class="badge bg-secondary-subtle text-secondary small">@doc.BMDCRegNo</span>
                                    </td>
                                    <td class="text-center fw-semibold">@doc.CampsAttended</td>
                                    <td class="text-center"><span class="badge bg-primary-subtle text-primary fs-6 px-3">@doc.PatientsConsulted</span></td>
                                    <td class="text-center fw-semibold text-dark">@doc.PrescriptionsIssued</td>
                                    <td class="text-center"><span class="badge bg-danger-subtle text-danger px-2.5">@doc.ReferralsMade</span></td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <div class="progress" style="width: 60px; height: 6px;">
                                                <div class="progress-bar bg-warning" style="width: @Math.Min(doc.ReferralRate, 100)%"></div>
                                            </div>
                                            <span class="fw-bold text-dark small">@doc.ReferralRate.ToString("F1")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">No clinician consultation records found for this scope.</div>
            }
        </div>

        <div class="row g-4">
            <!-- Volunteer Performance -->
            <div class="col-lg-7">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-hand-holding-heart me-2 text-teal"></i> Volunteer Field Intake & Follow-ups</h5>
                    @if (Model.StaffReport.VolunteerStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-secondary">
                                        <th>Volunteer</th>
                                        <th class="text-center">Triage Logged</th>
                                        <th class="text-center">Follow-ups Assigned</th>
                                        <th class="text-end">Completion Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vol in Model.StaffReport.VolunteerStats)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold text-dark d-block">@vol.VolunteerName</span>
                                                <span class="text-muted small"><i class="fa-solid fa-location-dot me-1"></i>@vol.District</span>
                                            </td>
                                            <td class="text-center"><span class="badge bg-success-subtle text-success fs-6 px-3">@vol.TriageRecordsLogged</span></td>
                                            <td class="text-center fw-semibold">@vol.FollowUpsAssigned</td>
                                            <td class="text-end">
                                                <span class="badge @(vol.FollowUpCompletionRate >= 80 ? "bg-success" : "bg-info") px-2.5">
                                                    @vol.FollowUpCompletionRate.ToString("F0")% Completed
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No volunteer records found.</div>
                    }
                </div>
            </div>

            <!-- Pharmacist Performance -->
            <div class="col-lg-5">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-prescription-bottle-medical me-2 text-teal"></i> Dispensary Throughput</h5>
                    @if (Model.StaffReport.PharmacistStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-secondary">
                                        <th>Pharmacist</th>
                                        <th class="text-center">Prescriptions</th>
                                        <th class="text-end">Units Dispensed</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.StaffReport.PharmacistStats)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@p.PharmacistName</td>
                                            <td class="text-center"><span class="badge bg-info-subtle text-info fs-6 px-2.5">@p.PrescriptionsDispensed</span></td>
                                            <td class="text-end fw-bold text-success">@p.TotalMedicineUnitsDispensed units</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">No pharmacist dispensary records found.</div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 3: PATIENT DEMOGRAPHICS REPORT -->
    <!-- ========================================================================= -->
    @if (Model.ActiveTab == "demographics")
    {
        <!-- Demographics KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Patient Records</span>
                    <h3 class="fw-bold text-teal mb-0">@Model.DemographicsReport.TotalPatients</h3>
                    <span class="text-muted small">Registered across camps</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Primary District</span>
                    <h3 class="fw-bold text-dark mb-0">@(Model.DemographicsReport.DistrictDistribution.FirstOrDefault()?.Label ?? "N/A")</h3>
                    <span class="text-muted small">@(Model.DemographicsReport.DistrictDistribution.FirstOrDefault()?.Count ?? 0) Patients</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Dominant Age Bracket</span>
                    <h3 class="fw-bold text-primary mb-0">@(Model.DemographicsReport.AgeDistribution.OrderByDescending(x => x.Count).FirstOrDefault()?.Label.Split('(')[0] ?? "Adult")</h3>
                    <span class="text-muted small">Community adult cohort</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Triage Urgency</span>
                    <h3 class="fw-bold text-warning mb-0">@(Model.DemographicsReport.UrgencyDistribution.FirstOrDefault(u => u.Label == "Urgent" || u.Label == "Emergency")?.Count ?? 0)</h3>
                    <span class="text-muted small">Urgent / Emergency cases</span>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Age Distribution Chart -->
            <div class="col-lg-6">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-users-line me-2 text-teal"></i> Age Group Breakdown</h5>
                    <div style="min-height: 220px;" class="d-flex align-items-center justify-content-center">
                        <canvas id="ageDistributionChart" style="max-height: 220px;"></canvas>
                    </div>
                </div>
            </div>

            <!-- Gender & Blood Group Distribution -->
            <div class="col-lg-6">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-venus-mars me-2 text-teal"></i> Gender & Blood Group Distribution</h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <span class="small text-secondary fw-semibold d-block mb-2 text-uppercase">Gender Ratio</span>
                            @foreach (var g in Model.DemographicsReport.GenderDistribution)
                            {
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small fw-semibold">
                                        <span>@g.Label</span>
                                        <span>@g.Count (@g.Percentage%)</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar" style="width: @g.Percentage%; background-color: @(g.Label == "Female" ? "#ec4899" : "#3b82f6");"></div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="col-6">
                            <span class="small text-secondary fw-semibold d-block mb-2 text-uppercase">Blood Group Frequency</span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var bg in Model.DemographicsReport.BloodGroupDistribution)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                        @bg.Label: <strong>@bg.Count</strong>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Regional Distribution (District & Upazila) -->
        <div class="glass-card p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-map-location-dot me-2 text-teal"></i> Geographic Catchment Area (Upazila Level)</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-secondary">
                            <th>Upazila / Sub-district</th>
                            <th class="text-center">Patients Served</th>
                            <th>Demographic Proportion</th>
                            <th class="text-end">Coverage Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var up in Model.DemographicsReport.UpazilaDistribution)
                        {
                            <tr>
                                <td class="fw-bold text-dark"><i class="fa-solid fa-location-pin me-2 text-teal"></i>@up.Label</td>
                                <td class="text-center fw-semibold">@up.Count</td>
                                <td>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" style="width: @up.Percentage%; background-color: #0d9488;"></div>
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-dark">@up.Percentage%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<!-- Modal: Log Categorized Camp Expense -->
<div class="modal fade" id="logExpenseModal" tabindex="-1" aria-labelledby="logExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <form asp-controller="Host" asp-action="LogExpense" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold text-dark" id="logExpenseModalLabel">
                        <i class="fa-solid fa-file-invoice-dollar me-2 text-teal"></i> Log Categorized Expense Receipt
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Target Camp</label>
                        <select name="CampId" class="form-select" required>
                            @foreach (var c in Model.HostCamps)
                            {
                                <option value="@c.Id" selected="@(Model.SelectedCampId == c.Id)">@c.Title (@c.District)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Expense Category</label>
                        <select name="Category" class="form-select" required>
                            <option value="Medicines & Medical Supplies">Medicines & Medical Supplies</option>
                            <option value="Doctor & Staff Honorarium">Doctor & Staff Honorarium</option>
                            <option value="Logistics & Transportation">Logistics & Transportation</option>
                            <option value="Venue, Tents & Facilities">Venue, Tents & Facilities</option>
                            <option value="Refreshments & Volunteers">Refreshments & Volunteers</option>
                            <option value="Diagnostic Tools & Equipment">Diagnostic Tools & Equipment</option>
                            <option value="Miscellaneous">Miscellaneous</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Amount (BDT)</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input type="number" step="0.01" min="1" name="Amount" class="form-control" placeholder="e.g. 15000" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Receipt Details / Item Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="e.g. Purchase of emergency pediatric syrup and ORS packets from central depot"></textarea>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold text-secondary">Expense Date</label>
                        <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sapphire rounded-pill px-4">
                        <i class="fa-solid fa-check me-1"></i> Save Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (Model.ActiveTab == "financial")
            {
                <text>
                const financialCtx = document.getElementById('financialDonutChart');
                if (financialCtx) {
                    new Chart(financialCtx, {
                        type: 'doughnut',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.FinancialReport.CategoryBreakdown.Select(c => $"'{c.Category}'")))],
                            datasets: [{
                                data: [@string.Join(",", Model.FinancialReport.CategoryBreakdown.Select(c => c.ActualSpent > 0 ? c.ActualSpent : 1000))],
                                backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#06b6d4', '#64748b', '#ef4444'],
                                borderWidth: 2,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                            }
                        }
                    });
                }
                </text>
            }

            @if (Model.ActiveTab == "demographics")
            {
                <text>
                const ageCtx = document.getElementById('ageDistributionChart');
                if (ageCtx) {
                    new Chart(ageCtx, {
                        type: 'bar',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.DemographicsReport.AgeDistribution.Select(a => $"'{a.Label}'")))],
                            datasets: [{
                                label: 'Patients Count',
                                data: [@string.Join(",", Model.DemographicsReport.AgeDistribution.Select(a => a.Count))],
                                backgroundColor: ['#38bdf8', '#34d399', '#facc15', '#f87171'],
                                borderRadius: 8
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, ticks: { precision: 0 } }
                            },
                            plugins: {
                                legend: { display: false }
                            }
                        }
                    });
                }
                </text>
            }
        });
    </script>
}
