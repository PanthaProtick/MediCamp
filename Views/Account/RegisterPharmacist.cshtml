@model RegisterViewModel
@{
    ViewData["Title"] = "Pharmacist Registration - MediCamp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card">
                <div class="glass-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge badge-role-pharmacist mb-2"><i class="fa-solid fa-prescription-bottle-medical"></i> Camp Pharmacist</span>
                        <h3 class="fw-bold mb-1 text-dark">Pharmacist Registration</h3>
                        <p class="text-secondary small mb-0">Register as a camp pharmacist to receive digital doctor prescriptions and manage medicine stock.</p>
                    </div>
                    <div class="stat-icon stat-icon-sapphire d-none d-sm-flex">
                        <i class="fa-solid fa-pills"></i>
                    </div>
                </div>

                <div class="glass-card-body p-4 p-md-5">
                    <form asp-controller="Account" asp-action="RegisterPharmacist" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-4"></div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-user text-primary me-2"></i>1. Personal & Contact Details
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label-custom">Full Name *</label>
                                <input asp-for="FullName" class="form-control form-control-custom" placeholder="e.g. Nusrat Poly" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label-custom">Email Address *</label>
                                <input asp-for="Email" type="email" class="form-control form-control-custom" placeholder="e.g. pharma.poly@medicamp.org" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label-custom">Mobile Number *</label>
                                <input asp-for="PhoneNumber" class="form-control form-control-custom" placeholder="e.g. 01755000008" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NID" class="form-label-custom">National ID (NID)</label>
                                <input asp-for="NID" class="form-control form-control-custom" placeholder="e.g. 19942690088990011" />
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-location-dot text-primary me-2"></i>2. Location
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="District" class="form-label-custom">District *</label>
                                <select asp-for="District" class="form-select form-select-custom">
                                    <option value="Rangpur">Rangpur</option>
                                    <option value="Kurigram">Kurigram</option>
                                    <option value="Sunamganj">Sunamganj</option>
                                    <option value="Bandarban">Bandarban</option>
                                    <option value="Dhaka">Dhaka</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Upazila" class="form-label-custom">Upazila *</label>
                                <input asp-for="Upazila" class="form-control form-control-custom" placeholder="e.g. Kotwali, Chilmari, Tahirpur" required />
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label-custom">Address *</label>
                                <input asp-for="Address" class="form-control form-control-custom" placeholder="e.g. Dhap Medical Road, Rangpur" required />
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-lock text-primary me-2"></i>3. Password
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label-custom">Account Password *</label>
                                <input asp-for="Password" type="password" class="form-control form-control-custom" placeholder="Min. 6 characters" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label-custom">Confirm Password *</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-custom" placeholder="Repeat password" required />
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                            <a asp-controller="Account" asp-action="Login" class="text-secondary small text-decoration-none">
                                <i class="fa-solid fa-arrow-left me-1"></i> Return to Sign In
                            </a>
                            <button type="submit" class="btn btn-sapphire btn-lg px-4 shadow">
                                <i class="fa-solid fa-user-check me-2"></i> Complete Pharmacist Registration
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
