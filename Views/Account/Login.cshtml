@model LoginViewModel
@{
    ViewData["Title"] = "Sign In - MediCamp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            
            <!-- Main Secure Login Glassmorphism Card -->
            <div class="login-glass-card mb-4">
                <div class="login-glass-header text-center">
                    <div class="brand-badge-logo mx-auto mb-3" style="width: 52px; height: 52px;">
                        <i class="fa-solid fa-shield-halved fs-4"></i>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">Portal Sign In</h3>
                    <p class="text-secondary small mb-0">Enter your registered Email Address or National ID (NID)</p>
                </div>

                <div class="glass-card-body p-4 p-md-5">
                    
                    @if (!ViewData.ModelState.IsValid && !string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); color: #991b1b;">
                            <i class="fa-solid fa-circle-exclamation text-danger fs-5"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-4">
                            <label asp-for="Identifier" class="form-label-custom">Email Address or National ID (NID) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 14px 0 0 14px; border-color: rgba(6, 78, 59, 0.18);">
                                    <i class="fa-solid fa-user" style="color: #065f46;"></i>
                                </span>
                                <input asp-for="Identifier" class="form-control form-control-custom border-start-0" placeholder="e.g. email@domain.org or NID number" style="border-radius: 0 14px 14px 0;" required />
                            </div>
                            <span asp-validation-for="Identifier" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label-custom mb-0">Password *</label>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 14px 0 0 14px; border-color: rgba(6, 78, 59, 0.18);">
                                    <i class="fa-solid fa-key" style="color: #065f46;"></i>
                                </span>
                                <input asp-for="Password" type="password" id="loginPasswordInput" class="form-control form-control-custom border-start-0 border-end-0" placeholder="••••••••" required />
                                <button type="button" class="btn bg-white border border-start-0 px-3 text-secondary" id="togglePasswordVisibilityBtn" style="border-radius: 0 14px 14px 0; border-color: rgba(6, 78, 59, 0.18); cursor: pointer;" title="Show or hide password" aria-label="Toggle password visibility">
                                    <i class="fa-regular fa-eye" id="togglePasswordVisibilityIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberCheck">
                                <label class="form-check-label small text-secondary" for="rememberCheck">
                                    Keep me signed in
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-sapphire w-100 py-3 fs-6 fw-bold mb-3 shadow">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Sign In to Account
                        </button>
                    </form>

                    <!-- Registration Option if user has not registered yet -->
                    <div class="text-center pt-4 border-top" style="border-color: rgba(6, 78, 59, 0.1) !important;">
                        <span class="text-secondary small d-block mb-2 fw-semibold">Haven't registered an account yet?</span>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-sapphire btn-sm w-100 py-2 rounded-pill fw-semibold">
                            <i class="fa-solid fa-user-plus me-1"></i> Register New Account
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('togglePasswordVisibilityBtn');
            const passwordInput = document.getElementById('loginPasswordInput');
            const toggleIcon = document.getElementById('togglePasswordVisibilityIcon');

            if (toggleBtn && passwordInput && toggleIcon) {
                toggleBtn.addEventListener('click', function () {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    if (isPassword) {
                        passwordInput.setAttribute('type', 'text');
                        toggleIcon.classList.remove('fa-eye');
                        toggleIcon.classList.add('fa-eye-slash');
                        toggleIcon.classList.add('text-success');
                        toggleBtn.setAttribute('title', 'Hide password');
                    } else {
                        passwordInput.setAttribute('type', 'password');
                        toggleIcon.classList.remove('fa-eye-slash');
                        toggleIcon.classList.remove('text-success');
                        toggleIcon.classList.add('fa-eye');
                        toggleBtn.setAttribute('title', 'Show password');
                    }
                });
            }
        });
    </script>
}
