@model ApplicationUser
@{
    ViewData["Title"] = "Host Registration Pending Approval - MediCamp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="glass-card text-center p-4 p-md-5">
                <div class="stat-icon stat-icon-amber mx-auto mb-4" style="width: 72px; height: 72px; font-size: 2rem; background: rgba(217, 119, 6, 0.15); color: #d97706; border: 2px solid rgba(217, 119, 6, 0.3);">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>

                <span class="badge badge-status-pending px-3 py-2 fs-6 mb-3">
                    <i class="fa-solid fa-clock me-1"></i> Registration Pending System Admin Review
                </span>

                <h2 class="fw-bold text-dark mb-2">Thank You for Registering Your Organization!</h2>
                <p class="text-secondary mb-4">
                    Your Host organization registration has been successfully received by the MediCamp System Governance team.
                </p>

                @if (Model != null)
                {
                    <div class="p-3 rounded-4 bg-white border text-start mb-4 shadow-sm">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">
                            <i class="fa-solid fa-building-circle-check text-primary me-2"></i>Submitted Registration Summary
                        </h6>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Organization Name:</span>
                                <strong class="text-dark">@(Model.OrganizationName ?? Model.FullName)</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Organization Type:</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@(Model.OrganizationType ?? "Organization")</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Registration / License No:</span>
                                <span>@(string.IsNullOrWhiteSpace(Model.OrganizationRegNo) ? "N/A (Unlicensed / Optional)" : Model.OrganizationRegNo)</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Focal Person Contact:</span>
                                <span>@Model.FullName (@Model.PhoneNumber)</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Official Email:</span>
                                <span>@Model.Email</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Head Office Location:</span>
                                <span>@Model.Upazila, @Model.District</span>
                            </div>
                        </div>
                    </div>
                }

                <div class="alert alert-warning text-start small mb-4 rounded-3 d-flex gap-3 align-items-center" style="background: rgba(217, 119, 6, 0.1); border-left: 4px solid #d97706; color: #92400e;">
                    <i class="fa-solid fa-shield-halved fs-3 text-warning"></i>
                    <div>
                        <strong>Security & Verification Notice:</strong>
                        To maintain clinical safety and verify organizers across rural camps, System Administrators manually review all host applications before granting camp-creation access. You will not be able to log in until your account status is updated to <strong>Approved</strong>.
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sapphire btn-lg px-4 shadow">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Go to Sign In Screen
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light border btn-lg px-4">
                        <i class="fa-solid fa-house me-2"></i> Return to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
