@{
    ViewData["Title"] = "Access Restricted - MediCamp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="glass-card p-5">
                <div class="stat-icon stat-icon-rose mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem;">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Access Restricted</h3>
                <p class="text-secondary mb-4">
                    You do not have the required permissions or system role to access this workspace.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-sapphire">
                        <i class="fa-solid fa-house me-1"></i> Return Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sapphire">
                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
