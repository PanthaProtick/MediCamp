@model MediCamp.Models.ViewModels.AdminCampApprovalsViewModel
@{
    ViewData["Title"] = "Camp Approvals - Governance Portal";
}

<div class="container py-4">
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-role-admin"><i class="fa-solid fa-shield-halved"></i> Governance</span>
                <span class="text-muted small">Medical Camps Management</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Camp Applications</h2>
            <p class="text-secondary small mb-0">Review submitted healthcare camps for clinical and logistical approval.</p>
        </div>
        
        <div class="d-flex align-items-center">
            @if (Model.PendingCamps.Any())
            {
                <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill shadow-sm">
                    <i class="fa-solid fa-clock me-1"></i> @Model.PendingCamps.Count Pending
                </span>
            }
            else
            {
                <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-check-double me-1"></i> All Caught Up
                </span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs nav-tabs-custom mb-4" id="campTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "Pending" ? "active" : "")" asp-action="CampApprovals" asp-route-tab="Pending">
                <i class="fa-solid fa-hourglass-half me-1"></i> Pending Approval 
                @if(Model.PendingCamps.Any()){ <span class="badge bg-warning text-dark ms-1">@Model.PendingCamps.Count</span> }
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "Scheduled" ? "active" : "")" asp-action="CampApprovals" asp-route-tab="Scheduled">
                <i class="fa-solid fa-calendar-check me-1"></i> Scheduled
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "Rejected" ? "active" : "")" asp-action="CampApprovals" asp-route-tab="Rejected">
                <i class="fa-solid fa-ban me-1"></i> Rejected
            </a>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- PENDING TAB -->
        @if (Model.ActiveTab == "Pending")
        {
            <div class="tab-pane fade show active" id="pending">
                @if (!Model.PendingCamps.Any())
                {
                    <div class="text-center py-5 glass-card">
                        <div class="stat-icon stat-icon-amber mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                            <i class="fa-solid fa-check-double"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Queue is Empty</h5>
                        <p class="text-secondary small">No pending camp applications right now.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var camp in Model.PendingCamps)
                        {
                            <div class="col-12">
                                <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                                    <div class="card-body p-4 position-relative">
                                        <div class="position-absolute top-0 end-0 mt-4 me-4">
                                            <span class="small text-muted"><i class="fa-solid fa-clock me-1"></i>Submitted @camp.SubmittedDate.ToString("dd MMM yyyy")</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <h4 class="fw-bold text-dark mb-0">@camp.Title</h4>
                                            <span class="badge bg-teal-subtle text-teal border border-teal-subtle py-1"><i class="fa-solid fa-stethoscope me-1"></i>@camp.CampType</span>
                                        </div>

                                        <div class="mb-3 text-secondary small">
                                            <span class="me-3"><i class="fa-solid fa-building text-primary me-1"></i> <strong>Host:</strong> @camp.HostOrganizationName</span>
                                            <span class="me-3"><i class="fa-solid fa-location-dot text-danger me-1"></i> <strong>Location:</strong> @camp.Venue, @camp.Upazila, @camp.District</span>
                                            <span><i class="fa-solid fa-calendar-days text-info me-1"></i> <strong>Dates:</strong> @camp.StartDate.ToString("dd MMM") - @camp.EndDate.ToString("dd MMM yyyy")</span>
                                        </div>

                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            <div class="badge bg-light text-dark border px-2 py-1"><i class="fa-solid fa-users text-secondary me-1"></i> Expected Patients: @camp.ExpectedPatients.ToString("N0")</div>
                                            <div class="badge bg-light text-dark border px-2 py-1"><i class="fa-solid fa-coins text-success me-1"></i> Budget: ৳ @camp.TotalBudget.ToString("N0")</div>
                                        </div>

                                        @if (camp.HasDateConflict)
                                        {
                                            <div class="alert alert-warning py-2 px-3 small rounded-3 d-flex align-items-center mb-3">
                                                <i class="fa-solid fa-triangle-exclamation text-danger fs-5 me-2"></i>
                                                <span><strong>Date Conflict:</strong> @camp.ConflictWarningMessage</span>
                                            </div>
                                        }

                                        @if (camp.HasCapacitySanityFlag)
                                        {
                                            <div class="alert alert-info py-2 px-3 small rounded-3 d-flex align-items-center mb-3">
                                                <i class="fa-solid fa-circle-info text-primary fs-5 me-2"></i>
                                                <span><strong>Notice:</strong> @camp.CapacitySanityMessage</span>
                                            </div>
                                        }

                                        <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
                                            <button type="button" class="btn btn-outline-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#rejectModal-@camp.Id">
                                                <i class="fa-solid fa-xmark me-1"></i> Reject
                                            </button>
                                            <button type="button" class="btn btn-teal btn-sm px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#approveModal-@camp.Id">
                                                <i class="fa-solid fa-check me-1"></i> Approve
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Reject Modal -->
                            <div class="modal fade" id="rejectModal-@camp.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header border-bottom-0 pb-0">
                                            <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-ban me-2"></i>Reject Camp Application</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="RejectCamp" method="post">
                                            <div class="modal-body pt-2">
                                                <p class="text-secondary small mb-3">You are rejecting the camp <strong>"@camp.Title"</strong>. The host will be notified to review your feedback.</p>
                                                <input type="hidden" name="id" value="@camp.Id" />
                                                <div class="mb-3">
                                                    <label class="form-label small fw-bold">Rejection Reason *</label>
                                                    <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Provide clinical or logistical reasons for rejection..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0 bg-light">
                                                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-ban me-1"></i> Confirm Reject</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Approve Modal -->
                            <div class="modal fade" id="approveModal-@camp.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header border-bottom-0 pb-0">
                                            <h5 class="modal-title fw-bold text-teal"><i class="fa-solid fa-check-circle me-2"></i>Approve Camp</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="ApproveCamp" method="post">
                                            <div class="modal-body pt-2">
                                                <input type="hidden" name="id" value="@camp.Id" />
                                                <p>Are you sure you want to approve <strong>"@camp.Title"</strong>?</p>
                                                <div class="alert alert-success small mb-0 rounded-3">
                                                    <i class="fa-solid fa-bullhorn me-1"></i> It will become visible in the Public Camp Directory for volunteers and patients.
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0 bg-light">
                                                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-teal"><i class="fa-solid fa-check me-1"></i> Approve & Publish</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- SCHEDULED TAB -->
        @if (Model.ActiveTab == "Scheduled")
        {
            <div class="tab-pane fade show active" id="scheduled">
                @if (!Model.ScheduledCamps.Any())
                {
                    <div class="text-center py-5 glass-card">
                        <div class="stat-icon stat-icon-teal mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background: rgba(13, 148, 136, 0.1); color: #0d9488;">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No Scheduled Camps</h5>
                        <p class="text-secondary small">There are currently no approved camps waiting to start.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var camp in Model.ScheduledCamps)
                        {
                            <div class="col-12">
                                <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                                    <div class="card-body p-4 position-relative">
                                        <div class="position-absolute top-0 end-0 mt-4 me-4">
                                            <span class="badge badge-status-active"><i class="fa-solid fa-calendar-check me-1"></i> Scheduled</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mb-2 mt-2">
                                            <h4 class="fw-bold text-dark mb-0">@camp.Title</h4>
                                            <span class="badge bg-teal-subtle text-teal border border-teal-subtle py-1"><i class="fa-solid fa-stethoscope me-1"></i>@camp.CampType</span>
                                        </div>

                                        <div class="mb-3 text-secondary small">
                                            <span class="me-3"><i class="fa-solid fa-building text-primary me-1"></i> <strong>Host:</strong> @camp.HostOrganizationName</span>
                                            <span class="me-3"><i class="fa-solid fa-location-dot text-danger me-1"></i> <strong>Location:</strong> @camp.Venue, @camp.Upazila, @camp.District</span>
                                            <span><i class="fa-solid fa-calendar-days text-info me-1"></i> <strong>Dates:</strong> @camp.StartDate.ToString("dd MMM") - @camp.EndDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- REJECTED TAB -->
        @if (Model.ActiveTab == "Rejected")
        {
            <div class="tab-pane fade show active" id="rejected">
                @if (!Model.RejectedCamps.Any())
                {
                    <div class="text-center py-5 glass-card">
                        <div class="stat-icon stat-icon-sapphire mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background: rgba(30, 58, 138, 0.1); color: #1e3a8a;">
                            <i class="fa-solid fa-list"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No Rejected Camps</h5>
                        <p class="text-secondary small">You have not rejected any camp applications.</p>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var camp in Model.RejectedCamps)
                        {
                            <div class="col-12">
                                <div class="card border rounded-4 shadow-sm bg-white overflow-hidden opacity-75">
                                    <div class="card-body p-4 position-relative">
                                        <div class="position-absolute top-0 end-0 mt-4 me-4">
                                            <span class="badge bg-secondary"><i class="fa-solid fa-ban me-1"></i> Rejected</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mb-2 mt-2">
                                            <h4 class="fw-bold text-dark mb-0 text-decoration-line-through">@camp.Title</h4>
                                            <span class="badge bg-teal-subtle text-teal border border-teal-subtle py-1"><i class="fa-solid fa-stethoscope me-1"></i>@camp.CampType</span>
                                        </div>

                                        <div class="mb-3 text-secondary small">
                                            <span class="me-3"><i class="fa-solid fa-building text-primary me-1"></i> <strong>Host:</strong> @camp.HostOrganizationName</span>
                                            <span class="me-3"><i class="fa-solid fa-location-dot text-danger me-1"></i> <strong>Location:</strong> @camp.Venue, @camp.Upazila, @camp.District</span>
                                            <span><i class="fa-solid fa-calendar-days text-info me-1"></i> <strong>Dates:</strong> @camp.StartDate.ToString("dd MMM") - @camp.EndDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        
                                        <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-start mb-0">
                                            <i class="fa-solid fa-circle-exclamation text-danger fs-6 me-2 mt-1"></i>
                                            <div>
                                                <strong>Rejection Reason:</strong><br/>
                                                <span class="text-dark">@camp.CampRejectionReason</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
