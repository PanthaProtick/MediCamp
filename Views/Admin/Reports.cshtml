@model AdminGlobalReportsViewModel
@{
    ViewData["Title"] = "Admin Global Reports & Analytics - MediCamp";
}

<div class="container py-4">

    <!-- Header Section -->
    <div class="glass-card mb-4 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge badge-role-admin"><i class="fa-solid fa-chart-pie me-1"></i> System-wide Intelligence</span>
                    <span class="badge bg-champagne-subtle text-champagne-dark border px-2.5 py-1">
                        <i class="fa-solid fa-earth-americas me-1"></i> National Health Telemetry
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-1">Global Epidemiological & Resource Analytics</h2>
                <p class="text-secondary small mb-0">
                    Macro health intelligence across Bangladesh: disease prevalence patterns, seasonal epidemiology, central medicine consumption, and multi-tier geographical distribution.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm rounded-3 px-3 shadow-sm" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> Print / Export Report
                </button>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="d-flex gap-2 border-bottom mb-4 pb-2">
        <a asp-controller="Admin" asp-action="Reports" asp-route-tab="disease"
           class="btn @(Model.ActiveTab == "disease" ? "btn-sapphire shadow-sm" : "btn-light text-secondary") rounded-pill px-4 fw-semibold">
            <i class="fa-solid fa-virus me-2"></i> 1. Disease & Seasonal Trends
        </a>
        <a asp-controller="Admin" asp-action="Reports" asp-route-tab="medicine"
           class="btn @(Model.ActiveTab == "medicine" ? "btn-sapphire shadow-sm" : "btn-light text-secondary") rounded-pill px-4 fw-semibold">
            <i class="fa-solid fa-pills me-2"></i> 2. Medicine Usage & Stock Alerts
        </a>
        <a asp-controller="Admin" asp-action="Reports" asp-route-tab="area"
           class="btn @(Model.ActiveTab == "area" ? "btn-sapphire shadow-sm" : "btn-light text-secondary") rounded-pill px-4 fw-semibold">
            <i class="fa-solid fa-network-wired me-2"></i> 3. Area-based Hierarchy Report
        </a>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: DISEASE & SEASONAL REPORT -->
    <!-- ========================================================================= -->
    @if (Model.ActiveTab == "disease")
    {
        <!-- Disease Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Diagnoses Logged</span>
                    <h3 class="fw-bold text-teal mb-0">@Model.DiseaseReport.TotalDiagnosesLogged.ToString("N0")</h3>
                    <span class="text-muted small">From field consultations</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Most Prevalent Condition</span>
                    <h3 class="fw-bold text-danger mb-0">@(Model.DiseaseReport.TopDiseases.FirstOrDefault()?.DiseaseName.Split('&')[0] ?? "Hypertension")</h3>
                    <span class="text-muted small">@(Model.DiseaseReport.TopDiseases.FirstOrDefault()?.Percentage ?? 0)% of all clinical visits</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Highest Burden Region</span>
                    <h3 class="fw-bold text-primary mb-0">@(Model.DiseaseReport.DistrictDiseaseBreakdown.FirstOrDefault()?.Label ?? "Kurigram")</h3>
                    <span class="text-muted small">@(Model.DiseaseReport.DistrictDiseaseBreakdown.FirstOrDefault()?.Count ?? 0) Reported clinical cases</span>
                </div>
            </div>
        </div>

        <!-- Disease Prevalence Ranking & Chart -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-stethoscope me-2 text-teal"></i> Disease-wise Case Counts & Demographics</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase text-secondary">
                                    <th>Diagnosis / Condition</th>
                                    <th class="text-center">Cases</th>
                                    <th class="text-center">Share (%)</th>
                                    <th>Top District</th>
                                    <th class="text-end">Risk Level</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.DiseaseReport.TopDiseases)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark d-block">@d.DiseaseName</span>
                                            <span class="text-muted small">Cohort: @d.CommonAgeGroup</span>
                                        </td>
                                        <td class="text-center fw-bold">@d.CaseCount</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-primary border">@d.Percentage%</span>
                                        </td>
                                        <td class="small"><i class="fa-solid fa-location-dot me-1 text-teal"></i>@d.TopAffectedDistrict</td>
                                        <td class="text-end">
                                            <span class="badge @(d.RiskLevel == "High" ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") px-2.5">
                                                @d.RiskLevel
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-pie me-2 text-teal"></i> Disease Prevalence Share</h5>
                    <div class="flex-grow-1 d-flex align-items-center justify-content-center" style="min-height: 250px;">
                        <canvas id="diseaseDonutChart" style="max-height: 250px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seasonal Epidemiology Insights -->
        <div class="glass-card p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-cloud-sun-rain me-2 text-teal"></i> Seasonal Epidemiology & Disease Surge Analysis</h5>
            <div class="row g-3">
                @foreach (var s in Model.DiseaseReport.SeasonalTrends)
                {
                    <div class="col-md-4">
                        <div class="p-3.5 bg-white rounded-4 border h-100 shadow-sm">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-primary-subtle text-primary fw-semibold px-2.5 py-1">@s.Season</span>
                                <span class="badge bg-danger-subtle text-danger fw-bold">@s.ReportedCases Cases</span>
                            </div>
                            <h6 class="fw-bold text-dark mb-2">@s.PrimaryDisease</h6>
                            <p class="text-secondary small mb-0" style="line-height: 1.6;">
                                @s.ClinicalNote
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: MEDICINE USAGE & STOCK ALERTS -->
    <!-- ========================================================================= -->
    @if (Model.ActiveTab == "medicine")
    {
        <!-- Medicine Summary KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Stock Allocated</span>
                    <h3 class="fw-bold text-primary mb-0">@Model.MedicineReport.TotalMedicinesAllocated.ToString("N0")</h3>
                    <span class="text-muted small">Units across all camps</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Dispensed to Patients</span>
                    <h3 class="fw-bold text-success mb-0">@Model.MedicineReport.TotalMedicinesDispensed.ToString("N0")</h3>
                    <span class="text-muted small">Units dispensed free</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Global Remaining Stock</span>
                    <h3 class="fw-bold text-teal mb-0">@Model.MedicineReport.TotalRemainingStock.ToString("N0")</h3>
                    <span class="text-muted small">Units in camp dispensaries</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                    <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Stock Alerts</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1">@Model.MedicineReport.OutOfStockCount Out-of-Stock</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1">@Model.MedicineReport.LowStockCount Low Stock</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medicine Usage Table -->
        <div class="glass-card p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-boxes-stacked me-2 text-teal"></i> Central Medicine Usage & Remaining Stock Status</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-secondary">
                            <th>Medicine Brand & Generic</th>
                            <th>Category & Strength</th>
                            <th class="text-center">Allocated</th>
                            <th class="text-center">Dispensed</th>
                            <th class="text-center">Remaining</th>
                            <th>Stock Utilization</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var med in Model.MedicineReport.MedicineStockList)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark d-block">@med.BrandName</span>
                                    <span class="text-muted small">@med.GenericName</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border">@med.Category</span>
                                    <span class="small text-secondary ms-1">@med.Strength</span>
                                </td>
                                <td class="text-center fw-semibold">@med.TotalAllocated</td>
                                <td class="text-center fw-bold text-success">@med.TotalDispensed</td>
                                <td class="text-center fw-bold @(med.RemainingStock <= 0 ? "text-danger" : "text-dark")">@med.RemainingStock</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(med.UtilizationRate >= 80 ? "bg-danger" : "bg-success")" style="width: @med.UtilizationRate%"></div>
                                        </div>
                                        <span class="small fw-semibold text-secondary">@med.UtilizationRate.ToString("F0")%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (med.IsOutOfStock)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Out of Stock</span>
                                    }
                                    else if (med.IsLowStock)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Low Stock (&lt;20%)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Sufficient</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Category Usage Breakdown -->
        <div class="glass-card p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-tablets me-2 text-teal"></i> Therapeutic Category Consumption</h5>
            <div class="row g-3">
                @foreach (var cat in Model.MedicineReport.CategoryUsageList)
                {
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark">@cat.Category</span>
                                <span class="badge bg-primary-subtle text-primary">@cat.UtilizationRate.ToString("F0")% Utilized</span>
                            </div>
                            <div class="d-flex justify-content-between small text-secondary">
                                <span>Dispensed: <strong>@cat.TotalDispensed</strong></span>
                                <span>Remaining: <strong>@cat.RemainingStock</strong></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 3: AREA-BASED HIERARCHICAL REPORT -->
    <!-- ========================================================================= -->
    @if (Model.ActiveTab == "area")
    {
        <!-- Geographical Filter Bar -->
        <div class="glass-card p-3 mb-4">
            <form method="get" asp-controller="Admin" asp-action="Reports" class="row g-3 align-items-center">
                <input type="hidden" name="tab" value="area" />
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-secondary mb-1">Filter by Division</label>
                    <select name="division" class="form-select form-select-sm shadow-sm" onchange="this.form.submit()">
                        <option value="">-- All Divisions (National Rollup) --</option>
                        @foreach (var div in Model.AreaReport.AvailableDivisions)
                        {
                            <option value="@div" selected="@(Model.AreaReport.SelectedDivision == div)">@div Division</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-secondary mb-1">Filter by District</label>
                    <select name="district" class="form-select form-select-sm shadow-sm" onchange="this.form.submit()">
                        <option value="">-- All Districts in Division --</option>
                        @foreach (var dist in Model.AreaReport.AvailableDistricts)
                        {
                            <option value="@dist" selected="@(Model.AreaReport.SelectedDistrict == dist)">@dist</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <a asp-controller="Admin" asp-action="Reports" asp-route-tab="area" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-arrows-rotate me-1"></i> Reset Filters
                    </a>
                </div>
            </form>
        </div>

        <!-- Multi-tier Area Aggregation Table -->
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-sitemap me-2 text-teal"></i> Multi-tier Regional Aggregation: Division &rarr; District &rarr; Upazila &rarr; Union &rarr; Village</h5>
                    <p class="text-secondary small mb-0">Local community health footprint, primary diagnosis burden, and clinical deployment.</p>
                </div>
                <span class="badge bg-teal-subtle text-teal border px-3 py-1.5 fw-semibold">
                    @Model.AreaReport.TotalDistrictsCovered Districts &bull; @Model.AreaReport.TotalUpazilasCovered Upazilas
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-secondary">
                            <th>Division & District</th>
                            <th>Upazila / Sub-district</th>
                            <th>Union / Village Target</th>
                            <th class="text-center">Camps Conducted</th>
                            <th class="text-center">Patients Served</th>
                            <th>Dominant Local Health Burden</th>
                            <th class="text-end">Doctors / Meds</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AreaReport.AreaHierarchyData)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark d-block">@item.District</span>
                                    <span class="text-muted small">@item.Division Division</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">
                                        <i class="fa-solid fa-location-pin me-1 small"></i> @item.Upazila
                                    </span>
                                </td>
                                <td class="small">
                                    <span class="d-block text-dark">@item.Union</span>
                                    <span class="text-muted">@item.Village</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.CampsCount > 0 ? "bg-success" : "bg-light text-secondary border") px-2.5">
                                        @item.CampsCount Camp(s)
                                    </span>
                                </td>
                                <td class="text-center fw-bold text-teal">
                                    @item.PatientsServed.ToString("N0")
                                </td>
                                <td>
                                    <span class="badge bg-light text-danger border small">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> @item.TopDisease
                                    </span>
                                </td>
                                <td class="text-end small">
                                    <span class="d-block fw-semibold text-dark"><i class="fa-solid fa-user-doctor me-1 text-teal"></i>@item.DoctorsDeployed Docs</span>
                                    <span class="text-muted"><i class="fa-solid fa-pills me-1 text-danger"></i>@item.MedicinesDispensed units</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (Model.ActiveTab == "disease")
            {
                <text>
                const diseaseCtx = document.getElementById('diseaseDonutChart');
                if (diseaseCtx) {
                    new Chart(diseaseCtx, {
                        type: 'doughnut',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.DiseaseReport.TopDiseases.Take(6).Select(d => $"'{d.DiseaseName.Split('&')[0].Trim()}'")))],
                            datasets: [{
                                data: [@string.Join(",", Model.DiseaseReport.TopDiseases.Take(6).Select(d => d.CaseCount))],
                                backgroundColor: ['#ef4444', '#3b82f6', '#f59e0b', '#10b981', '#06b6d4', '#8b5cf6'],
                                borderWidth: 2,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                            }
                        }
                    });
                }
                </text>
            }
        });
    </script>
}
