@model HostApprovalsViewModel
@{
    ViewData["Title"] = "Host Approvals & Verification - Admin Governance";
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Top Navigation Breadcrumb & Header -->
    <div class="glass-card p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1">
                        <i class="fa-solid fa-arrow-left me-1"></i> Admin Dashboard
                    </a>
                    <span class="badge badge-role-admin"><i class="fa-solid fa-shield-halved me-1"></i> Admin Governance</span>
                    <span class="badge bg-champagne text-dark border px-2.5 py-1 fw-bold">NGO Verification</span>
                </div>
                <h2 class="fw-bold text-dark mb-1">Host Organization Verification Queue</h2>
                <p class="text-secondary small mb-0">
                    Review and verify NGO / Hospital organization registrations before they can publish public healthcare camps.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Admin" asp-action="UserManagement" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-users-gear me-1"></i> User Directory
                </a>
                <a asp-controller="Admin" asp-action="CampApprovals" class="btn btn-sapphire btn-sm rounded-pill px-3 shadow-sm">
                    <i class="fa-solid fa-tent-arrow-turn-left me-1"></i> Camp Approvals
                </a>
            </div>
        </div>
    </div>


    <!-- Metric Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="p-3 bg-white rounded-4 border shadow-sm border-start border-4 border-warning h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Pending Review</span>
                        <h3 class="fw-bold text-warning mb-0">@Model.PendingCount</h3>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning" style="width: 44px; height: 44px; border-radius: 12px; font-size: 1.2rem;">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="p-3 bg-white rounded-4 border shadow-sm border-start border-4 border-success h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Approved & Verified</span>
                        <h3 class="fw-bold text-success mb-0">@Model.ApprovedCount</h3>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success" style="width: 44px; height: 44px; border-radius: 12px; font-size: 1.2rem;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="p-3 bg-white rounded-4 border shadow-sm border-start border-4 border-danger h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Rejected Applications</span>
                        <h3 class="fw-bold text-danger mb-0">@Model.RejectedCount</h3>
                    </div>
                    <div class="stat-icon bg-danger-subtle text-danger" style="width: 44px; height: 44px; border-radius: 12px; font-size: 1.2rem;">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="p-3 bg-white rounded-4 border shadow-sm border-start border-4 border-primary h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Host Accounts</span>
                        <h3 class="fw-bold text-primary mb-0">@Model.TotalCount</h3>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary" style="width: 44px; height: 44px; border-radius: 12px; font-size: 1.2rem;">
                        <i class="fa-solid fa-building"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Structured Data Panel -->
    <div class="glass-card mb-4 overflow-hidden">
        
        <!-- Filter Toolbar -->
        <div class="p-3 bg-white border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
            
            <!-- Filter Tabs -->
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-sm rounded-pill px-3 fw-bold @(Model.ActiveTab == "Pending" ? "btn-warning text-dark shadow-xs" : "btn-light text-secondary border")" 
                   asp-controller="Admin" asp-action="HostApprovals" asp-route-tab="Pending" asp-route-search="@Model.SearchTerm">
                    <i class="fa-solid fa-hourglass-half me-1"></i> Pending Queue 
                    <span class="badge bg-dark text-white rounded-pill ms-1">@Model.PendingCount</span>
                </a>
                <a class="btn btn-sm rounded-pill px-3 fw-bold @(Model.ActiveTab == "Approved" ? "btn-success text-white shadow-xs" : "btn-light text-secondary border")" 
                   asp-controller="Admin" asp-action="HostApprovals" asp-route-tab="Approved" asp-route-search="@Model.SearchTerm">
                    <i class="fa-solid fa-circle-check me-1"></i> Approved History 
                    <span class="badge bg-white text-success rounded-pill ms-1">@Model.ApprovedCount</span>
                </a>
                <a class="btn btn-sm rounded-pill px-3 fw-bold @(Model.ActiveTab == "Rejected" ? "btn-danger text-white shadow-xs" : "btn-light text-secondary border")" 
                   asp-controller="Admin" asp-action="HostApprovals" asp-route-tab="Rejected" asp-route-search="@Model.SearchTerm">
                    <i class="fa-solid fa-circle-xmark me-1"></i> Rejected History 
                    <span class="badge bg-white text-danger rounded-pill ms-1">@Model.RejectedCount</span>
                </a>
                <a class="btn btn-sm rounded-pill px-3 fw-bold @(Model.ActiveTab == "All" ? "btn-primary text-white shadow-xs" : "btn-light text-secondary border")" 
                   asp-controller="Admin" asp-action="HostApprovals" asp-route-tab="All" asp-route-search="@Model.SearchTerm">
                    <i class="fa-solid fa-list me-1"></i> All Records 
                    <span class="badge bg-light text-dark rounded-pill ms-1">@Model.TotalCount</span>
                </a>
            </div>

            <!-- Instant Search & Quick Filter -->
            <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end" style="max-width: 450px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="hostFilterInput" class="form-control border-start-0" placeholder="Instant filter by name, district, license, person..." />
                </div>
            </div>
        </div>

        <!-- Structured Table View -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="hostTable">
                <thead class="table-light">
                    <tr class="small text-uppercase text-secondary">
                        <th class="ps-4">Organization & Type</th>
                        <th>Govt. License / Reg No.</th>
                        <th>Focal Person Contact</th>
                        <th>District / Location</th>
                        <th>Submitted Date</th>
                        <th>Approval Status</th>
                        <th class="text-end pe-4">Verification Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var targetList = Model.ActiveTab switch
                        {
                            "Approved" => Model.ApprovedHosts,
                            "Rejected" => Model.RejectedHosts,
                            "All" => Model.AllHosts,
                            _ => Model.PendingHosts
                        };
                    }

                    @if (!targetList.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="stat-icon bg-light text-secondary mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; border-radius: 50%;">
                                    <i class="fa-solid fa-folder-open"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">No @Model.ActiveTab.ToLower() applications in this queue</h6>
                                <p class="small mb-0">All submitted applications have been processed or non-existent in this view.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var host in targetList)
                        {
                            var statusBadgeClass = host.HostApprovalStatus switch
                            {
                                "Approved" => "badge-status-active",
                                "Rejected" => "badge-status-disabled",
                                _ => "badge-status-pending"
                            };

                            var statusIcon = host.HostApprovalStatus switch
                            {
                                "Approved" => "fa-circle-check",
                                "Rejected" => "fa-circle-xmark",
                                _ => "fa-hourglass-half"
                            };

                            var orgTypeBadge = host.OrganizationType switch
                            {
                                "Hospital" => "bg-info-subtle text-info border border-info-subtle",
                                "Corporate" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Community Group" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                _ => "bg-teal-subtle text-teal border border-teal-subtle"
                            };

                            <tr class="host-row-item">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-initials rounded-3 d-flex align-items-center justify-content-center fw-bold text-white shadow-xs" 
                                             style="background: linear-gradient(135deg, #064e3b, #047857); width: 44px; height: 44px; font-size: 1.1rem; flex-shrink: 0;">
                                            @((host.OrganizationName ?? host.FullName)[0])
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6 searchable-field">@(host.OrganizationName ?? host.FullName)</div>
                                            <span class="badge @orgTypeBadge px-2 py-0.5 small mt-1 searchable-field">
                                                <i class="fa-solid fa-building me-1"></i>@(host.OrganizationType ?? "Healthcare NGO")
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(host.OrganizationRegNo))
                                    {
                                        <span class="font-monospace small fw-bold text-dark bg-light px-2.5 py-1 rounded border searchable-field">
                                            <i class="fa-solid fa-id-card text-primary me-1"></i>@host.OrganizationRegNo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">N/A (Standard)</span>
                                    }
                                </td>

                                <td>
                                    <div class="small">
                                        <div class="fw-bold text-dark searchable-field">
                                            <i class="fa-solid fa-user-tie text-secondary me-1"></i>@host.FullName
                                        </div>
                                        <div class="text-muted searchable-field">
                                            <i class="fa-solid fa-phone text-success me-1"></i>@host.PhoneNumber
                                        </div>
                                        <div class="text-muted searchable-field">
                                            <i class="fa-solid fa-envelope text-info me-1"></i>@host.Email
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="small">
                                        <div class="fw-bold text-dark searchable-field">
                                            <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                            @(host.Upazila ?? "Area"), @(host.District ?? "District")
                                        </div>
                                        <div class="text-muted small text-truncate" style="max-width: 170px;">
                                            @(host.Address ?? "N/A")
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="small text-secondary">
                                        <i class="fa-solid fa-calendar-day me-1"></i>
                                        @host.CreatedAt.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @statusBadgeClass px-2.5 py-1">
                                        <i class="fa-solid @statusIcon me-1"></i> @host.HostApprovalStatus
                                    </span>
                                    @if (host.HostApprovalStatus == "Rejected" && !string.IsNullOrEmpty(host.HostRejectionReason))
                                    {
                                        <div class="small text-danger mt-1" style="font-size: 0.72rem; max-width: 180px;" title="@host.HostRejectionReason">
                                            <i class="fa-solid fa-circle-info me-1"></i>@host.HostRejectionReason
                                        </div>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    @if (host.HostApprovalStatus == "Pending")
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-controller="Admin" asp-action="ApproveHost" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@host.Id" />
                                                <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs fw-bold" onclick="return confirm('Approve @(host.OrganizationName ?? host.FullName) as a verified Host?');">
                                                    <i class="fa-solid fa-check me-1"></i> Approve
                                                </button>
                                            </form>

                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-xs fw-bold" onclick="openRejectModal('@host.Id', '@(host.OrganizationName ?? host.FullName)')">
                                                <i class="fa-solid fa-times me-1"></i> Reject
                                            </button>
                                        </div>
                                    }
                                    else if (host.HostApprovalStatus == "Approved")
                                    {
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 small">
                                                <i class="fa-solid fa-check-double me-1"></i> Active
                                            </span>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-1 px-2.5" style="font-size: 0.75rem;" onclick="openRejectModal('@host.Id', '@(host.OrganizationName ?? host.FullName)')">
                                                Revoke
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="ApproveHost" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@host.Id" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-bold">
                                                <i class="fa-solid fa-rotate-left me-1"></i> Re-Approve
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing <strong>@targetList.Count</strong> host application(s) in <strong>@Model.ActiveTab</strong> tab</span>
            <span class="small text-muted"><i class="fa-solid fa-shield-halved text-success me-1"></i>Strict Role-Based Admin Governance</span>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL: Reject Host Application Modal
     ========================================================================= -->
<div class="modal fade" id="rejectHostModal" tabindex="-1" aria-labelledby="rejectHostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; background: #faf8f2;">
            <div class="modal-header border-bottom px-4 py-3 bg-white" style="border-radius: 20px 20px 0 0;">
                <div class="d-flex align-items-center gap-2">
                    <div class="stat-icon bg-danger-subtle text-danger" style="width: 38px; height: 38px; font-size: 1rem; border-radius: 12px;">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="rejectHostModalLabel">Reject Host Organization</h5>
                        <p class="text-secondary small mb-0">Specify the official reason for application rejection.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Admin" asp-action="RejectHost" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="rejectUserId" />

                <div class="modal-body p-4">
                    <div class="p-3 rounded-3 bg-white border mb-3">
                        <div class="text-muted small">Organization:</div>
                        <div class="fw-bold text-dark fs-6" id="rejectOrgName">Loading...</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Reason for Rejection *</label>
                        <textarea name="rejectionReason" class="form-control rounded-3" rows="3" placeholder="e.g. Invalid organization license number, unverified focal person contact, or duplicate account..." required></textarea>
                        <span class="text-muted small">This reason will be displayed to the host applicant.</span>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-white" style="border-radius: 0 0 20px 20px;">
                    <button type="button" class="btn btn-light border rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-ban me-1"></i> Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(userId, orgName) {
            document.getElementById('rejectUserId').value = userId;
            document.getElementById('rejectOrgName').innerText = orgName;
            new bootstrap.Modal(document.getElementById('rejectHostModal')).show();
        }

        // Real-time client side search filtering
        document.getElementById('hostFilterInput')?.addEventListener('keyup', function () {
            const query = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.host-row-item');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    </script>
}

