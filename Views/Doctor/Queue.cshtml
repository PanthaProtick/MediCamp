@model MediCamp.Models.ViewModels.DoctorQueueViewModel

@{
    ViewData["Title"] = "Patient Queue — Doctor";
}

<style>
    .urgency-emergency { border-left: 5px solid #dc3545 !important; }
    .urgency-urgent    { border-left: 5px solid #ffc107 !important; }
    .urgency-normal    { border-left: 5px solid #198754 !important; }

    .queue-row:hover { background-color: #f8f9ff; transition: background .15s; }

    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem .85rem;
        border-radius: 50px;
        font-size: .82rem;
        font-weight: 700;
    }

    .camp-selector-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border-radius: 16px;
        padding: 2rem;
        color: #fff;
    }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-role-doctor"><i class="fa-solid fa-stethoscope"></i> Doctor Portal</span>
                @if (Model.ActiveCamp != null)
                {
                    <span class="text-muted small">@Model.ActiveCamp.Title</span>
                }
            </div>
            <h2 class="fw-bold text-dark mb-0">Patient Queue</h2>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a asp-action="Requests" class="btn btn-outline-secondary btn-sm rounded-pill fw-bold">
                <i class="fa-solid fa-envelope me-1"></i> Camp Invitations
            </a>
            @if (Model.ActiveCamp != null)
            {
                <a asp-action="Queue" asp-route-activeCampId="@Model.ActiveCamp.Id" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Ongoing Camps Section -->
    <div class="glass-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tent text-primary me-2"></i>Ongoing Healthcare Camps</h4>
                <p class="text-muted small mb-0">Select an active camp below to enter its consultation desk and examine patients.</p>
            </div>
            <span class="badge bg-success rounded-pill px-3 py-2 fw-bold">
                <i class="fa-solid fa-circle-dot me-1"></i> @Model.OngoingCamps.Count Active Camp@(Model.OngoingCamps.Count != 1 ? "s" : "")
            </span>
        </div>

        @if (!Model.OngoingCamps.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="fa-solid fa-tent-arrows-down fs-1 mb-2 opacity-50"></i>
                <p class="mb-0">No ongoing healthcare camps found matching today's date.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var camp in Model.OngoingCamps)
                {
                    bool isCurrent = Model.ActiveCamp?.Id == camp.Id;
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 rounded-4 border-2 @(isCurrent ? "border-primary bg-primary-subtle shadow-sm" : "border-light-subtle shadow-none") transition-all">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <span class="badge bg-success rounded-pill px-2 py-1 small">
                                            <i class="fa-solid fa-circle-play me-1"></i> Active Now
                                        </span>
                                        <span class="badge bg-dark-subtle text-dark rounded-pill small">
                                            <i class="fa-solid fa-users me-1"></i> @camp.ServedPatientsCount Served
                                        </span>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@camp.Title</h6>
                                    <div class="small text-muted mb-1">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i> @camp.Venue, @camp.Upazila, @camp.District
                                    </div>
                                    <div class="small text-muted mb-2">
                                        <i class="fa-solid fa-calendar-day text-primary me-1"></i> @camp.StartDate.ToString("MMM dd") – @camp.EndDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                                <div class="mt-2 pt-2 border-top">
                                    @if (isCurrent)
                                    {
                                        <button class="btn btn-primary btn-sm w-100 rounded-pill fw-bold" disabled>
                                            <i class="fa-solid fa-stethoscope me-1"></i> Active Camp Desk
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="Queue" asp-route-activeCampId="@camp.Id"
                                           class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold">
                                            <i class="fa-solid fa-right-to-bracket me-1"></i> Enter Camp Desk
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.ActiveCamp != null)
    {
        <!-- Patient Unique ID Direct Lookup -->
        <div class="glass-card p-4 mb-4 border border-primary border-opacity-25 bg-light-subtle">
            <div class="row align-items-center g-3">
                <div class="col-lg-6">
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-id-card-clip text-primary me-2"></i>Patient Intake by Unique ID
                    </h5>
                    <p class="text-muted small mb-0">Enter the patient's 6-character Unique ID (e.g., <code>A3K9P2</code>) to open their consultation record directly.</p>
                </div>
                <div class="col-lg-6">
                    <form asp-action="ConsultByPatientId" method="get" class="d-flex gap-2">
                        <input type="hidden" name="campId" value="@Model.ActiveCamp.Id" />
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 font-monospace text-muted fw-bold">ID:</span>
                            <input type="text" name="patientQuery" class="form-control font-monospace fw-bold text-uppercase border-start-0" 
                                   placeholder="e.g. A3K9P2" maxlength="15" required style="letter-spacing: 0.1em;" />
                            <button type="submit" class="btn btn-primary px-3 fw-bold">
                                <i class="fa-solid fa-user-doctor me-1"></i> Open Consultation
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Active Camp Queue Desk -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold text-dark mb-0">
                    <i class="fa-solid fa-users-line text-primary me-2"></i>Triage Waiting Queue
                </h4>
                <div class="text-muted small">Showing patients checked in for <strong>@Model.ActiveCamp.Title</strong></div>
            </div>
        </div>

        <!-- Queue Stats -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center">
                    <div class="fw-black fs-2 text-dark">@Model.Queue.Count</div>
                    <div class="text-muted small fw-bold">Waiting</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center">
                    <div class="fw-black fs-2 text-danger">@Model.EmergencyCount</div>
                    <div class="text-muted small fw-bold">Emergency</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center">
                    <div class="fw-black fs-2 text-warning">@Model.UrgentCount</div>
                    <div class="text-muted small fw-bold">Urgent</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center">
                    <div class="fw-black fs-2 text-success">@Model.NormalCount</div>
                    <div class="text-muted small fw-bold">Normal</div>
                </div>
            </div>
        </div>

        @if (!Model.Queue.Any())
        {
            <div class="glass-card text-center py-5">
                <div class="mb-3" style="font-size:3.5rem;">✅</div>
                <h4 class="fw-bold text-success">Queue is Clear!</h4>
                <p class="text-muted">All triaged patients have been seen. Great work!</p>
                <a asp-action="Queue" asp-route-activeCampId="@Model.ActiveCamp.Id"
                   class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                    <i class="fa-solid fa-arrows-rotate me-2"></i> Refresh
                </a>
            </div>
        }
        else
        {
            <div class="glass-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4" style="width:80px">Token</th>
                                <th>Patient</th>
                                <th>Urgency</th>
                                <th>Presenting Symptoms</th>
                                <th>Vitals</th>
                                <th>Triaged At</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Queue)
                            {
                                var urgencyClass = t.UrgencyLevel switch
                                {
                                    "Emergency" => "urgency-emergency",
                                    "Urgent"    => "urgency-urgent",
                                    _           => "urgency-normal"
                                };
                                var badgeClass = t.UrgencyLevel switch
                                {
                                    "Emergency" => "bg-danger",
                                    "Urgent"    => "bg-warning text-dark",
                                    _           => "bg-success"
                                };
                                <tr class="queue-row @urgencyClass">
                                    <td class="ps-4">
                                        <span class="fw-black fs-5 text-primary">#@t.TokenNumber</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark">@t.Patient?.FullName</span>
                                            @if (!string.IsNullOrEmpty(t.Patient?.PatientUniqueId))
                                            {
                                                <span class="badge bg-dark-subtle text-dark font-monospace px-2 py-0 border" style="font-size: 0.75rem;">
                                                    @t.Patient.PatientUniqueId
                                                </span>
                                            }
                                        </div>
                                        <div class="small text-muted">@t.Patient?.Gender &bull; @(t.Patient?.DateOfBirth.HasValue == true ? (DateTime.Today.Year - t.Patient.DateOfBirth!.Value.Year) + " yrs" : "Age N/A") &bull; @(t.Patient?.PhoneNumber ?? "No Phone")</div>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass fw-bold">
                                            @if (t.UrgencyLevel == "Emergency") { <i class="fa-solid fa-triangle-exclamation me-1"></i> }
                                            else if (t.UrgencyLevel == "Urgent") { <i class="fa-solid fa-circle-exclamation me-1"></i> }
                                            @t.UrgencyLevel
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small" style="max-width:220px;">
                                            @(string.IsNullOrWhiteSpace(t.PresentingSymptoms) ? "—" : t.PresentingSymptoms)
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-muted">
                                            @if (t.BloodPressure != null) { <span><i class="fa-solid fa-heart-pulse me-1 text-danger"></i>@t.BloodPressure mmHg<br /></span> }
                                            @if (t.TemperatureF.HasValue) { <span><i class="fa-solid fa-thermometer me-1 text-warning"></i>@t.TemperatureF.Value.ToString("F1")°F<br /></span> }
                                            @if (t.BMI.HasValue) { <span><i class="fa-solid fa-weight-scale me-1 text-info"></i>BMI @t.BMI.Value.ToString("F1")</span> }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-muted">@t.RecordedAt.ToLocalTime().ToString("hh:mm tt")</div>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-action="Consult" asp-route-triageId="@t.Id"
                                           class="btn btn-sm btn-primary rounded-pill fw-bold px-3">
                                            <i class="fa-solid fa-stethoscope me-1"></i> Consult
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
