@model MediCamp.Models.ViewModels.DoctorQueueViewModel
@{
    ViewData["Title"] = "Doctor Portal Dashboard - MediCamp";
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Flash Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Doctor Dashboard Main Container with Rounded Card Frame -->
    <div class="host-layout-card">
        <div class="row g-0">

            <!-- Left Emerald Sidebar (Matching Doctor Navbar Details) -->
            <div class="col-lg-3 col-xl-auto" style="min-width: 250px;">
                <aside class="host-sidebar h-100">
                    <div>
                        <!-- Sidebar Brand / Doctor Info -->
                        <div class="host-sidebar-brand">
                            <div class="host-sidebar-brand-icon" style="background: linear-gradient(135deg, #10b981 0%, #047857 100%);">
                                <i class="fa-solid fa-user-doctor text-white"></i>
                            </div>
                            <div class="d-flex flex-column text-truncate">
                                <span class="fw-bold text-white fs-5 lh-1 text-truncate">Doctor Portal</span>
                                <span class="text-champagne opacity-75 small text-uppercase mt-1" style="font-size: 0.68rem; letter-spacing: 0.06em;">Clinical Practice</span>
                            </div>
                        </div>

                        <!-- Sidebar Navigation Menu (Only Doctor Scope) -->
                        <nav class="d-flex flex-column">
                            <a asp-controller="Doctor" asp-action="Queue" class="host-nav-item active">
                                <i class="fa-solid fa-stethoscope fs-6"></i>
                                <span>Patient Queue</span>
                                @if (Model.Queue.Count > 0)
                                {
                                    <span class="badge bg-emerald rounded-pill ms-auto small fw-bold" style="background: #10b981; color: white; font-size: 0.7rem;">@Model.Queue.Count</span>
                                }
                            </a>
                            <a asp-controller="Doctor" asp-action="Requests" class="host-nav-item">
                                <i class="fa-solid fa-envelope-open-text fs-6"></i>
                                <span>Camp Invitations</span>
                                @if (Model.PendingRequestsCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-auto small fw-bold" style="font-size: 0.7rem;">@Model.PendingRequestsCount</span>
                                }
                            </a>
                        </nav>
                    </div>

                    <!-- Sidebar Bottom: Logout Button in White Rounded Pill -->
                    <div class="pt-4 mt-auto">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="host-logout-btn">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </aside>
            </div>

            <!-- Right Details & Clinical Panel -->
            <div class="col-lg-9 col-xl">
                <main class="host-main-panel h-100">

                    <!-- Top Bar: Search, Quick Action, Alerts, User Avatar -->
                    <div class="host-topbar">
                        <div class="host-search-wrapper">
                            <form method="get" asp-action="ConsultByPatientId" class="m-0 d-flex w-100 align-items-center">
                                @if (Model.ActiveCamp != null)
                                {
                                    <input type="hidden" name="campId" value="@Model.ActiveCamp.Id" />
                                }
                                <i class="fa-solid fa-magnifying-glass host-search-icon"></i>
                                <input type="text" name="patientQuery" class="host-search-input" placeholder="Search patient by Unique ID (e.g. A3K9P2), name, or phone..." />
                            </form>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            @if (Model.ActiveCamp != null)
                            {
                                <a asp-action="Queue" asp-route-activeCampId="@Model.ActiveCamp.Id" class="btn btn-outline-secondary btn-sm fw-bold px-3 py-2 rounded-pill shadow-sm">
                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Queue
                                </a>
                            }

                            <!-- Interactive Notification Bell Dropdown -->
                            <div class="notification-bell-wrapper">
                                <button type="button" class="notification-bell-btn shadow-sm" title="Doctor Notifications & Camp Invitations" aria-label="Notifications">
                                    <i class="fa-regular fa-bell"></i>
                                    <span class="notification-badge-pulse" style="display: none;">0</span>
                                </button>

                                <!-- Dropdown Panel -->
                                <div class="notification-dropdown-panel shadow-lg">
                                    <div class="notification-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-bell text-champagne"></i>
                                            <span class="fw-bold">Clinical Notifications</span>
                                        </div>
                                        <span class="badge bg-white text-dark rounded-pill small" style="font-size: 0.72rem;">Live Queue</span>
                                    </div>
                                    <ul class="notification-list">
                                        <li class="text-center py-4 text-muted">
                                            <span class="spinner-border spinner-border-sm text-secondary"></span> Loading...
                                        </li>
                                    </ul>
                                    <div class="notification-footer">
                                        <a asp-controller="Doctor" asp-action="Requests" class="text-decoration-none fw-bold text-success small">
                                            <i class="fa-solid fa-envelope-open-text me-1"></i> View Invitations
                                        </a>
                                        <span class="text-muted small">Auto-syncing</span>
                                    </div>
                                </div>
                            </div>

                            <!-- User Avatar Initials Capsule -->
                            <div class="d-flex align-items-center gap-2 bg-white px-3 py-1 rounded-pill border shadow-sm">
                                <div class="avatar-initials rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem; background: #064e3b; color: #f8e7c9;">
                                    @((Model.DoctorUser?.FullName ?? "Doctor")[0])
                                </div>
                                <div class="d-flex flex-column text-start">
                                    <span class="fw-bold lh-1 text-dark" style="font-size: 0.84rem;">Dr. @(Model.DoctorUser?.FullName ?? "Physician")</span>
                                    <span class="text-muted" style="font-size: 0.68rem;">@(Model.DoctorUser?.MedicalSpecialization ?? "Clinical Doctor")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content Body -->
                    <div class="p-3 p-lg-4">

                        <!-- Welcome Header -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge px-3 py-1 fw-bold text-uppercase" style="background: rgba(16, 185, 129, 0.15); color: #047857; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.72rem; letter-spacing: 0.05em;">
                                        <i class="fa-solid fa-stethoscope me-1"></i> Clinical Consultation Desk
                                    </span>
                                </div>
                                <h3 class="fw-bold text-dark mb-1">Doctor Operations Dashboard</h3>
                                <p class="text-muted small mb-0">Review triaged patient queue, examine vitals, and issue digital prescriptions.</p>
                            </div>

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <a asp-action="Requests" class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3 py-2 shadow-sm">
                                    <i class="fa-solid fa-envelope-open-text me-1 text-danger"></i> Camp Invitations
                                    @if (Model.PendingRequestsCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill ms-1">@Model.PendingRequestsCount</span>
                                    }
                                </a>
                                @if (Model.ActiveCamp != null)
                                {
                                    <a asp-action="Queue" asp-route-activeCampId="@Model.ActiveCamp.Id" class="btn btn-emerald-solid btn-sm rounded-pill fw-bold px-3 py-2 text-white shadow-sm">
                                        <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Queue
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- 4 Stat Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-green">
                                        <i class="fa-solid fa-users-line"></i>
                                    </div>
                                    <div class="metric-card-value">@Model.Queue.Count</div>
                                    <div class="metric-card-label">Waiting in Queue</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-red">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div class="metric-card-value text-danger">@Model.EmergencyCount</div>
                                    <div class="metric-card-label">Emergency Cases</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-champagne">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                    </div>
                                    <div class="metric-card-value text-warning">@Model.UrgentCount</div>
                                    <div class="metric-card-label">Urgent Priority</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="metric-card">
                                    <div class="metric-card-icon metric-icon-blue">
                                        <i class="fa-solid fa-envelope-open-text"></i>
                                    </div>
                                    <div class="metric-card-value">@Model.PendingRequestsCount</div>
                                    <div class="metric-card-label">Camp Invitations</div>
                                </div>
                            </div>
                        </div>

                        <!-- Active Camp Station Selection -->
                        <div class="glass-card mb-4 overflow-hidden border-0 shadow-sm" style="border-radius: 20px;">
                            <div class="glass-card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 px-4 bg-white border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(16, 185, 129, 0.15); color: #047857;">
                                        <i class="fa-solid fa-tent-arrows-down"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0 text-dark">Active Field Camp Selection</h5>
                                        <span class="text-muted small">Select the healthcare camp where you are currently conducting consultations</span>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold small">
                                    @Model.OngoingCamps.Count Camp@(Model.OngoingCamps.Count != 1 ? "s" : "") Available
                                </span>
                            </div>

                            <div class="glass-card-body p-3 p-lg-4 bg-light-subtle">
                                @if (!Model.OngoingCamps.Any())
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="fa-solid fa-tent-slash fs-1 mb-2 opacity-50"></i>
                                        <h6 class="fw-bold text-secondary">No active healthcare camps available today.</h6>
                                        <p class="small text-muted mb-0">Check back when camps are scheduled or review your pending camp invitations.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        @foreach (var camp in Model.OngoingCamps)
                                        {
                                            bool isCurrent = Model.ActiveCamp?.Id == camp.Id;
                                            <div class="col-md-6 col-xl-4">
                                                <div class="card h-100 rounded-4 border-2 @(isCurrent ? "border-success bg-white shadow" : "border-light-subtle bg-white shadow-none") transition-all">
                                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                                        <div>
                                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                                <span class="badge @(isCurrent ? "bg-success" : "bg-secondary-subtle text-dark") rounded-pill px-2 py-1 small">
                                                                    <i class="fa-solid fa-circle-play me-1"></i> @(isCurrent ? "Active Camp Desk" : "Active Camp")
                                                                </span>
                                                                <span class="badge bg-dark-subtle text-dark rounded-pill small font-monospace">
                                                                    <i class="fa-solid fa-users me-1"></i> @camp.ServedPatientsCount Served
                                                                </span>
                                                            </div>
                                                            <h6 class="fw-bold text-dark mb-1 text-truncate" title="@camp.Title">@camp.Title</h6>
                                                            <div class="small text-muted mb-1 text-truncate">
                                                                <i class="fa-solid fa-location-dot text-danger me-1"></i> @camp.Venue, @camp.Upazila, @camp.District
                                                            </div>
                                                            <div class="small text-muted mb-2">
                                                                <i class="fa-solid fa-calendar-day text-primary me-1"></i> @camp.StartDate.ToString("MMM dd") – @camp.EndDate.ToString("MMM dd, yyyy")
                                                            </div>
                                                        </div>
                                                        <div class="mt-2 pt-2 border-top">
                                                            @if (isCurrent)
                                                            {
                                                                <button class="btn btn-success btn-sm w-100 rounded-pill fw-bold text-white shadow-sm" disabled>
                                                                    <i class="fa-solid fa-circle-check me-1"></i> Currently Consulting
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <a asp-action="Queue" asp-route-activeCampId="@camp.Id"
                                                                   class="btn btn-outline-dark btn-sm w-100 rounded-pill fw-bold">
                                                                    <i class="fa-solid fa-right-to-bracket me-1"></i> Enter Camp Desk
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Active Operations Workspace -->
                        @if (Model.ActiveCamp != null)
                        {
                            <!-- Direct Patient Unique ID Intake Bar (Structured, High-Contrast & Comfortable) -->
                            <div class="glass-card mb-4 border-0 shadow-sm overflow-hidden" style="border-radius: 20px; background: #ffffff; border: 1.5px solid rgba(16, 185, 129, 0.3) !important;">
                                <div class="p-3 p-lg-4">
                                    <div class="row align-items-center g-3">
                                        <div class="col-lg-6">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <span class="badge bg-success text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.72rem; letter-spacing: 0.04em;">DIRECT CONSULTATION</span>
                                                <span class="small fw-bold text-dark"><i class="fa-solid fa-tent text-success me-1"></i> @Model.ActiveCamp.Title</span>
                                            </div>
                                            <h4 class="fw-bold text-dark mb-1">
                                                Patient Intake by Unique ID
                                            </h4>
                                            <p class="text-muted small mb-0">Enter the patient's 6-character Unique ID (e.g., <code>A3K9P2</code>) to open their consultation record directly.</p>
                                        </div>
                                        <div class="col-lg-6">
                                            <form asp-action="ConsultByPatientId" method="get" class="m-0">
                                                <input type="hidden" name="campId" value="@Model.ActiveCamp.Id" />
                                                <div class="input-group shadow-sm rounded-pill overflow-hidden border border-success-subtle">
                                                    <span class="input-group-text bg-light border-0 px-3 font-monospace text-muted fw-bold">
                                                        <i class="fa-solid fa-id-card text-success me-1"></i> ID:
                                                    </span>
                                                    <input type="text" name="patientQuery" class="form-control border-0 font-monospace fw-bold text-uppercase px-2" 
                                                           placeholder="e.g. A3K9P2" maxlength="15" required style="letter-spacing: 0.12em; font-size: 1.1rem;" />
                                                    <button type="submit" class="btn btn-emerald-solid px-4 fw-bold text-white border-0">
                                                        <i class="fa-solid fa-stethoscope me-1"></i> Open Record
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Triage Waiting Queue Section -->
                            <div class="glass-card border-0 shadow-sm overflow-hidden mb-4" style="border-radius: 20px;">
                                <div class="glass-card-header d-flex justify-content-between align-items-center py-3 px-4 bg-white border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(16, 185, 129, 0.15); color: #047857;">
                                            <i class="fa-solid fa-users-line"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">Triage Waiting Queue</h5>
                                            <span class="text-muted small">Checked-in patients waiting for consultation at @Model.ActiveCamp.Title</span>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark rounded-pill px-3 py-1 font-monospace">@Model.Queue.Count In Line</span>
                                    </div>
                                </div>

                                <div class="glass-card-body p-0">
                                    @if (!Model.Queue.Any())
                                    {
                                        <div class="text-center py-5">
                                            <div class="mb-3 text-success fs-1">
                                                <i class="fa-solid fa-circle-check"></i>
                                            </div>
                                            <h5 class="fw-bold text-dark">Queue is Clear!</h5>
                                            <p class="text-muted small mb-3">All triaged patients have been consulted. Great work!</p>
                                            <a asp-action="Queue" asp-route-activeCampId="@Model.ActiveCamp.Id" class="btn btn-outline-success btn-sm rounded-pill px-4 fw-bold">
                                                <i class="fa-solid fa-arrows-rotate me-1"></i> Check for Updates
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-4 py-3" style="width: 90px;">Token</th>
                                                        <th class="py-3">Patient Info</th>
                                                        <th class="py-3">Urgency</th>
                                                        <th class="py-3">Symptoms</th>
                                                        <th class="py-3">Vital Signs</th>
                                                        <th class="py-3">Intake Time</th>
                                                        <th class="pe-4 text-end py-3">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var t in Model.Queue)
                                                    {
                                                        var badgeClass = t.UrgencyLevel switch
                                                        {
                                                            "Emergency" => "bg-danger text-white",
                                                            "Urgent"    => "bg-warning text-dark",
                                                            _           => "bg-success text-white"
                                                        };

                                                        <tr>
                                                            <td class="ps-4 py-3">
                                                                <span class="badge bg-dark rounded-pill font-monospace px-2 py-1 fs-6">
                                                                    #@t.TokenNumber
                                                                </span>
                                                            </td>
                                                            <td class="py-3">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <span class="fw-bold text-dark">@t.Patient?.FullName</span>
                                                                    @if (!string.IsNullOrEmpty(t.Patient?.PatientUniqueId))
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success font-monospace px-2 py-1 border border-success-subtle" style="font-size: 0.78rem;">
                                                                            @t.Patient.PatientUniqueId
                                                                        </span>
                                                                    }
                                                                </div>
                                                                <div class="small text-muted mt-1">
                                                                    <span>@t.Patient?.Gender</span> &bull; 
                                                                    <span>@(t.Patient?.DateOfBirth.HasValue == true ? (DateTime.Today.Year - t.Patient.DateOfBirth!.Value.Year) + " yrs" : "Age N/A")</span> &bull;
                                                                    <span><i class="fa-solid fa-phone text-muted me-1 small"></i>@(t.Patient?.PhoneNumber ?? "No Phone")</span>
                                                                </div>
                                                            </td>
                                                            <td class="py-3">
                                                                <span class="badge @badgeClass rounded-pill px-3 py-1 fw-bold small">
                                                                    @if (t.UrgencyLevel == "Emergency") { <i class="fa-solid fa-triangle-exclamation me-1"></i> }
                                                                    else if (t.UrgencyLevel == "Urgent") { <i class="fa-solid fa-circle-exclamation me-1"></i> }
                                                                    @t.UrgencyLevel
                                                                </span>
                                                            </td>
                                                            <td class="py-3">
                                                                <div class="small text-dark" style="max-width: 220px;">
                                                                    @(string.IsNullOrWhiteSpace(t.PresentingSymptoms) ? "General checkup" : t.PresentingSymptoms)
                                                                </div>
                                                            </td>
                                                            <td class="py-3">
                                                                <div class="small">
                                                                    <span class="fw-semibold text-dark">BP:</span> <span class="badge bg-light text-dark border">@(t.BloodPressure ?? "--/--")</span> &bull;
                                                                    <span class="fw-semibold text-dark">Temp:</span> <span class="badge bg-light text-dark border">@(t.TemperatureF.HasValue ? t.TemperatureF.Value.ToString("F1") + "°F" : "--")</span> &bull;
                                                                    <span class="fw-semibold text-dark">BMI:</span> <span class="badge bg-light text-dark border">@(t.BMI.HasValue ? t.BMI.Value.ToString("F1") : "--")</span>
                                                                </div>
                                                            </td>
                                                            <td class="py-3">
                                                                <span class="small text-muted fw-semibold">@t.RecordedAt.ToLocalTime().ToString("hh:mm tt")</span>
                                                            </td>
                                                            <td class="pe-4 text-end py-3">
                                                                <a asp-action="Consult" asp-route-triageId="@t.Id"
                                                                   class="btn btn-sm btn-emerald-solid rounded-pill fw-bold text-white px-3 py-1 shadow-sm">
                                                                    <i class="fa-solid fa-stethoscope me-1"></i> Consult Patient
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                </main>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.08)!important;
    }
    .btn-emerald-solid {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        border: none;
        transition: all 0.2s ease;
    }
    .btn-emerald-solid:hover {
        background: linear-gradient(135deg, #047857 0%, #059669 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }
</style>
