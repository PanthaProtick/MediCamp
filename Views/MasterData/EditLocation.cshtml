@model MediCamp.Models.Domain.Location
@{ ViewData["Title"] = "Edit Location"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4">
                    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-pen me-2"></i>Edit Location</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="EditLocation" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Division" class="form-label fw-bold"></label>
                            <input asp-for="Division" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="District" class="form-label fw-bold"></label>
                            <input asp-for="District" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Upazila" class="form-label fw-bold"></label>
                            <input asp-for="Upazila" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Union" class="form-label fw-bold"></label>
                            <input asp-for="Union" class="form-control" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Village" class="form-label fw-bold"></label>
                            <input asp-for="Village" class="form-control" />
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Locations" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-champagne rounded-pill px-4 fw-bold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
