@model IEnumerable<MediCamp.Models.Domain.Location>
@{ ViewData["Title"] = "Location Management"; }

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Location Management</h2>
        <a asp-action="CreateLocation" class="btn btn-champagne rounded-pill px-4 fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Add Location
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Division</th>
                        <th>District</th>
                        <th>Upazila</th>
                        <th>Union</th>
                        <th>Village</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">@item.Division</td>
                            <td>@item.District</td>
                            <td>@item.Upazila</td>
                            <td>@(item.Union ?? "-")</td>
                            <td>@(item.Village ?? "-")</td>
                            <td class="text-end pe-4">
                                <a asp-action="EditLocation" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Edit</a>
                                <form asp-action="DeleteLocation" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this location?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()) {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No locations found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
