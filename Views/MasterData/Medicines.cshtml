@model IEnumerable<MediCamp.Models.Domain.MasterMedicine>
@{ ViewData["Title"] = "Master Medicine List"; }

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-pills text-primary me-2"></i>Master Medicine List</h2>
        <a asp-action="CreateMedicine" class="btn btn-champagne rounded-pill px-4 fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Add Medicine
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Brand Name</th>
                        <th>Generic Name</th>
                        <th>Form</th>
                        <th>Strength</th>
                        <th>Category</th>
                        <th>Essential?</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-primary">@item.BrandName</td>
                            <td class="text-muted">@item.GenericName</td>
                            <td>@item.DosageForm</td>
                            <td>@item.Strength</td>
                            <td>@item.Category</td>
                            <td>
                                @if (item.IsEssential) { <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Yes</span> }
                                else { <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">No</span> }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditMedicine" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Edit</a>
                                <form asp-action="DeleteMedicine" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this medicine?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()) {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No medicines found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
