@model MediCamp.Models.ViewModels.PharmacistInventoryViewModel

@{
    ViewData["Title"] = "Camp Inventory";
}

<style>
    .inv-progress {
        height: 8px;
        border-radius: 10px;
        overflow: hidden;
        background: #e9ecef;
    }
    .inv-progress-fill { height: 100%; border-radius: 10px; transition: width .4s; }
    .low-stock-row  { background: #fffbf0; }
    .out-stock-row  { background: #fff5f5; }
    .filter-btn.active { background: #6610f2 !important; color: #fff !important; border-color: #6610f2 !important; }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background:#6610f2;"><i class="fa-solid fa-boxes-stacked"></i> Pharmacist</span>
                <span class="text-muted small">@Model.Camp.Title</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Camp Inventory</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" asp-route-activeCampId="@Model.Camp.Id"
               class="btn btn-light shadow-sm fw-bold rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-2"></i> Dashboard
            </a>
            <a asp-action="PrescriptionQueue" asp-route-campId="@Model.Camp.Id"
               class="btn btn-outline-primary rounded-pill fw-bold btn-sm px-3">
                <i class="fa-solid fa-receipt me-1"></i> Rx Queue
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center">
                <div class="fw-black fs-2 text-primary">@Model.TotalItems</div>
                <div class="text-muted small fw-bold">Medicine Types</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center">
                <div class="fw-black fs-2 text-success">@Model.Inventory.Count(i => !i.IsLowStock && !i.IsOutOfStock)</div>
                <div class="text-muted small fw-bold">Adequate Stock</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center">
                <div class="fw-black fs-2 text-warning">@Model.LowStockCount</div>
                <div class="text-muted small fw-bold">Low Stock</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center">
                <div class="fw-black fs-2 text-danger">@Model.OutOfStockCount</div>
                <div class="text-muted small fw-bold">Out of Stock</div>
            </div>
        </div>
    </div>

    <!-- Alerts Banner -->
    @if (Model.LowStockCount > 0 || Model.OutOfStockCount > 0)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-3">
            <i class="fa-solid fa-triangle-exclamation fs-4 text-warning flex-shrink-0"></i>
            <div>
                <strong>Stock Alert:</strong>
                @if (Model.OutOfStockCount > 0) { <span>@Model.OutOfStockCount item(s) are <strong>out of stock</strong>. </span> }
                @if (Model.LowStockCount > 0)   { <span>@Model.LowStockCount item(s) are <strong>running low</strong>.</span> }
                Use the restock button to request more from the Host.
            </div>
        </div>
    }

    <!-- Filter -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary rounded-pill fw-bold filter-btn active" data-filter="all">All</button>
        <button class="btn btn-sm btn-outline-warning rounded-pill fw-bold filter-btn"  data-filter="low">Low Stock</button>
        <button class="btn btn-sm btn-outline-danger  rounded-pill fw-bold filter-btn"  data-filter="out">Out of Stock</button>
    </div>

    <!-- Inventory Table -->
    @if (!Model.Inventory.Any())
    {
        <div class="glass-card text-center py-5">
            <i class="fa-solid fa-box-open text-muted fs-1 mb-3 opacity-50"></i>
            <h5 class="fw-bold text-secondary">No Inventory Allocated</h5>
            <p class="text-muted small">The host has not allocated any medicines to this camp yet.</p>
        </div>
    }
    else
    {
        <div class="glass-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="inventoryTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Medicine</th>
                            <th>Category</th>
                            <th>Form / Strength</th>
                            <th>Allocated</th>
                            <th>Dispensed</th>
                            <th>Remaining</th>
                            <th style="min-width:150px;">Stock Level</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Inventory)
                        {
                            string rowClass = item.IsOutOfStock ? "out-stock-row" : (item.IsLowStock ? "low-stock-row" : "");
                            string filterAttr = item.IsOutOfStock ? "out" : (item.IsLowStock ? "low" : "ok");
                            string barColor = item.IsOutOfStock ? "#dc3545" : (item.IsLowStock ? "#ffc107" : "#198754");
                            <tr class="@rowClass" data-stock-status="@filterAttr">
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.BrandName</div>
                                    <div class="small text-muted">@item.GenericName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Category</span>
                                </td>
                                <td>
                                    <div class="small">@item.DosageForm</div>
                                    <div class="small text-muted">@item.Strength</div>
                                </td>
                                <td><span class="fw-bold">@item.Allocated</span></td>
                                <td><span class="text-muted">@item.Dispensed</span></td>
                                <td>
                                    @if (item.IsOutOfStock)
                                    {
                                        <span class="badge bg-danger fw-bold">0</span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark fw-bold">@item.Remaining</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-success">@item.Remaining</span>
                                    }
                                </td>
                                <td>
                                    <div class="inv-progress">
                                        <div class="inv-progress-fill"
                                             style="width:@item.StockPercentage.ToString("F0")%;background:@barColor;"></div>
                                    </div>
                                    <div class="text-muted" style="font-size:.7rem;">@item.StockPercentage.ToString("F0")%</div>
                                </td>
                                <td class="pe-4 text-end">
                                    @if (item.IsLowStock || item.IsOutOfStock)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning fw-bold rounded-pill"
                                                data-bs-toggle="modal"
                                                data-bs-target="#restockModal"
                                                data-medicine-id="@item.MasterMedicineId"
                                                data-medicine-name="@item.BrandName"
                                                data-camp-id="@Model.Camp.Id">
                                            <i class="fa-solid fa-truck me-1"></i> Restock
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-success small fw-bold"><i class="fa-solid fa-circle-check me-1"></i>OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Restock Modal -->
<div class="modal fade" id="restockModal" tabindex="-1" aria-labelledby="restockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="restockModalLabel">
                    <i class="fa-solid fa-truck text-warning me-2"></i>Request Restock
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RequestRestock" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="campId" value="@Model.Camp.Id" />
                    <input type="hidden" name="medicineId" id="restockMedicineId" />

                    <p class="text-muted small mb-3">
                        A restock request will be sent to the Host organiser for:
                        <strong id="restockMedicineName" class="text-dark"></strong>
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Quantity Requested</label>
                        <input type="number" name="requestedQty" class="form-control shadow-none bg-light"
                               min="1" value="100" required />
                        <div class="form-text">Enter how many units you need.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn fw-bold rounded-pill px-4 text-white" style="background:#6610f2;">
                        <i class="fa-solid fa-paper-plane me-2"></i> Send Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Restock modal: populate medicine id/name
        document.getElementById('restockModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('restockMedicineId').value = btn.dataset.medicineId;
            document.getElementById('restockMedicineName').textContent = btn.dataset.medicineName;
        });

        // Filter buttons
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.dataset.filter;
                document.querySelectorAll('#inventoryTable tbody tr').forEach(row => {
                    const status = row.dataset.stockStatus;
                    if (filter === 'all') {
                        row.style.display = '';
                    } else if (filter === 'low') {
                        row.style.display = (status === 'low') ? '' : 'none';
                    } else if (filter === 'out') {
                        row.style.display = (status === 'out') ? '' : 'none';
                    }
                });
            });
        });
    </script>
}
