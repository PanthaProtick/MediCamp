@model MediCamp.Models.ViewModels.PatientProfileHistoryViewModel

@{
    ViewData["Title"] = "My Medical History — MediCamp";
}

<style>
    .timeline-container {
        position: relative;
        padding-left: 2.5rem;
    }
    .timeline-container::before {
        content: '';
        position: absolute;
        left: 14px;
        top: 10px;
        bottom: 10px;
        width: 3px;
        background: linear-gradient(180deg, #0d6efd 0%, #6610f2 50%, #20c997 100%);
        border-radius: 4px;
    }
    .timeline-node {
        position: relative;
        margin-bottom: 2.5rem;
    }
    .timeline-dot {
        position: absolute;
        left: -2.5rem;
        top: 20px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        border: 4px solid #fff;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
    }
    .vital-pill {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 0.5rem 0.9rem;
        text-align: center;
        min-width: 90px;
    }
    .vital-pill .val {
        font-weight: 800;
        color: #212529;
        font-size: 1.05rem;
    }
    .vital-pill .lbl {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.05em;
    }
</style>

<div class="container py-4">

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Profile Header Card -->
    <div class="glass-card p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow"
                     style="width: 64px; height: 64px; font-size: 1.6rem;">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h3 class="fw-black text-dark mb-0">@Model.Patient.FullName</h3>
                        <span class="badge bg-danger rounded-pill px-3 py-1">
                            <i class="fa-solid fa-droplet me-1"></i> @(Model.Patient.BloodGroup ?? "Unknown")
                        </span>
                    </div>
                    <div class="text-secondary small d-flex flex-wrap gap-3">
                        <span><i class="fa-solid fa-phone me-1 text-primary"></i> @Model.Patient.PhoneNumber</span>
                        <span><i class="fa-solid fa-envelope me-1 text-primary"></i> @Model.Patient.Email</span>
                        <span><i class="fa-solid fa-location-dot me-1 text-danger"></i> @Model.Patient.Upazila, @Model.Patient.District</span>
                        @if (Model.Patient.Age.HasValue)
                        {
                            <span><i class="fa-solid fa-cake-candles me-1 text-warning"></i> @Model.Patient.Age yrs (@Model.Patient.Gender)</span>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Patient" asp-action="BloodDonation" class="btn btn-outline-danger rounded-pill fw-bold px-3">
                    <i class="fa-solid fa-heart-pulse me-1"></i> Blood Donation Hub
                </a>
                <a asp-controller="Home" asp-action="Camps" class="btn btn-sapphire rounded-pill px-4">
                    <i class="fa-solid fa-tent me-1"></i> Find Medical Camps
                </a>
            </div>
        </div>

        <!-- Quick Summary Bar -->
        <div class="row g-3 mt-3 pt-3 border-top">
            <div class="col-6 col-md-3">
                <div class="p-2 text-center rounded bg-light border">
                    <div class="fw-black fs-4 text-primary">@Model.TotalVisitsCount</div>
                    <div class="text-muted small fw-bold">Camp Consultations</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 text-center rounded bg-light border">
                    <div class="fw-black fs-4 text-success">@Model.TotalPrescriptionsCount</div>
                    <div class="text-muted small fw-bold">Digital Prescriptions</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 text-center rounded bg-light border">
                    <div class="fw-black fs-4 text-danger">@(Model.BloodProfile?.TotalDonationsCount ?? 0)</div>
                    <div class="text-muted small fw-bold">Blood Donations</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 text-center rounded bg-light border">
                    <div class="fw-black fs-5 text-dark mt-1">
                        @if (Model.BloodProfile?.IsAvailableDonor == true)
                        {
                            <span class="badge bg-success rounded-pill px-2">Active Donor</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-2">Inactive</span>
                        }
                    </div>
                    <div class="text-muted small fw-bold">Donor Status</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-notes-medical text-primary me-2"></i>Longitudinal Medical History
            </h4>
            <p class="text-muted small mb-0">Chronological timeline of all your visits, diagnoses, and digital prescriptions.</p>
        </div>
    </div>

    <!-- Visits Timeline -->
    @if (!Model.Visits.Any())
    {
        <div class="glass-card text-center py-5">
            <i class="fa-solid fa-folder-open text-muted fs-1 mb-3 opacity-50"></i>
            <h5 class="fw-bold text-secondary">No Consultation Records Yet</h5>
            <p class="text-muted small mb-3">You have not attended any MediCamp outreach consultations yet.</p>
            <a asp-controller="Home" asp-action="Camps" class="btn btn-sapphire rounded-pill px-4">
                <i class="fa-solid fa-tent me-1"></i> Browse Upcoming Camps
            </a>
        </div>
    }
    else
    {
        <div class="timeline-container">
            @foreach (var visit in Model.Visits)
            {
                <div class="timeline-node">
                    <div class="timeline-dot">
                        <i class="fa-solid fa-stethoscope"></i>
                    </div>

                    <div class="glass-card p-4">
                        <!-- Camp Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-primary rounded-pill">Token #@visit.TokenNumber</span>
                                    <span class="badge @(visit.UrgencyLevel == "Emergency" ? "bg-danger" : (visit.UrgencyLevel == "Urgent" ? "bg-warning text-dark" : "bg-success")) rounded-pill">
                                        @visit.UrgencyLevel Urgency
                                    </span>
                                    <span class="text-muted small">
                                        <i class="fa-solid fa-calendar me-1"></i> @visit.VisitDate.ToString("dd MMMM yyyy, hh:mm tt")
                                    </span>
                                </div>
                                <h5 class="fw-bold text-dark mb-0">@visit.CampTitle</h5>
                                <div class="text-muted small">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i> @visit.Location — @visit.Venue
                                </div>
                            </div>

                            @if (visit.PrescriptionId.HasValue)
                            {
                                <a asp-action="DigitalPrescription" asp-route-id="@visit.PrescriptionId.Value"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary rounded-pill fw-bold shadow-sm">
                                    <i class="fa-solid fa-print me-1"></i> View Digital Rx
                                </a>
                            }
                        </div>

                        <!-- Vitals Grid -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrWhiteSpace(visit.BloodPressure))
                            {
                                <div class="vital-pill">
                                    <div class="lbl">Blood Pressure</div>
                                    <div class="val text-danger">@visit.BloodPressure</div>
                                </div>
                            }
                            @if (visit.TemperatureF.HasValue)
                            {
                                <div class="vital-pill">
                                    <div class="lbl">Temp (°F)</div>
                                    <div class="val text-warning">@visit.TemperatureF.Value.ToString("F1")°</div>
                                </div>
                            }
                            @if (visit.WeightKg.HasValue)
                            {
                                <div class="vital-pill">
                                    <div class="lbl">Weight</div>
                                    <div class="val">@visit.WeightKg.Value.ToString("F1") kg</div>
                                </div>
                            }
                            @if (visit.HeightCm.HasValue)
                            {
                                <div class="vital-pill">
                                    <div class="lbl">Height</div>
                                    <div class="val">@visit.HeightCm.Value.ToString("F0") cm</div>
                                </div>
                            }
                            @if (visit.BMI.HasValue)
                            {
                                <div class="vital-pill">
                                    <div class="lbl">BMI</div>
                                    <div class="val text-info">@visit.BMI.Value.ToString("F1")</div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(visit.PresentingSymptoms))
                        {
                            <div class="mb-3 bg-light p-2 rounded small">
                                <strong><i class="fa-solid fa-notes-medical text-primary me-1"></i> Presenting Symptoms:</strong>
                                @visit.PresentingSymptoms
                            </div>
                        }

                        <!-- Doctor Consultation & Diagnosis -->
                        @if (!string.IsNullOrWhiteSpace(visit.Diagnosis) || !string.IsNullOrWhiteSpace(visit.DoctorName))
                        {
                            <div class="border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fa-solid fa-user-doctor text-primary me-1"></i> Consultation by @(visit.DoctorName ?? "Medical Doctor")
                                    </h6>
                                    @if (visit.ConsultedAt.HasValue)
                                    {
                                        <span class="small text-muted">@visit.ConsultedAt.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(visit.Diagnosis))
                                {
                                    <div class="p-2 mb-2 rounded bg-white border border-primary-subtle">
                                        <span class="badge bg-primary-subtle text-primary fw-bold mb-1">Diagnosis</span>
                                        <div class="fw-bold text-dark">@visit.Diagnosis</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(visit.Advice))
                                {
                                    <div class="small text-secondary mb-2">
                                        <strong>Advice:</strong> @visit.Advice
                                    </div>
                                }
                            </div>
                        }

                        <!-- Prescribed Medicines -->
                        @if (visit.PrescriptionItems.Any())
                        {
                            <div class="border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fa-solid fa-pills text-success me-1"></i> Prescribed Medicines
                                    </h6>
                                    @if (visit.IsPrescriptionDispensed)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check-double me-1"></i>Dispensed at Camp Pharmacy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Dispensing Pending</span>
                                    }
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered bg-white small mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Medicine</th>
                                                <th>Dosage</th>
                                                <th>Duration</th>
                                                <th>Instructions</th>
                                                <th class="text-center">Dispensed</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var med in visit.PrescriptionItems)
                                            {
                                                <tr>
                                                    <td class="fw-bold text-dark">@med.MedicineName</td>
                                                    <td><span class="badge bg-light text-dark border">@med.Dosage</span></td>
                                                    <td>@med.DurationDays day(s)</td>
                                                    <td>@(string.IsNullOrWhiteSpace(med.Instructions) ? "—" : med.Instructions)</td>
                                                    <td class="text-center">
                                                        @if (med.QuantityDispensed > 0)
                                                        {
                                                            <span class="text-success fw-bold">@med.QuantityDispensed / @med.QuantityPrescribed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">@med.QuantityPrescribed</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        <!-- Referral & Follow-up Badges -->
                        @if (!string.IsNullOrWhiteSpace(visit.ReferredHospital) || !string.IsNullOrWhiteSpace(visit.FollowUpReason))
                        {
                            <div class="border-top pt-3 mt-3 d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(visit.ReferredHospital))
                                {
                                    <div class="alert alert-danger mb-0 py-2 px-3 small d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-hospital fs-5"></i>
                                        <div>
                                            <strong>Hospital Referral (@visit.ReferralUrgency):</strong> @visit.ReferredHospital
                                            @if (!string.IsNullOrWhiteSpace(visit.ReferralReason))
                                            {
                                                <div class="text-muted">Reason: @visit.ReferralReason</div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(visit.FollowUpReason))
                                {
                                    <div class="alert alert-info mb-0 py-2 px-3 small d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-headset fs-5"></i>
                                        <div>
                                            <strong>Follow-up Scheduled:</strong> @(visit.FollowUpScheduledDate?.ToString("MMM dd, yyyy") ?? "Soon")
                                            <span class="badge bg-info text-white ms-1">@visit.FollowUpStatus</span>
                                            <div class="text-muted">@visit.FollowUpReason</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
