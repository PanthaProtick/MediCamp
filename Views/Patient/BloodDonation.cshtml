@model MediCamp.Models.ViewModels.BloodDonationHubViewModel
@{
    ViewData["Title"] = "Patient Portal - Blood Donation Hub";
    Layout = "_Layout";
}

<style>
    .patient-blood-badge {
        width: 44px;
        height: 44px;
        background: #dc2626;
        color: #ffffff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.05rem;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
        flex-shrink: 0;
    }
    .patient-donor-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.25rem;
        transition: all 0.2s ease;
    }
    .patient-donor-card:hover {
        border-color: #dc2626;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(220, 38, 38, 0.1);
    }
    .patient-summary-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.25rem;
        transition: all 0.2s ease;
    }
    .patient-summary-box:hover {
        border-color: #10b981;
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.08);
    }
    .req-item-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 1.1rem;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }
    .req-item-card.critical {
        border-left: 4px solid #dc2626;
        background: #fef2f2;
    }
    .req-item-card.urgent {
        border-left: 4px solid #f59e0b;
        background: #fffbeb;
    }
    .req-item-card.normal {
        border-left: 4px solid #0284c7;
        background: #f0f9ff;
    }
</style>

<div class="container-fluid px-lg-4 py-4">


    <!-- Patient Dashboard Main Container with Rounded Card Frame -->
    <div class="host-layout-card">
        <div class="row g-0">

            <!-- Left Emerald Sidebar (Matching Patient Navbar Details) -->
            <div class="col-lg-3 col-xl-auto" style="min-width: 250px;">
                <aside class="host-sidebar h-100">
                    <div>
                        <!-- Sidebar Brand / Patient Info -->
                        <div class="host-sidebar-brand">
                            <div class="host-sidebar-brand-icon" style="background: linear-gradient(135deg, #10b981 0%, #047857 100%);">
                                <i class="fa-solid fa-hospital-user text-white"></i>
                            </div>
                            <div class="d-flex flex-column text-truncate">
                                <span class="fw-bold text-white fs-5 lh-1 text-truncate">Patient Portal</span>
                                <span class="text-champagne opacity-75 small text-uppercase mt-1" style="font-size: 0.68rem; letter-spacing: 0.06em;">Health Records</span>
                            </div>
                        </div>

                        <!-- Sidebar Navigation Menu (Only Patient Scope) -->
                        <nav class="d-flex flex-column">
                            <a asp-controller="Patient" asp-action="History" class="host-nav-item">
                                <i class="fa-solid fa-notes-medical fs-6"></i>
                                <span>My Medical History</span>
                            </a>
                            <a asp-controller="Patient" asp-action="BloodDonation" class="host-nav-item active">
                                <i class="fa-solid fa-droplet fs-6"></i>
                                <span>Blood Donation Hub</span>
                                @if (Model.OpenRequests.Count > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-auto small fw-bold" style="font-size: 0.7rem;">@Model.OpenRequests.Count</span>
                                }
                            </a>
                        </nav>
                    </div>

                    <!-- Sidebar Bottom: Logout Button in White Rounded Pill -->
                    <div class="pt-4 mt-auto">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="host-logout-btn">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </aside>
            </div>

            <!-- Right Details & Operations Panel -->
            <div class="col-lg-9 col-xl">
                <main class="host-main-panel h-100">

                    <!-- Top Bar: Modern, Aligned, Structured -->
                    <div class="patient-topbar">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-danger btn-sm rounded-pill fw-bold px-3 py-2 shadow-sm"
                                    data-bs-toggle="modal" data-bs-target="#requestBloodModal">
                                <i class="fa-solid fa-hand-holding-droplet me-1"></i> Request Blood
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-2"
                                    data-bs-toggle="modal" data-bs-target="#logDonationModal">
                                <i class="fa-solid fa-plus me-1"></i> Log Donation
                            </button>
                        </div>

                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <a asp-action="History" class="patient-header-btn">
                                <i class="fa-solid fa-notes-medical text-emerald"></i>
                                <span>My Medical Records</span>
                            </a>

                            <!-- Patient User Profile Pill -->
                            <div class="patient-profile-pill">
                                <div class="patient-avatar-circle">
                                    @((Model.CurrentUser?.FullName ?? "P")[0])
                                </div>
                                <div class="patient-info-meta">
                                    <span class="patient-name">@Model.CurrentUser?.FullName</span>
                                    <span class="patient-role-tag"><i class="fa-solid fa-droplet text-danger me-1"></i>@(Model.CurrentUser?.BloodGroup ?? "Patient")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Dashboard Content Area -->
                    <div class="p-3 p-lg-4">

                        <!-- 4 Stat Metric Cards (Structured & Responsive) -->
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="patient-summary-box h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="metric-icon-box" style="background: #fee2e2;">
                                            <i class="fa-solid fa-users text-danger"></i>
                                        </div>
                                        <span class="badge bg-light text-muted small border">Registry</span>
                                    </div>
                                    <div class="fs-3 fw-black text-dark mb-0">@Model.Donors.Count</div>
                                    <div class="text-muted small fw-semibold">Available Donors</div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="patient-summary-box h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="metric-icon-box" style="background: #fef3c7;">
                                            <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                                        </div>
                                        <span class="badge bg-light text-muted small border">Live</span>
                                    </div>
                                    <div class="fs-3 fw-black text-danger mb-0">@Model.OpenRequests.Count</div>
                                    <div class="text-muted small fw-semibold">Emergency Requests</div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="patient-summary-box h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="metric-icon-box bg-emerald-light">
                                            <i class="fa-solid fa-heart-circle-check text-emerald"></i>
                                        </div>
                                        <span class="badge bg-light text-muted small border">My Record</span>
                                    </div>
                                    <div class="fs-3 fw-black text-dark mb-0">@(Model.MyProfile?.TotalDonationsCount ?? 0)</div>
                                    <div class="text-muted small fw-semibold">Total Donations</div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="patient-summary-box h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="metric-icon-box bg-emerald-light">
                                            <i class="fa-solid fa-droplet text-emerald"></i>
                                        </div>
                                        <span class="badge bg-light text-muted small border">Status</span>
                                    </div>
                                    <div class="fs-5 fw-bold mt-1">
                                        @if (Model.MyProfile?.IsAvailableDonor == true)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Active Donor</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Inactive</span>
                                        }
                                    </div>
                                    <div class="text-muted small fw-semibold mt-1">My Donor Status</div>
                                </div>
                            </div>
                        </div>

                        <!-- 1. My Donor Status Card -->
                        <div class="glass-card p-4 mb-4 border-start border-4 border-danger shadow-sm border-0">
                            <div class="row g-3 align-items-center justify-content-between">
                                <div class="col-lg-7">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="patient-blood-badge">
                                            @(Model.MyProfile?.BloodGroup ?? Model.CurrentUser?.BloodGroup ?? "O+")
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <h5 class="fw-bold text-dark mb-0">Donor Profile: @Model.CurrentUser?.FullName</h5>
                                                @if (Model.MyProfile?.IsAvailableDonor == true)
                                                {
                                                    <span class="badge bg-success rounded-pill px-3 py-1"><i class="fa-solid fa-circle-check me-1"></i> Available to Donate</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary rounded-pill px-3 py-1"><i class="fa-solid fa-circle-pause me-1"></i> Inactive</span>
                                                }
                                            </div>
                                            <div class="text-muted small d-flex flex-wrap gap-3">
                                                <span><i class="fa-solid fa-location-dot text-danger me-1"></i> @(Model.MyProfile?.Upazila ?? Model.CurrentUser?.Upazila ?? "Area"), @(Model.MyProfile?.District ?? Model.CurrentUser?.District ?? "District")</span>
                                                <span><i class="fa-solid fa-award text-warning me-1"></i> Donations: <strong>@(Model.MyProfile?.TotalDonationsCount ?? 0)</strong></span>
                                                @if (Model.MyProfile?.LastDonatedDate.HasValue == true)
                                                {
                                                    <span><i class="fa-solid fa-clock-rotate-left text-emerald me-1"></i> Last: @Model.MyProfile.LastDonatedDate.Value.ToString("dd MMM yyyy")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-5 text-lg-end">
                                    <form asp-action="ToggleDonorStatus" method="post" class="d-inline-flex align-items-center gap-2 flex-wrap justify-content-lg-end m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isAvailableDonor" value="@(Model.MyProfile?.IsAvailableDonor == true ? "false" : "true")" />
                                        <input type="hidden" name="district" value="@Model.MyProfile?.District" />
                                        <input type="hidden" name="upazila" value="@Model.MyProfile?.Upazila" />

                                        @if (Model.MyProfile?.IsAvailableDonor == true)
                                        {
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill fw-bold px-3">
                                                <i class="fa-solid fa-pause me-1"></i> Pause Donor Status
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill fw-bold px-3 text-white">
                                                <i class="fa-solid fa-play me-1"></i> Activate as Donor
                                            </button>
                                        }
                                        <button type="button" class="btn btn-light btn-sm rounded-pill fw-bold px-3 border shadow-sm"
                                                data-bs-toggle="modal" data-bs-target="#editProfileModal">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Info
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Donor Search Filter Bar -->
                        <div class="glass-card p-4 mb-4 border-0 shadow-sm">
                            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-magnifying-glass text-danger me-2"></i>Find Blood Donors</h5>
                            <form method="get" asp-action="BloodDonation" class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Blood Group</label>
                                    <select name="bloodGroup" class="form-select shadow-none">
                                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedBloodGroup) || Model.SelectedBloodGroup == "All")">All Blood Groups</option>
                                        @foreach (var bg in Model.AllBloodGroups)
                                        {
                                            <option value="@bg" selected="@(Model.SelectedBloodGroup == bg)">@bg</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">District</label>
                                    <select name="district" class="form-select shadow-none">
                                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedDistrict) || Model.SelectedDistrict == "All")">All Districts</option>
                                        @foreach (var d in Model.Districts)
                                        {
                                            <option value="@d" selected="@(Model.SelectedDistrict == d)">@d</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Upazila</label>
                                    <select name="upazila" class="form-select shadow-none">
                                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedUpazila) || Model.SelectedUpazila == "All")">All Upazilas</option>
                                        @foreach (var u in Model.Upazilas)
                                        {
                                            <option value="@u" selected="@(Model.SelectedUpazila == u)">@u</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex gap-2">
                                    <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill">
                                        <i class="fa-solid fa-search me-1"></i> Search Donors
                                    </button>
                                    <a asp-action="BloodDonation" class="btn btn-light border rounded-pill px-3" title="Reset Filters">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </a>
                                </div>
                            </form>
                        </div>

                        <!-- 3. Available Donors Grid -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-users text-danger me-2"></i>Available Donors
                                    <span class="badge bg-light text-dark fw-normal ms-2">@Model.Donors.Count found</span>
                                </h5>
                            </div>

                            @if (!Model.Donors.Any())
                            {
                                <div class="glass-card text-center py-5 border-0 shadow-sm">
                                    <i class="fa-solid fa-user-slash text-muted fs-1 mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-secondary">No Donors Found</h5>
                                    <p class="text-muted small">Try broadening your search filter to all districts or blood groups.</p>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var donor in Model.Donors)
                                    {
                                        <div class="col-12 col-md-6 col-xl-4">
                                            <div class="patient-donor-card h-100 d-flex flex-column justify-content-between shadow-sm">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="patient-blood-badge" style="width:38px;height:38px;font-size:.95rem;">
                                                                @donor.BloodGroup
                                                            </div>
                                                            <div>
                                                                <h6 class="fw-bold text-dark mb-0">@donor.FullName</h6>
                                                                <div class="small text-muted">@donor.Upazila, @donor.District</div>
                                                            </div>
                                                        </div>
                                                        @if (donor.IsEligibleToDonate)
                                                        {
                                                            <span class="badge bg-success-subtle text-success fw-bold" style="font-size:.7rem;">
                                                                <i class="fa-solid fa-check me-1"></i>Eligible
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning fw-bold" style="font-size:.7rem;">
                                                                <i class="fa-solid fa-clock me-1"></i>Cooldown
                                                            </span>
                                                        }
                                                    </div>

                                                    <div class="small text-muted my-2">
                                                        <div><i class="fa-solid fa-medal text-warning me-1"></i> <strong>@donor.TotalDonationsCount</strong> total donation(s)</div>
                                                        @if (donor.LastDonatedDate.HasValue)
                                                        {
                                                            <div><i class="fa-solid fa-calendar-check me-1"></i> Last: @donor.LastDonatedDate.Value.ToString("MMM dd, yyyy")</div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="pt-2 border-top mt-2 d-flex justify-content-between align-items-center">
                                                    <span class="small fw-bold text-dark"><i class="fa-solid fa-phone text-success me-1"></i> @donor.PhoneNumber</span>
                                                    <a href="tel:@donor.PhoneNumber" class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3">
                                                        <i class="fa-solid fa-phone me-1"></i> Call Donor
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- 4. Tabbed Hub for Emergency Requests & Donation History -->
                        <div class="glass-card p-0 overflow-hidden mb-4 border-0 shadow-sm">
                            <div class="p-3 bg-light border-bottom">
                                <ul class="nav nav-pills gap-2" id="bloodTab" role="tablist">
                                    <li class="nav-item">
                                        <button class="nav-link active fw-bold rounded-pill px-4" id="open-requests-tab" data-bs-toggle="tab" data-bs-target="#openRequests" type="button">
                                            <i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Emergency Requests (@Model.OpenRequests.Count)
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-bold rounded-pill px-4" id="my-requests-tab" data-bs-toggle="tab" data-bs-target="#myRequests" type="button">
                                            <i class="fa-solid fa-file-waveform me-1"></i> My Blood Requests (@Model.MyRequests.Count)
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-bold rounded-pill px-4" id="history-tab" data-bs-toggle="tab" data-bs-target="#historyLogs" type="button">
                                            <i class="fa-solid fa-clock-rotate-left me-1"></i> My Donation History (@Model.MyDonationLogs.Count)
                                        </button>
                                    </li>
                                </ul>
                            </div>

                            <div class="tab-content p-4" id="bloodTabContent">
                                <!-- Open Requests -->
                                <div class="tab-pane fade show active" id="openRequests" role="tabpanel">
                                    @if (!Model.OpenRequests.Any())
                                    {
                                        <div class="text-center py-4 text-muted">
                                            <i class="fa-solid fa-circle-check fs-2 text-success mb-2 opacity-50"></i>
                                            <h6>No Active Emergency Blood Requests</h6>
                                            <p class="small">All blood requests are currently fulfilled.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var req in Model.OpenRequests)
                                            {
                                                string urgencyClass = req.Urgency.ToLower();
                                                <div class="col-12 col-md-6">
                                                    <div class="req-item-card @urgencyClass shadow-sm">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="patient-blood-badge" style="width:36px;height:36px;font-size:.9rem;">
                                                                    @req.BloodGroup
                                                                </div>
                                                                <div>
                                                                    <h6 class="fw-bold text-dark mb-0">@req.UnitsRequired Unit(s) Needed</h6>
                                                                    <div class="small text-muted">@req.HospitalName, @req.District</div>
                                                                </div>
                                                            </div>
                                                            <span class="badge @(req.Urgency == "Critical" ? "bg-danger" : (req.Urgency == "Urgent" ? "bg-warning text-dark" : "bg-primary")) rounded-pill px-3 py-1">
                                                                @req.Urgency
                                                            </span>
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(req.Reason))
                                                        {
                                                            <p class="small text-secondary mb-2">@req.Reason</p>
                                                        }

                                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                                                            <span><i class="fa-solid fa-user me-1"></i> @req.Requester?.FullName</span>
                                                            <a href="tel:@req.ContactNumber" class="btn btn-sm btn-danger rounded-pill fw-bold px-3">
                                                                <i class="fa-solid fa-phone me-1"></i> @req.ContactNumber
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- My Requests -->
                                <div class="tab-pane fade" id="myRequests" role="tabpanel">
                                    @if (!Model.MyRequests.Any())
                                    {
                                        <div class="text-center py-4 text-muted">
                                            <i class="fa-solid fa-file-lines fs-2 text-muted mb-2 opacity-50"></i>
                                            <h6>You haven't submitted any blood requests yet.</h6>
                                            <button type="button" class="btn btn-danger btn-sm rounded-pill fw-bold mt-2" data-bs-toggle="modal" data-bs-target="#requestBloodModal">
                                                <i class="fa-solid fa-plus me-1"></i> Submit a Request
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Blood Group</th>
                                                        <th>Units</th>
                                                        <th>Hospital / Location</th>
                                                        <th>Urgency</th>
                                                        <th>Status</th>
                                                        <th>Date</th>
                                                        <th class="text-end">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var myReq in Model.MyRequests)
                                                    {
                                                        <tr>
                                                            <td><span class="badge bg-danger fs-6">@myReq.BloodGroup</span></td>
                                                            <td class="fw-bold">@myReq.UnitsRequired</td>
                                                            <td>
                                                                <div class="fw-bold text-dark">@myReq.HospitalName</div>
                                                                <div class="small text-muted">@myReq.District</div>
                                                            </td>
                                                            <td><span class="badge bg-light text-dark border">@myReq.Urgency</span></td>
                                                            <td>
                                                                @if (myReq.Status == "Open")
                                                                {
                                                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Open</span>
                                                                }
                                                                else if (myReq.Status == "Fulfilled")
                                                                {
                                                                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Fulfilled</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary">@myReq.Status</span>
                                                                }
                                                            </td>
                                                            <td class="small text-muted">@myReq.CreatedAt.ToString("MMM dd, yyyy")</td>
                                                            <td class="text-end">
                                                                @if (myReq.Status == "Open")
                                                                {
                                                                    <form asp-action="FulfillBloodRequest" method="post" class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="requestId" value="@myReq.Id" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill fw-bold">
                                                                            <i class="fa-solid fa-check me-1"></i> Fulfilled
                                                                        </button>
                                                                    </form>
                                                                    <form asp-action="CancelBloodRequest" method="post" class="d-inline ms-1">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="requestId" value="@myReq.Id" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold" onclick="return confirm('Cancel this request?')">
                                                                            Cancel
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>

                                <!-- My Donation Logs -->
                                <div class="tab-pane fade" id="historyLogs" role="tabpanel">
                                    @if (!Model.MyDonationLogs.Any())
                                    {
                                        <div class="text-center py-4 text-muted">
                                            <i class="fa-solid fa-heart fs-2 text-danger mb-2 opacity-50"></i>
                                            <h6>No logged donations yet.</h6>
                                            <p class="small">Log your past blood donations to build your MediCamp donor badge!</p>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#logDonationModal">
                                                <i class="fa-solid fa-plus me-1"></i> Log Donation
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Venue / Hospital</th>
                                                        <th>Notes</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var log in Model.MyDonationLogs)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold text-dark">@log.DonatedDate.ToString("dd MMMM yyyy")</td>
                                                            <td><i class="fa-solid fa-hospital text-danger me-1"></i> @log.VenueOrHospital</td>
                                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(log.Notes) ? "—" : log.Notes)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </main>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Request Blood -->
<div class="modal fade" id="requestBloodModal" tabindex="-1" aria-labelledby="requestBloodModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold" id="requestBloodModalLabel">
                    <i class="fa-solid fa-hand-holding-droplet me-2"></i>Submit Emergency Blood Request
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateBloodRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Blood Group Required</label>
                            <select name="BloodGroup" class="form-select shadow-none" required>
                                @foreach (var bg in Model.AllBloodGroups)
                                {
                                    <option value="@bg">@bg</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Units (Bags)</label>
                            <input type="number" name="UnitsRequired" min="1" max="20" value="1" class="form-control shadow-none" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Urgency</label>
                            <select name="Urgency" class="form-select shadow-none" required>
                                <option value="Critical">🔴 Critical (Immediate / < 4 hours)</option>
                                <option value="Urgent" selected>🟡 Urgent (Within 24 hours)</option>
                                <option value="Normal">🟢 Routine / Scheduled</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Contact Phone</label>
                            <input type="tel" name="ContactNumber" value="@Model.CurrentUser?.PhoneNumber" class="form-control shadow-none" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Hospital / Clinic Name</label>
                            <input type="text" name="HospitalName" class="form-control shadow-none" placeholder="e.g. Dhaka Medical College Hospital" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">District</label>
                            <input type="text" name="District" value="@(Model.CurrentUser?.District ?? "Dhaka")" class="form-control shadow-none" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Upazila / Area</label>
                            <input type="text" name="Upazila" value="@(Model.CurrentUser?.Upazila ?? "")" class="form-control shadow-none" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Reason / Patient Condition</label>
                            <textarea name="Reason" class="form-control shadow-none" rows="2" placeholder="e.g. Emergency surgery, Thalassemia transfusion, Accident trauma..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill fw-bold px-4">
                        <i class="fa-solid fa-paper-plane me-1"></i> Post Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Log Blood Donation -->
<div class="modal fade" id="logDonationModal" tabindex="-1" aria-labelledby="logDonationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold" id="logDonationModalLabel">
                    <i class="fa-solid fa-heart me-2"></i>Log a Blood Donation
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="LogDonation" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Donation Date</label>
                        <input type="date" name="DonatedDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control shadow-none" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Hospital / Blood Bank / Camp Venue</label>
                        <input type="text" name="VenueOrHospital" class="form-control shadow-none" placeholder="e.g. Quantum Blood Lab or MediCamp Bandarban" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Notes / Recipient (Optional)</label>
                        <textarea name="Notes" class="form-control shadow-none" rows="2" placeholder="e.g. Donated for a child with dengue..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill fw-bold px-4">
                        <i class="fa-solid fa-check me-1"></i> Save Donation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Edit Donor Profile Info -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="editProfileModalLabel">
                    <i class="fa-solid fa-user-pen text-danger me-2"></i>Update Donor Details
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ToggleDonorStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="isAvailableDonor" value="true" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">District</label>
                            <input type="text" name="district" value="@Model.MyProfile?.District" class="form-control shadow-none" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Upazila</label>
                            <input type="text" name="upazila" value="@Model.MyProfile?.Upazila" class="form-control shadow-none" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Body Weight (kg)</label>
                            <input type="number" step="0.5" name="weightKg" value="@Model.MyProfile?.WeightKg" class="form-control shadow-none" placeholder="e.g. 65" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Last Donated Date</label>
                            <input type="date" name="lastDonatedDate" value="@(Model.MyProfile?.LastDonatedDate?.ToString("yyyy-MM-dd"))" class="form-control shadow-none" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill fw-bold px-4">
                        <i class="fa-solid fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
