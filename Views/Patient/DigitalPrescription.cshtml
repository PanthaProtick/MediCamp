@model MediCamp.Models.ViewModels.DigitalPrescriptionViewModel

@{
    ViewData["Title"] = $"Digital Rx — Token #{Model.TriageRecord?.TokenNumber} ({Model.Patient?.FullName})";
    Layout = "_Layout";
}

<style>
    .rx-paper {
        background: #ffffff;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        max-width: 850px;
        margin: 0 auto;
        padding: 2.5rem;
        position: relative;
    }
    .rx-symbol {
        font-family: 'Times New Roman', serif;
        font-size: 2.5rem;
        font-weight: bold;
        color: #0d6efd;
        line-height: 1;
    }
    .rx-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-30deg);
        font-size: 5rem;
        font-weight: 900;
        color: rgba(13, 110, 253, 0.04);
        pointer-events: none;
        user-select: none;
        white-space: nowrap;
    }
    @@media print {
        .no-print, nav, footer, .aura-layer-1, .aura-layer-2, .aura-bg {
            display: none !important;
        }
        body {
            background: white !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .rx-paper {
            border: none !important;
            box-shadow: none !important;
            max-width: 100% !important;
            padding: 1.5rem !important;
        }
    }
</style>

<div class="container py-4">

    <!-- Action Bar (No Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-2">
        <a asp-action="History" class="btn btn-light shadow-sm fw-bold rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i> Back to History
        </a>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill fw-bold px-4 shadow" onclick="window.print()">
                <i class="fa-solid fa-print me-2"></i> Print / Save as PDF
            </button>
        </div>
    </div>

    <!-- Official Prescription Slip -->
    <div class="rx-paper">
        <div class="rx-watermark">MEDICAMP DIGITAL RX</div>

        <!-- Header: Organization & Camp -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fs-4 fw-black text-primary">Medi<span class="text-success">Camp</span></span>
                    <span class="badge bg-primary-subtle text-primary fw-bold">Official E-Prescription</span>
                </div>
                <h6 class="fw-bold text-dark mb-0">@Model.Camp?.Title</h6>
                <div class="text-muted small">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i>
                    @Model.Camp?.Venue, @Model.Camp?.Upazila, @Model.Camp?.District
                </div>
            </div>
            <div class="text-end">
                <div class="badge bg-dark fs-6 px-3 py-2">Token #@Model.TriageRecord?.TokenNumber</div>
                <div class="small text-muted mt-1">
                    Date: <strong>@(Model.Consultation?.ConsultedAt.ToString("dd MMM yyyy, hh:mm tt") ?? DateTime.UtcNow.ToString("dd MMM yyyy"))</strong>
                </div>
            </div>
        </div>

        <!-- Doctor & Patient Banner -->
        <div class="row g-3 bg-light p-3 rounded-3 mb-4 border">
            <!-- Doctor Info -->
            <div class="col-md-6 border-end-md">
                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Prescribing Physician</div>
                <h6 class="fw-bold text-primary mb-0">Dr. @(Model.Doctor?.FullName ?? "Medical Officer")</h6>
                <div class="small text-muted">@Model.Doctor?.Email</div>
                <div class="small text-secondary">MediCamp Registered Clinician</div>
            </div>
            <!-- Patient Info -->
            <div class="col-md-6">
                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Patient Information</div>
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">@Model.Patient?.FullName</h6>
                    <span class="badge bg-danger">@Model.Patient?.BloodGroup</span>
                </div>
                <div class="small text-muted">
                    Phone: @Model.Patient?.PhoneNumber &bull; Gender: @(Model.Patient?.Gender ?? "N/A")
                    @if (Model.Patient?.Age.HasValue == true)
                    {
                        <span>&bull; Age: @Model.Patient.Age yrs</span>
                    }
                </div>
            </div>
        </div>

        <!-- Patient Vitals at Triage -->
        @if (Model.TriageRecord != null)
        {
            <div class="d-flex flex-wrap gap-3 p-2 px-3 bg-light rounded-pill mb-4 small border justify-content-around text-center">
                @if (!string.IsNullOrWhiteSpace(Model.TriageRecord.BloodPressure))
                {
                    <div>BP: <strong class="text-danger">@Model.TriageRecord.BloodPressure</strong></div>
                }
                @if (Model.TriageRecord.TemperatureF.HasValue)
                {
                    <div>Temp: <strong class="text-warning">@Model.TriageRecord.TemperatureF.Value.ToString("F1")°F</strong></div>
                }
                @if (Model.TriageRecord.WeightKg.HasValue)
                {
                    <div>Weight: <strong>@Model.TriageRecord.WeightKg.Value.ToString("F1") kg</strong></div>
                }
                @if (Model.TriageRecord.HeightCm.HasValue)
                {
                    <div>Height: <strong>@Model.TriageRecord.HeightCm.Value.ToString("F0") cm</strong></div>
                }
                @if (Model.TriageRecord.BMI.HasValue)
                {
                    <div>BMI: <strong class="text-info">@Model.TriageRecord.BMI.Value.ToString("F1")</strong></div>
                }
            </div>
        }

        <!-- Diagnosis & Chief Complaints -->
        <div class="row g-3 mb-4">
            @if (!string.IsNullOrWhiteSpace(Model.TriageRecord?.PresentingSymptoms))
            {
                <div class="col-md-6">
                    <div class="p-3 bg-white border rounded">
                        <div class="fw-bold small text-muted text-uppercase mb-1" style="font-size:0.68rem;">Chief Complaints</div>
                        <div class="small text-dark">@Model.TriageRecord.PresentingSymptoms</div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Consultation?.Diagnosis))
            {
                <div class="col-md-6">
                    <div class="p-3 bg-primary-subtle border border-primary-subtle rounded">
                        <div class="fw-bold small text-primary text-uppercase mb-1" style="font-size:0.68rem;">Clinical Diagnosis</div>
                        <div class="fw-bold text-dark fs-6">@Model.Consultation.Diagnosis</div>
                    </div>
                </div>
            }
        </div>

        <!-- Prescription Body (Rx) -->
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="rx-symbol">℞</span>
                <h5 class="fw-bold text-dark mb-0">Prescribed Medication</h5>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="alert alert-light border text-muted small text-center py-3">
                    No pharmacological medications prescribed for this visit.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 35%;">Medicine (Brand & Generic)</th>
                                <th style="width: 15%;">Dosage</th>
                                <th style="width: 15%;">Duration</th>
                                <th style="width: 30%;">Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var itm = Model.Items[i];
                                <tr>
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td>
                                        <div class="fw-bold text-dark">@itm.MasterMedicine?.BrandName</div>
                                        <div class="small text-muted">@itm.MasterMedicine?.GenericName (@itm.MasterMedicine?.Strength)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fs-6">@itm.Dosage</span>
                                    </td>
                                    <td>@itm.DurationDays day(s)</td>
                                    <td class="small text-secondary">
                                        @(string.IsNullOrWhiteSpace(itm.Instructions) ? "As directed by physician" : itm.Instructions)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Advice & Instructions -->
        @if (!string.IsNullOrWhiteSpace(Model.Consultation?.Advice) || !string.IsNullOrWhiteSpace(Model.Consultation?.ClinicalNotes))
        {
            <div class="p-3 bg-light rounded border mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.Consultation?.Advice))
                {
                    <div class="mb-2">
                        <div class="fw-bold small text-muted text-uppercase" style="font-size:0.68rem;">General Advice & Dietary Instructions</div>
                        <div class="text-dark small">@Model.Consultation.Advice</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Consultation?.ClinicalNotes))
                {
                    <div>
                        <div class="fw-bold small text-muted text-uppercase" style="font-size:0.68rem;">Clinical Notes</div>
                        <div class="text-secondary small">@Model.Consultation.ClinicalNotes</div>
                    </div>
                }
            </div>
        }

        <!-- Hospital Referral (if applicable) -->
        @if (Model.Referral != null)
        {
            <div class="alert alert-danger border-danger p-3 rounded mb-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="fa-solid fa-hospital text-danger fs-5"></i>
                    <h6 class="fw-bold text-danger mb-0">HOSPITAL REFERRAL (@Model.Referral.Urgency.ToUpper())</h6>
                </div>
                <div class="text-dark">
                    <strong>Referred to:</strong> @Model.Referral.ReferredHospital
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Referral.Reason))
                {
                    <div class="small text-muted mt-1">
                        <strong>Reason:</strong> @Model.Referral.Reason
                    </div>
                }
            </div>
        }

        <!-- Footer / Signature -->
        <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-end">
            <div class="small text-muted">
                <div>Prescription ID: <code>RX-#@Model.Prescription.Id.ToString("D6")</code></div>
                <div>Status: @(Model.Prescription.IsDispensed ? "Dispensed at Camp Pharmacy" : "Prescribed")</div>
                <div class="mt-1" style="font-size: 0.7rem;">Generated digitally by MediCamp Healthcare System</div>
            </div>
            <div class="text-center" style="min-width: 180px;">
                <div class="fw-bold text-primary border-bottom pb-1 mb-1">
                    Dr. @(Model.Doctor?.FullName ?? "Medical Officer")
                </div>
                <div class="small text-muted" style="font-size: 0.72rem;">Authorized Clinician Signature</div>
            </div>
        </div>
    </div>
</div>
